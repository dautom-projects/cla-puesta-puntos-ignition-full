      },
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "basis": "20px",
          "shrink": 0
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "FormRepeater"
        },
        "position": {
          "basis": "100%",
          "display": false,
          "grow": 1
        },
        "propConfig": {
          "custom.instance": {
            "binding": {
              "config": {
                "path": "view.params.areaName"
              },
              "type": "property"
            }
          },
          "props.instances": {
            "binding": {
              "config": {
                "path": "view.params.lineName"
              },
              "transforms": [
                {
                  "code": "\t# \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n\t# Generar instancias dinámicas de formularios desde el UNS\n\t# \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n\t\n\t# Parámetros de la vista\n\tareaName \u003d self.view.params.areaName\n\tlineName \u003d self.view.params.lineName\n\t\n\t# Ruta base del UNS\n\tbasePath \u003d \"[UNS]Clarios/Andina/{}/{}/UI\".format(areaName, lineName)\n\t\n\t# Navegar dentro de la carpeta\n\tresults \u003d system.tag.browse(basePath)\n\t\n\t# Obtener nombres de formularios (carpetas con hijos)\n\tformNames \u003d [tag[\u0027name\u0027] for tag in results.getResults() if tag[\u0027hasChildren\u0027]]\n\t\n\t# Construir la lista de instancias\n\tinstances \u003d []\n\tfor formName in formNames:\n\t\tinstance \u003d {\n\t\t\t\"instanceStyle\": { \"classes\": \"\" },\n\t\t\t\"instancePosition\": {},\n\t\t\t\"areaName\": areaName,\n\t\t\t\"formName\": formName,\n\t\t\t\"lineName\": lineName\n\t\t}\n\t\tinstances.append(instance)\n\t\n\t\n\t\n\t# Retornar lista JSON con todas las instancias\n\treturn instances",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "alignItems": "center",
          "direction": "column",
          "elementPosition": {
            "basis": "auto",
            "grow": 0,
            "shrink": 0
          },
          "justify": "center",
          "path": "Node/MixingDashboard/Mixing Trend/Framework/FormRepeater",
          "style": {
            "overflow": "hidden"
          },
          "useDefaultViewHeight": false
        },
        "type": "ia.display.flex-repeater"
      },
      {
        "meta": {
          "name": "Label_0"
        },
        "position": {
          "basis": "20px",
          "shrink": 0
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "button-question",
        "overflow": "hidden",
        "paddingTop": 10
      }
    },
    "type": "ia.container.flex"
  }
}
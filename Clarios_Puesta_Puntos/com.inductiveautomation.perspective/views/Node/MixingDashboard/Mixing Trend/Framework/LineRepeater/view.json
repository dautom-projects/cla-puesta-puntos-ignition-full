                "fontWeight": "bold",
                "paddingLeft": "10px",
                "paddingTop": 0
              }
            },
            "type": "ia.display.label"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tself.parent.parent.getChild(\"FormRepeater\").position.display \u003d not self.parent.parent.getChild(\"FormRepeater\").position.display"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Button"
            },
            "position": {
              "basis": "48px"
            },
            "propConfig": {
              "props.image.icon.path": {
                "binding": {
                  "config": {
                    "expression": "if({.../FormRepeater.position.display}, \"material/keyboard_arrow_up\", \"material/keyboard_arrow_down\")"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "image": {
                "height": 45,
                "icon": {
                  "color": "--cla-text-title",

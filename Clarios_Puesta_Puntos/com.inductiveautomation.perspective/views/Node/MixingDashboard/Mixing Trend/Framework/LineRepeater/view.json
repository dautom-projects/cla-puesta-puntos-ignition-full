              },
              "primary": false,
              "style": {
                "backgroundColor": "#B37D4100",
                "borderColor": "#BD0F0F00"
              },
              "text": "",
              "textStyle": {
                "backgroundColor": "#85191900",
                "color": "#FAFAFB"
              }
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "name": "FlexContainer"
        },
        "position": {
          "basis": "25px",
          "shrink": 0
        },
        "props": {
          "justify": "space-between",
          "style": {
            "borderBottomLeftRadius": 10,
            "borderBottomRightRadius": 10,
            "borderColor": "--button-2",
            "borderStyle": "solid",
            "borderTopLeftRadius": 10,
            "borderTopRightRadius": 10,
            "borderWidth": 1,
            "classes": "text-titles",
            "overflow": "hidden"
          }

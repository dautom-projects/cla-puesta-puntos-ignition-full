                                  "code": "\tmixerName \u003d self.view.params.MixerName\n\tpathTag \u003d value\n\n\tproductMap \u003d {\n\t\t\"SlurryPdMixer\": [\n\t\t\t{\"desc\": \"Binder\", \"tagFolder\": \"BinderWeight\", \"tagLeaf\": \"Act_Value\"},\n\t\t\t{\"desc\": \"Carbon\", \"tagFolder\": \"CarbonWeight\", \"tagLeaf\": \"Act_Value\"},\n\t\t\t{\"desc\": \"NMP\", \"tagFolder\": \"NmpWeight\", \"tagLeaf\": \"Act_Value\"},\n\t\t\t{\"desc\": \"CNT\", \"tagFolder\": \"CntWeight\", \"tagLeaf\": \"Act_Value\"},\n\t\t\t{\"desc\": \"Active\", \"tagFolder\": \"ActiveMaterialWeight\", \"tagLeaf\": \"Act_Value\"}\n\t\t],\n\t\t\"BinderMixer\": [\n\t\t\t{\"desc\": \"NMP\", \"tagFolder\": \"NmpWeight\", \"tagLeaf\": \"Act_Value\"},\n\t\t\t{\"desc\": \"Binder\", \"tagFolder\": \"BinderWeight\", \"tagLeaf\": \"Act_Value\"}\n\t\t],\n\t\t\"CeramicPDMixer\": [\n\t\t\t{\"desc\": \"Bohemite\", \"tagFolder\": \"BohemiteWeight\", \"tagLeaf\": \"Act_Value\"},\n\t\t\t{\"desc\": \"NMP\", \"tagFolder\": \"NmpWeight\", \"tagLeaf\": \"Act_Value\"},\n\t\t\t{\"desc\": \"Active\", \"tagFolder\": \"CeramicWeight\", \"tagLeaf\": \"Act_Value\"}\n\t\t],\n\t\t\"SlurryPdMixer1\": [\n\t\t\t{\"desc\": \"Carbon\", \"tagFolder\": \"CarbonWeight\", \"tagLeaf\": \"Act_Value\"},\n\t\t\t{\"desc\": \"CMC\", \"tagFolder\": \"CmcWeight\", \"tagLeaf\": \"Act_Value\"},\n\t\t\t{\"desc\": \"DIW\", \"tagFolder\": \"DiwWeight\", \"tagLeaf\": \"Act_Value\"},\n\t\t\t{\"desc\": \"SBR\", \"tagFolder\": \"SBRWeight\", \"tagLeaf\": \"Act_Value\"},\n\t\t\t{\"desc\": \"SI\", \"tagFolder\": \"SIWeight\", \"tagLeaf\": \"Act_Value\"},\n\t\t\t{\"desc\": \"Active\", \"tagFolder\": \"ActiveMaterialWeight\", \"tagLeaf\": \"Act_Value\"}\n\t\t],\n\t\t\"SlurryPdMixer2\": [\n\t\t\t{\"desc\": \"Carbon\", \"tagFolder\": \"CarbonWeight\", \"tagLeaf\": \"Act_Value\"},\n\t\t\t{\"desc\": \"CMC\", \"tagFolder\": \"CmcWeight\", \"tagLeaf\": \"Act_Value\"},\n\t\t\t{\"desc\": \"DIW\", \"tagFolder\": \"DiwWeight\", \"tagLeaf\": \"Act_Value\"},\n\t\t\t{\"desc\": \"SBR\", \"tagFolder\": \"SBRWeight\", \"tagLeaf\": \"Act_Value\"},\n\t\t\t{\"desc\": \"SI\", \"tagFolder\": \"SIWeight\", \"tagLeaf\": \"Act_Value\"},\n\t\t\t{\"desc\": \"Active\", \"tagFolder\": \"ActiveMaterialWeight\", \"tagLeaf\": \"Act_Value\"}\n\t\t],\n\t\t\"CmcMixer\": [\n\t\t\t{\"desc\": \"DIW\", \"tagFolder\": \"DiwWeight\", \"tagLeaf\": \"Act_Value\"},\n\t\t\t{\"desc\": \"SBR\", \"tagFolder\": \"SBRWeight\", \"tagLeaf\": \"Act_Value\"},\n\t\t\t{\"desc\": \"SI\", \"tagFolder\": \"SIWeight\", \"tagLeaf\": \"Act_Value\"},\n\t\t\t{\"desc\": \"Active\", \"tagFolder\": \"CmclWeight\", \"tagLeaf\": \"Act_Value\"}\n\t\t],\t\t\n\t\t\n\t}\n\t\n\t\t\n\tinstancesList \u003d []\n\ttotalValue \u003d 0.0\n\t\n\tfor product in productMap.get(mixerName, []):\n\t\tfullPath \u003d \"{}/ProcessMixing/{}/{}/{}\".format(pathTag, mixerName, product[\"tagFolder\"], product[\"tagLeaf\"])\n\t\t\n\t\tval \u003d system.tag.readBlocking([fullPath])[0].value\n\t\t\n\t\tinstancesList.append({\n\t\t\t\"item\": {\n\t\t\t\t\"desc\": product[\"desc\"],\n\t\t\t\t\"value\": val,\n\t\t\t\t\"uom\": \"Kg\"\n\t\t\t}\n\t\t})\n\t\t\n\t\tif val !\u003d None:\n\t\t\ttotalValue +\u003d float(val)\n\t\n\t\n\t\n\tinstancesList.append({\n    \"item\": {\n        \"desc\": \"Tot\",\n        \"value\": round(totalValue, 2),\n        \"uom\": \"Kg\"\n    }\n\t})\n\treturn instancesList",

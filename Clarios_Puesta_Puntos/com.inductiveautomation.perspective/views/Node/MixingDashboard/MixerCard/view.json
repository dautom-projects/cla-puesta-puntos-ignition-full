                          "code": "\tpathTag \u003d value\n\tmixerName \u003d self.view.params.MixerName\n\n\tmetricConfig \u003d [\n\t\t{\"desc\": \"Pressure\", \"actVal\": \"Vacuum/Act_Pressure\", \"setVal\": \"Vacuum/Set_Pressure\",\"uom\": \"kPa\"},\n\t\t{\"desc\": \"Temperature\", \"actVal\": \"Temperature/Act_Value\", \"setVal\": \"Temperature/Set_Value\",\"uom\": u\"\\u00B0 C\"},\n\t\t{\"desc\": \"Speed High\", \"actVal\": \"HighMixer/Servo/Act_Speed\", \"setVal\": \"HighMixer/Servo/Set_Speed\", \"uom\": \"RPM\"},\n\t\t{\"desc\": \"Speed Low\", \"actVal\": \"LowMixer/Servo/Act_Speed\", \"setVal\": \"LowMixer/Servo/Set_Speed\", \"uom\": \"RPM\"},\n\n\t]\n\n\tinstancesList \u003d []\n\n\t# Mode preview dans le Designer\n\tif not pathTag or not mixerName:\n\t\tfor m in metricConfig:\n\t\t\tinstancesList.append({\n\t\t\t\t\"metricKey\": m[\"desc\"],\n\t\t\t\t\"metricUnit\": m[\"uom\"],\n\t\t\t\t\"actValue\": \"42.0\",\n\t\t\t\t\"setValue\": \"45.0\",\n\t\t\t\t\"metricHistPath\": [{\n\t\t\t\t\t\"aggregate\": \"MinMax\",\n\t\t\t\t\t\"alias\": {\"path\": \"{}\".format(actPath)}\n\t\t\t\t}]\n\t\t\t})\n\t\treturn instancesList\n\n\t# Mode dynamique avec chemin complet\n\tfor m in metricConfig:\n\t\tbasePath \u003d \"{}/ProcessMixing/{}/\".format(pathTag,mixerName)\n\n\t\tinstancesList.append({\n\t\t\t\"metricKey\": m[\"desc\"],\n\t\t\t\"metricUnit\": m[\"uom\"],\n\t\t\t\"actValue\": basePath + m[\"actVal\"],\n\t\t\t\"setValue\": basePath + m[\"setVal\"], \n\t\t\t\"metricHistPath\": [{\n\t\t\t\t\"aggregate\": \"MinMax\",\n\t\t\t\t\"alias\": \"\",\n\t\t\t\t\"path\": basePath + m[\"actVal\"],\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"aggregate\": \"MinMax\",\n\t\t\t\t\"alias\": \"\",\n\t\t\t\t\"path\": basePath + m[\"setVal\"],\n\t\t\t}]\n\t\t})\n\n\treturn instancesList",
                          "type": "script"
                        }

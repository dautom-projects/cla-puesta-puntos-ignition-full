{
  "custom": {},
  "params": {
    "item": {
      "desc": "",
      "value": 15.6
    }
  },
  "propConfig": {
    "params.item": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 34,
      "width": 231
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "desc"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.item.desc"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "backgroundColor": "transparent",
            "classes": "text-xs text-gray-500"
          },
          "textStyle": {
            "classes": "text-sm whitespace-nowrap"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "value"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "try(\r\n    if({view.params.item.value} + \"\" \u003d \"\", \r\n        \"\", \r\n        numberFormat({view.params.item.value}, \"#0.0\")\r\n    ), \r\n    {view.params.item.value} + \"\"\r\n)"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "backgroundColor": "transparent",
            "classes": "font-semibold"
          },
          "textStyle": {
            "classes": "text-sm whitespace-nowrap text-right"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "justify": "space-between",
      "style": {
        "backgroundColor": "transparent",
        "classes": "gap-1",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}
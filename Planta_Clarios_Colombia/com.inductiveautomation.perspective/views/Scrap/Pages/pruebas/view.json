              "transforms": [
                {
                  "code": "\n    import system\n    from java.util import Calendar\n    \n    total \u003d 0.0\n    \n    if value is None or value.rowCount \u003d\u003d 0:\n        return 0.0\n    \n    # \u003d\u003d\u003d\u003d\u003d Configuración de turno \u003d\u003d\u003d\u003d\u003d\n    # Cambia estos valores según el turno que quieras\n    hora_inicio \u003d 14  # ejemplo Turno 3\n    hora_fin    \u003d 22\n    \n    cal \u003d Calendar.getInstance()\n    cal.setTime(timestamp)\n    \n    # Día anterior\n    cal.add(Calendar.DAY_OF_MONTH, -1)\n    \n    # Inicio turno \u003d día anterior a la hora indicada\n    cal.set(Calendar.HOUR_OF_DAY, hora_inicio)\n    cal.set(Calendar.MINUTE, 0)\n    cal.set(Calendar.SECOND, 0)\n    cal.set(Calendar.MILLISECOND, 0)\n    inicio_turno \u003d cal.getTime()\n    \n    # Fin turno \u003d si fin \u003e inicio, mismo día; si fin \u003c inicio, al día siguiente\n    cal.set(Calendar.HOUR_OF_DAY, hora_fin)\n    fin_turno \u003d cal.getTime()\n    if hora_fin \u003c\u003d hora_inicio:\n        # Cruza medianoche\n        cal.add(Calendar.DAY_OF_MONTH, 1)\n        cal.set(Calendar.HOUR_OF_DAY, hora_fin)\n        fin_turno \u003d cal.getTime()\n    \n    # \u003d\u003d\u003d\u003d\u003d Sumar solo valores dentro del rango \u003d\u003d\u003d\u003d\u003d\n    for i in range(value.rowCount):\n        ts \u003d value.getValueAt(i, 0)\n        v  \u003d value.getValueAt(i, 1)\n        \n        if ts \u003e\u003d inicio_turno and ts \u003c fin_turno and v \u003e 0:\n            total +\u003d v\n    \n    return total",

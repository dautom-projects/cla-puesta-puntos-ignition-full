              "transforms": [
                {
                  "code": "\n    import system\n    from java.util import Calendar\n\n    total \u003d 0.0\n\n    if value is None or value.rowCount \u003d\u003d 0:\n        return 0.0\n\n    # \u003d\u003d\u003d\u003d\u003d Día anterior \u003d\u003d\u003d\u003d\u003d\n    cal \u003d Calendar.getInstance()\n    cal.setTime(timestamp)\n    cal.add(Calendar.DAY_OF_MONTH, -2)\n\n    # Inicio del día anterior: 22:00 (Turno 1)\n    cal.set(Calendar.HOUR_OF_DAY, 22)\n    cal.set(Calendar.MINUTE, 0)\n    cal.set(Calendar.SECOND, 0)\n    cal.set(Calendar.MILLISECOND, 0)\n    inicio \u003d cal.getTime()\n\n    # Fin del día anterior: 22:00 del día actual\n    cal.add(Calendar.DAY_OF_MONTH, 1)\n    fin \u003d cal.getTime()\n\n    # \u003d\u003d\u003d\u003d\u003d Sumar valores dentro del rango \u003d\u003d\u003d\u003d\u003d\n    for i in range(value.rowCount):\n        ts \u003d value.getValueAt(i, 0)  # timestamp\n        v  \u003d value.getValueAt(i, 1)  # columna peso scrap\n\n        if ts \u003e\u003d inicio and ts \u003c fin and v \u003e 0:\n            total +\u003d v\n\n    return total",

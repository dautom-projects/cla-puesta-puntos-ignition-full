              "transforms": [
                {
                  "code": "\t\n\t    import system\n\t    from java.util import Calendar\n\t    \n\t    total \u003d 0.0\n\t    \n\t    # Si no hay datos\n\t    if value is None or value.rowCount \u003d\u003d 0:\n\t        return 0.0\n\t    \n\t    # \u003d\u003d\u003d\u003d\u003d Definir rango de Turno 1 del día anterior \u003d\u003d\u003d\u003d\u003d\n\t    # Turno 1: 22:00 → 06:00 del día siguiente\n\t    cal \u003d Calendar.getInstance()\n\t    cal.setTime(timestamp)\n\t    \n\t    # Día anterior\n\t    cal.add(Calendar.DAY_OF_MONTH, -1)\n\t    \n\t    # Inicio turno 1 \u003d día anterior 22:00\n\t    cal.set(Calendar.HOUR_OF_DAY, 22)\n\t    cal.set(Calendar.MINUTE, 0)\n\t    cal.set(Calendar.SECOND, 0)\n\t    cal.set(Calendar.MILLISECOND, 0)\n\t    inicio_turno \u003d cal.getTime()\n\t    \n\t    # Fin turno 1 \u003d inicio + 8 horas \u003d 06:00 del día actual\n\t    cal.add(Calendar.HOUR_OF_DAY, 8)\n\t    fin_turno \u003d cal.getTime()\n\t    \n\t    # \u003d\u003d\u003d\u003d\u003d Sumar solo valores dentro del rango \u003d\u003d\u003d\u003d\u003d\n\t    for i in range(value.rowCount):\n\t        ts \u003d value.getValueAt(i, 0)  # timestamp de cada fila\n\t        v  \u003d value.getValueAt(i, 1)  # columna \"peso scrap negativo\"\n\t        \n\t        if ts \u003e\u003d inicio_turno and ts \u003c fin_turno and v \u003e 0:\n\t            total +\u003d v\n\t    \n\t    return total",

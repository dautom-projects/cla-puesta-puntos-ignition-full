        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\t# Componentes hermanos\n\ttbl \u003d self.getSibling(\"SupervisoresTable\")\n\ttxt \u003d self.getSibling(\"EditaSupervisorTextField\")\n\t\n\tnuevo \u003d (txt.props.text or \"\").strip()\n\tif not nuevo:\n\t    system.perspective.print(\"Escribe un nombre primero.\")\n\t    return\n\t\n\t# Asegura selección de fila\n\tsel \u003d tbl.props.selection\n\tif sel is None or sel.selectedRow is None:\n\t    system.perspective.print(\"Selecciona una fila en la tabla.\")\n\t    return\n\t\n\t# 1) Resuelve el tag path del dataset (desde custom) o define uno por defecto\n\ttagPath \u003d getattr(tbl, \"custom\", None).get(\"tagPath\") if hasattr(tbl, \"custom\") else None\n\tif not tagPath:\n\t    # Cambia esta línea por tu tag si no usas custom.tagPath\n\t    tagPath \u003d \"[default]Clarios/Yumbo/Scrap/Ensamble/Linea 4/New Instance/Supervisores\"\n\t\n\t# 2) Lee el dataset actual desde el tag (si prefieres puedes usar tbl.props.data)\n\tds \u003d system.tag.readBlocking([tagPath])[0].value\n\t\n\t# 3) Convierte a estructuras mutables\n\theaders \u003d list(ds.columnNames)\n\trows \u003d [list(r) for r in system.dataset.toPyDataSet(ds)]\n\t\n\t# Ubica índices de columnas\n\ttry:\n\t    colSup \u003d headers.index(\"Supervisor\")\n\texcept ValueError:\n\t    system.perspective.print(\"La columna \u0027Supervisor\u0027 no existe en el dataset del tag.\")\n\t    return\n\t\n\t# (Robusto) intenta localizar la fila por \u0027Id\u0027 para que no falle si hay orden/filtro\n\ttry:\n\t    colId \u003d headers.index(\"Id\")\n\texcept ValueError:\n\t    colId \u003d None\n\t\n\ttargetIdx \u003d sel.selectedRow   # índice visible por defecto\n\t\n\t# Si la selección trae el objeto de fila, úsalo para ubicar por Id real\n\ttry:\n\t    if sel.data and len(sel.data) \u003e 0 and colId is not None:\n\t        wantedId \u003d dict(sel.data[0]).get(\"Id\", dict(sel.data[0]).get(\"id\"))\n\t        if wantedId is not None:\n\t            for i, r in enumerate(rows):\n\t                if r[colId] \u003d\u003d wantedId:\n\t                    targetIdx \u003d i\n\t                    break\n\texcept:\n\t    pass\n\t\n\tif targetIdx is None or targetIdx \u003c 0 or targetIdx \u003e\u003d len(rows):\n\t    system.perspective.print(\"No se pudo determinar la fila objetivo.\")\n\t    return\n\t\n\t# 4) Escribe el nuevo valor en la columna \u0027Supervisor\u0027\n\trows[targetIdx][colSup] \u003d nuevo\n\t\n\t# 5) Reconstruye el dataset y escríbelo al tag (es atómico)\n\tnewDs \u003d system.dataset.toDataSet(headers, rows)\n\tsystem.tag.writeBlocking([tagPath], [newDs])\n\t\n\t# 6) Refresca el binding de la tabla (por si no se propaga de inmediato)\n\ttbl.refreshBinding(\"props.data\")\n\t\n\t# 7) Limpia el Text Field\n\ttxt.props.text \u003d \"\""
              },
              "scope": "G",
              "type": "script"
            }
          }
        },

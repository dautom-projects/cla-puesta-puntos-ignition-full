{
  "custom": {},
  "params": {
    "TITULO": "value"
  },
  "propConfig": {
    "params.TITULO": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 60,
      "width": 1920
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Icon"
            },
            "position": {
              "basis": "40px"
            },
            "props": {
              "path": "material/apps"
            },
            "type": "ia.display.icon"
          },
          {
            "meta": {
              "name": "clarios blanco_0"
            },
            "position": {
              "basis": "236px"
            },
            "props": {
              "fit": {
                "mode": "fill",
                "width": 200
              },
              "source": "/system/images/clarios logo.png",
              "style": {
                "borderBottomLeftRadius": 15,
                "borderBottomRightRadius": 15,
                "borderTopLeftRadius": 15,
                "borderTopRightRadius": 15
              }
            },
            "type": "ia.display.image"
          }
        ],
        "meta": {
          "name": "FlexContainer_0"
        },
        "position": {
          "basis": "273px"
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "basis": "246px"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.TITULO"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "textStyle": {
            "fontFamily": "Merriweather",
            "fontSize": 30,
            "fontWeight": "bold",
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      },
      {
        "children": [
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tif self.session.props.auth.authenticated:\n\t\tsystem.perspective.logout()\n\telse:\n\t\tsystem.perspective.login()"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "User"
            },
            "position": {
              "basis": "30px",
              "shrink": 0
            },
            "props": {
              "path": "material/person",
              "style": {
                "classes": "Header/Icon"
              }
            },
            "type": "ia.display.icon"
          },
          {
            "meta": {
              "name": "Label"
            },
            "position": {
              "basis": "70px"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "session.props.auth.user.userName"
                  },
                  "transforms": [
                    {
                      "expression": "\"  \" + {value}",
                      "type": "expression"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "textStyle": {
                "textAlign": "center"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "FlexContainer"
        },
        "position": {
          "basis": "300px"
        },
        "props": {
          "justify": "flex-end"
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "justify": "space-between",
      "style": {
        "backgroundColor": "#47FFFF"
      }
    },
    "type": "ia.container.flex"
  }
}
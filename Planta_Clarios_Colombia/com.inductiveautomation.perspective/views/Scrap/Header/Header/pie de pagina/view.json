{
  "custom": {},
  "params": {
    "TexfontSize": "value",
    "titulo": "value"
  },
  "propConfig": {
    "params.TexfontSize": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.titulo": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 78,
      "width": 1920
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "basis": "377px"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "dateformat(now(),\"dd/MMMM/yyyy - h:mm:ss a\")"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "textStyle": {
            "color": "#FFFFFF",
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Label_0"
        },
        "position": {
          "basis": "623px"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.titulo"
              },
              "type": "property"
            }
          },
          "props.textStyle.fontSize": {
            "binding": {
              "config": {
                "path": "view.params.TexfontSize"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "textStyle": {
            "color": "#FFFFFF",
            "fontFamily": "Merriweather",
            "fontWeight": "bold",
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Image"
        },
        "position": {
          "basis": "300px"
        },
        "props": {
          "fit": {
            "mode": "fill"
          },
          "source": "/system/images/clarios logo.png"
        },
        "type": "ia.display.image"
      }
    ],
    "meta": {
      "name": "root"
    },
    "propConfig": {
      "props.style.backgroundImage": {
        "binding": {
          "config": {
            "fallbackDelay": 2.5,
            "mode": "direct",
            "tagPath": "[default]Ensamble/General/Corporater Color"
          },
          "type": "tag"
        }
      }
    },
    "props": {
      "alignContent": "space-between",
      "justify": "space-between"
    },
    "type": "ia.container.flex"
  }
}
          "width": 197,
          "x": 156,
          "y": 273.5
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "{[default]Ensamble/LINEA 1/COS L1/MT_Prueba_Temperatura.value} + \" °C\""
              },
              "type": "expr"
            }
          }
        },
        "props": {

      {
        "meta": {
          "name": "Termometro color"
        },
        "position": {
          "height": 56,
          "x": 156,
          "y": 266
        },
        "propConfig": {
          "position.width": {
            "binding": {
              "config": {
                "expression": "{[default]Ensamble/LINEA 1/COS L1/MT_Prueba_Temperatura.value}*1.5"
              },
              "type": "expr"
            }
          },
          "props.style.backgroundColor": {
            "binding": {
              "config": {
                "expression": "{[default]Ensamble/LINEA 1/COS L1/MT_Prueba_Temperatura}"
              },
              "transforms": [
                {
                  "fallback": "#000000",
                  "inputType": "range",
                  "mappings": [
                    {
                      "input": {
                        "max": 50,
                        "min": 0
                      },
                      "output": "#4747FF"
                    },
                    {
                      "input": {
                        "max": 100,
                        "min": 51
                      },
                      "output": "#FF8C00"
                    },
                    {
                      "input": {
                        "max": 150,
                        "min": 101
                      },
                      "output": "#FF0000"
                    }
                  ],
                  "outputType": "color",
                  "type": "map"
                }
              ],
              "type": "expr"
            }
          },
          "props.style.borderColor": {
            "binding": {
              "config": {
                "path": "this.props.style.backgroundColor"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "borderBottomLeftRadius": 10,
            "borderBottomRightRadius": 10,
            "borderStyle": "solid",
            "borderTopLeftRadius": 10,
            "borderTopRightRadius": 10,
            "borderWidth": 1
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "valor temperatura"
        },
        "position": {

                "tags": [
                  {
                    "path": "[SQL_MainDataServer/ignition-b9586s28:default]ensamble/linea 1/cos l1/mes_powerbi/estado maquina"
                  }
                ],
                "valueFormat": "DATASET"
              },
              "transforms": [
                {
                  "expression": "sortDataset({value},0,false)",
                  "type": "expression"
                },
                {
                  "code": "# Transform de tipo Script sobre el binding de datos de la Table\n\t\n\t    \"\"\"\n\t    value: suele ser un Dataset (pDataset) proveniente de queryTagHistory o similar\n\t    Retorna un nuevo Dataset con columna \u0027Estado\u0027 mapeada desde \u0027value\u0027\n\t    \"\"\"\n\t    from com.inductiveautomation.ignition.common import BasicDataset\n\t    from java.util import ArrayList\n\t    \n\t    if value is None:\n\t        return value\n\t    \n\t    # Convertir a listas para manipular\n\t    headers \u003d list(value.getColumnNames())\n\t    rows \u003d []\n\t    map_dict \u003d {0: u\"Pausa\", 1: u\"Marcha\", 2: u\"Paro\"}\n\t    \n\t    # Si existe la columna \u0027value\u0027, creamos columna \u0027Estado\u0027\n\t    add_estado \u003d \u0027value\u0027 in headers and \u0027Estado\u0027 not in headers\n\t    if add_estado:\n\t        headers \u003d headers + [\u0027Estado\u0027]\n\t    \n\t    for r in range(value.getRowCount()):\n\t        row \u003d [value.getValueAt(r, c) for c in range(value.getColumnCount())]\n\t        if add_estado:\n\t            v \u003d value.getValueAt(r, \u0027value\u0027)\n\t            estado \u003d map_dict.get(int(v) if v is not None else None, u\"Desconocido\")\n\t            row.append(estado)\n\t        rows.append(row)\n\t    \n\t    # Reconstruir dataset\n\t    colTypes \u003d [value.getColumnType(i) for i in range(value.getColumnCount())]\n\t    if add_estado:\n\t        from java.lang import String\n\t        colTypes \u003d colTypes + [String]\n\t    \n\t    return BasicDataset(headers, colTypes, rows)",
                  "type": "script"
                }
              ],
              "type": "tag-history"
            }
          },

{
  "custom": {},
  "params": {},
  "props": {},
  "root": {
    "children": [
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "basis": "50%"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "now()"
              },
              "transforms": [
                {
                  "formatType": "datetime",
                  "formatValue": {
                    "date": "medium",
                    "time": "medium"
                  },
                  "type": "format"
                }
              ],
              "type": "expr"
            }
          }
        },
        "props": {
          "alignVertical": "top",
          "textStyle": {
            "fontSize": 50
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "type": "ia.container.flex"
  }
}
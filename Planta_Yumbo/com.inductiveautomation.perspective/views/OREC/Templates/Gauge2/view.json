{
  "custom": {},
  "params": {
    "Objetivo": "value",
    "Real": "value"
  },
  "propConfig": {
    "params.Objetivo": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.Real": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 384,
      "width": 391
    }
  },
  "root": {
    "children": [
      {
        "custom": {
          "Font_Size": 60,
          "Hlimit": 75,
          "LLimit": 50,
          "Size": 350,
          "obj": 16000
        },
        "meta": {
          "name": "SimpleGauge"
        },
        "position": {
          "rotate": {
            "anchor": "50% 57%"
          }
        },
        "propConfig": {
          "custom.real": {
            "binding": {
              "config": {
                "path": "parent.custom.Producidas"
              },
              "type": "property"
            }
          },
          "position.height": {
            "binding": {
              "config": {
                "expression": "{this.custom.Size}"
              },
              "type": "expr"
            }
          },
          "position.width": {
            "binding": {
              "config": {
                "expression": "{this.custom.Size}"
              },
              "type": "expr"
            }
          },
          "props.arc.color": {
            "binding": {
              "config": {
                "expression": "if({this.props.value}\u003c{this.custom.LLimit},\"#FF0000\",\r\n\tif({this.props.value}\u003e{this.custom.Hlimit},\"#05e177\",\"#fe8330\"))"
              },
              "type": "expr"
            }
          },
          "props.arc.width": {
            "binding": {
              "config": {
                "expression": "{this.custom.Size}/10\r\n"
              },
              "type": "expr"
            }
          },
          "props.label.offsetY": {
            "binding": {
              "config": {
                "expression": "{this.custom.Size}/10"
              },
              "type": "expr"
            }
          },
          "props.label.size": {
            "binding": {
              "config": {
                "expression": "{this.custom.Size}/6.6"
              },
              "type": "expr"
            }
          },
          "props.value": {
            "binding": {
              "config": {
                "expression": "(({parent.custom.REAL}*100)/{parent.custom.OBJETIVO})"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "animate": true,
          "arc": {
            "cornerRadius": 8
          },
          "arcBackground": {
            "color": "#FFFFFF",
            "opacity": 1
          },
          "endAngle": 405,
          "label": {
            "color": "#FFFFFF",
            "maxDecimal": 0,
            "units": "%"
          },
          "startAngle": 135,
          "style": {
            "backgroundColor": "#FFFFFF",
            "backgroundImage": "linear-gradient(0deg, rgb(1, 10, 51), rgb(1, 82, 137), rgb(2, 239, 245))",
            "borderBottomLeftRadius": 20,
            "borderBottomRightRadius": 20,
            "borderColor": "#000000",
            "borderStyle": "solid",
            "borderTopLeftRadius": 20,
            "borderTopRightRadius": 20,
            "borderWidth": 2,
            "classes": []
          }
        },
        "type": "ia.chart.simple-gauge"
      }
    ],
    "custom": {
      "OBJETIVO": 16000,
      "REAL": "value"
    },
    "meta": {
      "name": "root"
    },
    "props": {
      "style": {
        "backgroundColor": "#FFFFFF"
      }
    },
    "type": "ia.container.coord"
  }
}
{
  "custom": {},
  "params": {
    "hora": "value",
    "titulo": "value"
  },
  "propConfig": {
    "params.hora": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.titulo": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 56,
      "width": 1920
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "basis": "271px"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "dateformat(now(),\"dd/MMMM/yyyy - h:mm:ss a\")"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "textStyle": {
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Label_0"
        },
        "position": {
          "basis": "921px"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.titulo"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "textStyle": {
            "fontFamily": "serif",
            "fontSize": 50,
            "fontWeight": "900",
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Image_0"
        },
        "position": {
          "basis": "374px",
          "shrink": 0
        },
        "props": {
          "fit": {
            "mode": "fill"
          },
          "source": "/system/images/clarios logo.png",
          "style": {
            "borderBottomLeftRadius": 10,
            "borderBottomRightRadius": 10,
            "borderTopLeftRadius": 10,
            "borderTopRightRadius": 10,
            "marginBottom": 10,
            "marginLeft": 10,
            "marginRight": 10,
            "marginTop": 10
          }
        },
        "type": "ia.display.image"
      }
    ],
    "meta": {
      "name": "root"
    },
    "position": {
      "titulo": "value"
    },
    "props": {
      "justify": "space-between",
      "style": {
        "backgroundImage": "linear-gradient(60deg, rgb(32, 36, 150), rgb(67, 12, 121), rgb(3, 3, 23))"
      }
    },
    "type": "ia.container.flex"
  }
}
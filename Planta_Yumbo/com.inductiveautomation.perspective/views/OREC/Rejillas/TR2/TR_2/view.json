            "onActionPerformed": {
              "config": {
                "script": "\t# Leer los valores de los tags\n\tdato1 \u003d system.tag.readBlockingself.getSibling(\"NumericEntryField\").props.value\n\tdato2 \u003d system.tag.readBlockingself.getSibling(\"NumericEntryField_0\").props.value\n\t\n\t# Comparar\n\tmayor \u003d max(dato1, dato2)\n\t\n\t# Escribir el valor en el Label (si lo llamaste \u0027Label\u0027 y tiene custom property \u0027mayorValor\u0027)\n\tself.getSiblingself.getSibling(\"resultado\").props.text \u003d \"El mayor es: {}\".format(mayor)\n\t\n\t# (opcional) también puedes escribirlo a un tag\n\tsystem.tag.writeBlocking([\"[default]mayorDato\"], [mayor])"

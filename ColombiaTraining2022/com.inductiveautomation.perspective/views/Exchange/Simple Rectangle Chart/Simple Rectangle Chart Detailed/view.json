{
  "custom": {
    "chartData": {
      "canRenderChart": false,
      "html": ""
    },
    "detailed": {
      "dateRange": {
        "dateFormat": "MM/dd/yyyy h:mm a",
        "display": true,
        "spaceBetween": false,
        "textStyle": {}
      },
      "legend": {
        "display": true,
        "icon": {
          "height": 24,
          "width": 24
        },
        "textStyle": {}
      },
      "title": {
        "display": true,
        "text": "",
        "textStyle": {}
      }
    }
  },
  "params": {
    "data": [],
    "dateRange": {
      "dateFormat": "MM/dd/yyyy h:mm a",
      "display": true,
      "spaceBetween": false,
      "textStyle": {}
    },
    "definitions": [],
    "fallbackColor": "var(--neutral-80)",
    "historicalMode": {
      "enabled": false,
      "endDate": null
    },
    "legend": {
      "display": true,
      "icon": {
        "height": 24,
        "width": 24
      },
      "textStyle": {}
    },
    "title": {
      "display": true,
      "text": "",
      "textStyle": {}
    },
    "tooltipDateFormat": "MM/dd h:mm a"
  },
  "propConfig": {
    "custom.chartData": {
      "binding": {
        "config": {
          "struct": {
            "data": "{view.params.data}",
            "definitions": "{view.params.definitions}",
            "fallbackColor": "{view.params.fallbackColor}",
            "historicalMode": "{view.params.historicalMode}",
            "tooltipDateFormat": "{view.params.tooltipDateFormat}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\t# Get the input data.\n\tinputData \u003d value[\u0027data\u0027]\n\t\n\t# Get the definitions.\n\tdefinitions \u003d value[\u0027definitions\u0027]\n\t\n\t# Get the fallback color.\n\tfallbackColor \u003d value[\u0027fallbackColor\u0027]\n\t\n\t# Get the tooltip date format.\n\ttooltipDateFormat \u003d value[\u0027tooltipDateFormat\u0027]\n\n\t# Get the historical mode settings.\n\thistoricalMode \u003d value[\u0027historicalMode\u0027]\n\t\n\t# Create the series of SVG rects that represent the input data.\n\treturn exchange.simple_rectangle_chart.main.createChart(inputData, definitions, fallbackColor, tooltipDateFormat, historicalMode, detailed\u003dTrue)",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.detailed": {
      "binding": {
        "config": {
          "struct": {
            "dateRange": "{view.params.dateRange}",
            "legend": "{view.params.legend}",
            "title": "{view.params.title}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\t# Get the title settings.\n\ttitle \u003d value[\u0027title\u0027]\n\t\n\t# Get the legend settings.\n\tlegend \u003d value[\u0027legend\u0027]\n\t\n\t# Get the dateRange settings.\n\tdateRange \u003d value[\u0027dateRange\u0027]\n\t\n\t# Ensure that the params contain the expected object members.\n\treturn exchange.simple_rectangle_chart.detailed.handleParams(title, legend, dateRange)",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.data": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.dateRange": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.definitions": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.fallbackColor": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.historicalMode": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.legend": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.title": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tooltipDateFormat": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 675,
      "width": 1011
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Title"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "{view.custom.detailed.title.display} \u0026\u0026 len({view.custom.detailed.title.text}) \u003e 0"
              },
              "type": "expr"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.custom.detailed.title.text"
              },
              "type": "property"
            }
          },
          "props.textStyle": {
            "binding": {
              "config": {
                "path": "view.custom.detailed.title.textStyle"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "exchange/simple-rectangle-chart/simple-rectangle-chart-detailed/title",
            "cursor": "default",
            "marginBottom": "2.5px"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Chart"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.source": {
            "binding": {
              "config": {
                "path": "view.custom.chartData.html"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "markdown": {
            "escapeHtml": false
          },
          "style": {
            "overflow": "hidden"
          }
        },
        "type": "ia.display.markdown"
      },
      {
        "meta": {
          "name": "Date Range"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "{view.custom.detailed.dateRange.display} \u0026\u0026 len({this.props.source}) \u003e 0"
              },
              "type": "expr"
            }
          },
          "props.source": {
            "binding": {
              "config": {
                "struct": {
                  "canRenderChart": "{view.custom.chartData.canRenderChart}",
                  "dateRangeDateFormat": "{view.custom.detailed.dateRange.dateFormat}",
                  "end": "{view.custom.chartData.end}",
                  "spaceBetween": "{view.custom.detailed.dateRange.spaceBetween}",
                  "start": "{view.custom.chartData.start}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\t# Get the start date and end date of the time series data.\n\tstart, end \u003d value[\u0027start\u0027], value[\u0027end\u0027]\n\t\n\t# Get the date format for the date range.\n\tdateRangeDateFormat \u003d value[\u0027dateRangeDateFormat\u0027]\n\t\n\t# Get the flag that denotes if a flex-container with justify-content\u003d\n\t# space-between will be used to display the date range.\n\tspaceBetween \u003d value[\u0027spaceBetween\u0027]\n\t\n\t# Get the flag that denotes whether the data passed the checks.\n\tcanRenderChart \u003d value[\u0027canRenderChart\u0027]\n\t\n\t# Create and return the date range label.\n\treturn exchange.simple_rectangle_chart.detailed.createDateRange(start, end, dateRangeDateFormat, spaceBetween, canRenderChart)",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          },
          "props.style": {
            "binding": {
              "config": {
                "path": "view.custom.detailed.dateRange.textStyle"
              },
              "transforms": [
                {
                  "code": "\t# Define the base style.\n\tdateRangeStyle \u003d {\n\t  \"classes\": \"exchange/simple-rectangle-chart/simple-rectangle-chart-detailed/date-range\",\n\t  \"marginTop\": \"2.5px\",\n\t  \"cursor\": \"default\"\n\t}\n\t\n\t# Update the base style with style from the param.\n\tdateRangeStyle.update(value)\n\t\n\treturn dateRangeStyle",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "markdown": {
            "escapeHtml": false
          }
        },
        "type": "ia.display.markdown"
      },
      {
        "meta": {
          "name": "Items"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "{view.custom.detailed.legend.display} \u0026\u0026 {view.custom.chartData.canRenderChart}"
              },
              "type": "expr"
            }
          },
          "props.instances": {
            "binding": {
              "config": {
                "struct": {
                  "canRenderChart": "{view.custom.chartData.canRenderChart}",
                  "definitions": "{view.custom.chartData.definitions}",
                  "icon": "{view.custom.detailed.legend.icon}",
                  "textStyle": "{view.custom.detailed.legend.textStyle}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\t# Get the definitions.\n\tdefinitions \u003d value[\u0027definitions\u0027]\t\n\t\n\t# Get the icon settings.\n\ticon \u003d value[\u0027icon\u0027]\n\t\n\t# Get the style for the legend labels.\n\ttextStyle \u003d value[\u0027textStyle\u0027]\n\t\n\t# Get the flag that denotes whether the data passed the checks.\n\tcanRenderChart \u003d value[\u0027canRenderChart\u0027]\n\t\n\t# Create and return the legend items.\n\treturn exchange.simple_rectangle_chart.detailed.createLegendItems(definitions, icon, textStyle, canRenderChart)",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "alignItems": "flex-start",
          "elementPosition": {
            "basis": "auto",
            "grow": 0,
            "shrink": 0
          },
          "justify": "center",
          "path": "Exchange/Simple Rectangle Chart/Framework/Legend Item",
          "style": {
            "column-gap": "25px",
            "marginTop": "10px",
            "overflow": "hidden",
            "row-gap": "10px"
          },
          "useDefaultViewHeight": false,
          "useDefaultViewWidth": false,
          "wrap": "wrap"
        },
        "type": "ia.display.flex-repeater"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}
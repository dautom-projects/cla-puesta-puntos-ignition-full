{
  "custom": {},
  "params": {
    "color": "var(--indicator)",
    "icon": {
      "height": 24,
      "width": 24
    },
    "label": "Available",
    "textStyle": {}
  },
  "propConfig": {
    "params.color": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.icon": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.textStyle": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 24,
      "width": 248
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Icon"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.basis": {
            "binding": {
              "config": {
                "path": "view.params.icon.width"
              },
              "transforms": [
                {
                  "code": "\treturn \u0027{width}px\u0027.format(width \u003d value)",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.fill.paint": {
            "binding": {
              "config": {
                "path": "view.params.color"
              },
              "type": "property"
            }
          },
          "props.style.height": {
            "binding": {
              "config": {
                "path": "view.params.icon.height"
              },
              "transforms": [
                {
                  "code": "\treturn \u0027{height}px\u0027.format(height \u003d value)",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.style.width": {
            "binding": {
              "config": {
                "path": "view.params.icon.width"
              },
              "transforms": [
                {
                  "code": "\treturn \u0027{width}px\u0027.format(width \u003d value)",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "elements": [
            {
              "height": 22,
              "name": "Icon",
              "rx": 5,
              "ry": 5,
              "stroke": "var(--neutral-50)",
              "stroke-width": "1px",
              "type": "rect",
              "width": 22,
              "x": 1,
              "y": 1
            }
          ],
          "fill": {},
          "preserveAspectRatio": "none",
          "viewBox": "0 0 24 24"
        },
        "type": "ia.shapes.svg"
      },
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.label"
              },
              "type": "property"
            }
          },
          "props.textStyle": {
            "binding": {
              "config": {
                "path": "view.params.textStyle"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "exchange/simple-rectangle-chart/framework/legend/item/label",
            "cursor": "default"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "style": {
        "backgroundColor": "#FFFFFF00",
        "gap": "5px",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}
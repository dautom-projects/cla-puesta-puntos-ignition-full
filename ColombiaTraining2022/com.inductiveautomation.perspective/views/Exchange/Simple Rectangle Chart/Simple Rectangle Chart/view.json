{
  "custom": {},
  "params": {
    "data": [],
    "definitions": [],
    "fallbackColor": "var(--neutral-80)",
    "historicalMode": {
      "enabled": false,
      "endDate": null
    },
    "tooltipDateFormat": "MM/dd h:mm a"
  },
  "propConfig": {
    "params.data": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.definitions": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.fallbackColor": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.historicalMode": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tooltipDateFormat": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 70,
      "width": 457
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Chart"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.source": {
            "binding": {
              "config": {
                "struct": {
                  "data": "{view.params.data}",
                  "definitions": "{view.params.definitions}",
                  "fallbackColor": "{view.params.fallbackColor}",
                  "historicalMode": "{view.params.historicalMode}",
                  "tooltipDateFormat": "{view.params.tooltipDateFormat}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\t# Get the input data.\n\tinputData \u003d value[\u0027data\u0027]\n\t\n\t# Get the definitions.\n\tdefinitions \u003d value[\u0027definitions\u0027]\n\t\n\t# Get the fallback color.\n\tfallbackColor \u003d value[\u0027fallbackColor\u0027]\n\t\n\t# Get the tooltip date format.\n\ttooltipDateFormat \u003d value[\u0027tooltipDateFormat\u0027]\n\t\n\t# Get the historical mode settings.\n\thistoricalMode \u003d value[\u0027historicalMode\u0027]\n\t\n\t# Create the series of SVG rects that represent the input data.\n\treturn exchange.simple_rectangle_chart.main.createChart(inputData, definitions, fallbackColor, tooltipDateFormat, historicalMode)",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "markdown": {
            "escapeHtml": false
          },
          "style": {
            "overflow": "hidden"
          }
        },
        "type": "ia.display.markdown"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}
{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "height": 397,
      "width": 740
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Thermometer"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.value": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "direct",
                "publishInitial": false,
                "tagPath": "[default]Ensamble/4/Termos/production count"
              },
              "type": "tag"
            }
          }
        },
        "type": "ia.display.thermometer"
      },
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "\"Produccion Linea 4 \u003d \" + {[default]Ensamble/4/Termos/production count}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "textStyle": {
            "backgroundColor": "#00D900",
            "fontSize": 30,
            "fontWeight": "bold",
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Button"
        },
        "position": {
          "basis": "150px"
        },
        "props": {
          "image": {
            "height": 80
          }
        },
        "type": "ia.input.button"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "justify": "center"
    },
    "type": "ia.container.flex"
  }
}
{
  "custom": {},
  "params": {
    "nombre": "temp 1",
    "temperatura": 99999
  },
  "propConfig": {
    "params.nombre": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.temperatura": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 540,
      "width": 302
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Thermometer_3"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.value": {
            "binding": {
              "config": {
                "path": "view.params.temperatura"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "highBound": 520,
          "lowBound": 470,
          "mercuryColor": "#E28D2B",
          "thermometerColor": "#E21C47"
        },
        "type": "ia.display.thermometer"
      },
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "basis": "100px",
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.nombre"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "textStyle": {
            "borderStyle": "solid",
            "borderWidth": 2,
            "fontSize": 30,
            "fontWeight": "bold",
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "borderStyle": "solid",
        "borderWidth": 1
      }
    },
    "type": "ia.container.flex"
  }
}
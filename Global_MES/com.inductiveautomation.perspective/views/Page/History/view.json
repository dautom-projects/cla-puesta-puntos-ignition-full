{
  "custom": {},
  "params": {},
  "props": {},
  "root": {
    "children": [
      {
        "meta": {
          "name": "PowerChart"
        },
        "position": {
          "basis": "600px",
          "grow": 1
        },
        "props": {
          "interaction": {
            "chartZoomLevel": 1,
            "rangeZoomLevel": 1
          }
        },
        "type": "ia.chart.powerchart"
      },
      {
        "meta": {
          "name": "Label"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "\"Status: \" + {[UNS]Clarios/Pacifico/Cubiertas/IMM 15/Edge/Status}"
              },
              "type": "expr"
            }
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Label_0"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "\"Mode: \" + {[UNS]Clarios/Pacifico/Cubiertas/IMM 15/Edge/MachineStatus/MachineMode}"
              },
              "type": "expr"
            }
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Label_1"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "\"Infeed: \" + {[UNS]Clarios/Pacifico/Cubiertas/IMM 15/Edge/Infeed}"
              },
              "type": "expr"
            }
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Label_2"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "\"Outfeed: \" + {[UNS]Clarios/Pacifico/Cubiertas/IMM 15/Edge/Outfeed}"
              },
              "type": "expr"
            }
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Label_3"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "\"Total historico: \" + {[UNS]Clarios/Pacifico/Cubiertas/IMM 15/Edge/Jobs/ActiveJobValues/MachineCycleCounter}"
              },
              "type": "expr"
            }
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}
                "events": {
                  "dom": {
                    "onClick": {
                      "config": {
                        "script": "\tdb \u003d self.view.custom.dbConnection\n\ttable \u003d mes_core.model.moldeTable(db)\n\t\n\tif not self.view.custom.inCode:\n\t\tself.view.custom.textLabel \u003d \u0027Inserte codigo de Molde\u0027\n\t\treturn 0\n\t\t\n\telif int(self.view.custom.inSlot) \u003c 1:\n\t\tself.view.custom.textLabel \u003d \u0027La ranura debe se entero mayor o igual a 1\u0027\n\t\treturn 0\n\t\n\telif self.view.params.function \u003d\u003d \"Crear\": #First function Crear:\n\t\tmoldecode \u003d self.view.custom.inCode\n\t\tdescription \u003d self.view.custom.inDescrip\n\t\tdisable \u003d self.view.custom.inEnable\n\t\tslot \u003d self.view.custom.inSlot\n\t\t\n\t\tcondition, ids \u003d table.validateColumn({\u0027MoldCode\u0027:moldecode})\n\t\t\n\t\tif bool(condition):\n\t\t\tself.view.custom.textLabel \u003d \u0027Ya existe un codigo igual\u0027\n\t\t\treturn 0\n\t\t\n\t\telse:\n\t\t\ttable.insert(moldecode\u003dmoldecode,slot\u003dslot,description\u003ddescription,disable\u003ddisable) \n\t\t\t\n\t\t\tsystem.perspective.closePopup(\"createedit\")\n\t\t\t\n\t\t\t# Pop up for succesful transaction\n\t\t\talerts.actionSuccess(title\u003d\u0027Molde creado\u0027, \n\t\t\t\t\t\t\t\tmessage\u003d\u0027Molde \"{}\" creado correctamente\u0027.format(moldecode))\n\t\t\t\n\t\t\t# Refresh table after query\n\t\t\tsystem.perspective.sendMessage(\"refreshTableMoldes\", payload\u003d{})\n\t\t\t\n\t\t\t\n\t\t\n\telif self.view.params.function \u003d\u003d \"Editar\": #Second function editar\n\n\t\t# define inputs\n\t\tmoldecode \u003d self.view.custom.inCode\n\t\tdescription \u003d self.view.custom.inDescrip\n\t\tdisable \u003d self.view.custom.inEnable\n\t\tslot \u003d self.view.custom.inSlot\n\t\tselid \u003d self.view.params.selection.selid\n\t\t\n\t\tcondition, ids \u003d table.validateColumn({\u0027MoldCode\u0027:moldecode})\n\t\t\n\t\tif bool(condition) and selid not in ids :\n\t\t\tself.view.custom.textLabel \u003d \u0027Ya existe un codigo igual\u0027\n\t\t\treturn 0\n\t\telse:\n\t\t\ttable.updateID(selid, {\"Description\":description,\"MoldCode\":moldecode,\"Disable\":disable,\"Slot\":slot})\n\t\t\t\n\t\t\tsystem.perspective.closePopup(\"createedit\")\n\t\t\t\n\t\t\t# Pop up for succesful transaction\n\t\t\talerts.actionSuccess(title\u003d\u0027Molde editado\u0027, \n\t\t\t\t\t\t\t\tmessage\u003d\u0027Molde \"{}\" editado correctamente\u0027.format(moldecode))\n\t\t\t\n\t\t\t# Refresh table after query\n\t\t\tsystem.perspective.sendMessage(\"refreshTableMoldes\", payload\u003d{})"
                      },
                      "scope": "G",
                      "type": "script"
                    }

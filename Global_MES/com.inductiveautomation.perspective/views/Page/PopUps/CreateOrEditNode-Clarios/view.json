                  {
                    "events": {
                      "dom": {
                        "onClick": {
                          "config": {
                            "script": "\n\timport re\n\timport system\n\timport mes_core\n\tlogger \u003d system.util.getLogger(\"CreateEditNode\")\n\tfunc \u003d getattr(self.view.params, \"function\", None)\n\tif func not in (\"Crear\", \"Editar\"):\n\t\treturn 0\n\n\tdb \u003d self.view.custom.dbConnection\n\ttable \u003d mes_core.model.nodeTable(db)\n\n\t# Entradas UI\n\tname \u003d (self.view.custom.inName or u\"\").strip()\n\ttopic \u003d (self.view.custom.inTopic or u\"\").strip()\n\ttyp \u003d (self.view.custom.inType or u\"\").strip().upper()\n\tparentId \u003d self.view.custom.inParentID\n\tdisplayname \u003d name\n\tselectable \u003d self.view.custom.inDisable\n\tnode_id \u003d self.view.params.selection.selID\n\n\t# Requeridos básicos\n\tif not name:\n\t\tself.view.custom.textLabel \u003d u\"Ingrese un Nombre\"\n\t\treturn 0\n\tif not topic:\n\t\tself.view.custom.textLabel \u003d u\"Ingrese un Topic\"\n\t\treturn 0\n\n\t# Validación de tipo\n\tallowed \u003d {\"ENTERPRISE\", \"SITE\", \"AREA\", \"LINE\", \"EQUIPMENT\"}\n\tif typ not in allowed:\n\t\tself.view.custom.textLabel \u003d u\"Tipo inválido. Use: ENTERPRISE, SITE, AREA, LINE o EQUIPMENT.\"\n\t\treturn 0\n\n\t# Formato de Topic por tipo\n\tdepth_by_type \u003d {\"ENTERPRISE\": 1, \"SITE\": 2, \"AREA\": 3, \"LINE\": 4, \"EQUIPMENT\": 5}\n\tplaceholders \u003d [\"Enterprise\", \"Site\", \"Area\", \"Line\", \"Equipment\"]\n\texpected_depth \u003d depth_by_type[typ]\n\texpected_example \u003d \"/\".join(placeholders[:expected_depth])\n\n\tparts \u003d topic.split(\"/\")\n\tif len(parts) !\u003d expected_depth:\n\t\tself.view.custom.textLabel \u003d (\n\t\t\tu\"Formato de Ruta inválido para {}. Debe tener {} segmento(s): {}\"\n\t\t\t.format(typ, expected_depth, expected_example)\n\t\t)\n\t\treturn 0\n\n\talnum_space \u003d re.compile(r\u0027^[A-Za-z0-9 ]+$\u0027)\n\tfor i, seg in enumerate(parts, 1):\n\t\tseg \u003d seg.strip()\n\t\tif not seg:\n\t\t\tself.view.custom.textLabel \u003d u\"Segmento {} de la Ruta está vacío. Ejemplo: {}\".format(i, expected_example)\n\t\t\treturn 0\n\t\tif not alnum_space.match(seg):\n\t\t\tself.view.custom.textLabel \u003d (\n\t\t\t\tu\"Segmento {} inválido: \u0027{}\u0027. Use solo letras/números ASCII y espacios; \"\n\t\t\t\tu\"sin tildes, \u0027ñ\u0027 ni símbolos. Ejemplo: {}\".format(i, seg, expected_example)\n\t\t\t)\n\t\t\treturn 0\n\n\t# Último segmento debe coincidir con Name (case-insensitive)\n\tif parts[-1].strip().upper() !\u003d name.strip().upper():\n\t\tself.view.custom.textLabel \u003d (\n\t\t\tu\"El último segmento de la Ruta (\u0027{}\u0027) debe coincidir con el Nombre (\u0027{}\u0027).\"\n\t\t\t.format(parts[-1].strip(), name)\n\t\t)\n\t\treturn 0\n\n\t# Unicidad de Topic (global) usando validateColumn\n\ttopic_exists, topic_ids \u003d table.validateColumn({\u0027Topic\u0027: topic})\n\tif func \u003d\u003d \"Crear\":\n\t\tif topic_exists:\n\t\t\tself.view.custom.textLabel \u003d u\"Ya existe una Ruta igual (IDs: {}).\".format(\", \".join(map(str, topic_ids)))\n\t\t\treturn 0\n\telse:  # Editar: permitir si es el mismo registro\n\t\tif topic_exists:\n\t\t\tids_ajenos \u003d [i for i in topic_ids if i !\u003d node_id]\n\t\t\tif len(ids_ajenos) \u003e 0:\n\t\t\t\tself.view.custom.textLabel \u003d u\"Ya existe una Ruta igual en otro registro (IDs: {}).\".format(\", \".join(map(str, ids_ajenos)))\n\t\t\t\treturn 0\n\n\t# \u003d\u003d\u003d\u003d\u003d Ramas por tipo (ARREGLADO: if/elif) \u003d\u003d\u003d\u003d\u003d\n\tif typ \u003d\u003d \"ENTERPRISE\":\n\t\t# Parent permitido (y forzado) a NULL\n\t\tparentId \u003d None\n\n\t\t# Name único global (excluye self si edita)\n\t\tif func \u003d\u003d \"Crear\":\n\t\t\tdupe_name \u003d table.select(where_clause\u003d\"Name \u003d ?\", where_args\u003d[name], columns\u003d[\"ID\"])\n\t\telse:\n\t\t\tdupe_name \u003d table.select(where_clause\u003d\"Name \u003d ? AND ID \u003c\u003e ?\", where_args\u003d[name, node_id], columns\u003d[\"ID\"])\n\t\tif dupe_name and dupe_name.getRowCount() \u003e 0:\n\t\t\tids \u003d [dupe_name.getValueAt(r, \"ID\") for r in range(dupe_name.getRowCount())]\n\t\t\tself.view.custom.textLabel \u003d u\"Ya existe un Nombre de ENTERPRISE igual (IDs: {}).\".format(\", \".join(map(str, ids)))\n\t\t\treturn 0\n\n\t\t# Topic debe ser exactamente Name\n\t\tif topic !\u003d name:\n\t\t\tself.view.custom.textLabel \u003d u\"Para ENTERPRISE, la Ruta debe ser exactamente \u0027{}\u0027.\".format(name)\n\t\t\treturn 0\n\n\telif typ in (\"SITE\", \"AREA\", \"LINE\", \"EQUIPMENT\"):\n\t\t# Parent requerido\n\t\tif parentId is None:\n\t\t\tself.view.custom.textLabel \u003d u\"Seleccione un ID Padre para el tipo {}.\".format(typ)\n\t\t\treturn 0\n\n\t\t# Unicidad (ParentNodeID, Name) (excluye self si edita)\n\t\tif func \u003d\u003d \"Crear\":\n\t\t\tdupe_name \u003d table.select(\n\t\t\t\twhere_clause\u003d\"ParentNodeID \u003d ? AND Name \u003d ?\",\n\t\t\t\twhere_args\u003d[parentId, name],\n\t\t\t\tcolumns\u003d[\"ID\"]\n\t\t\t)\n\t\telse:\n\t\t\tdupe_name \u003d table.select(\n\t\t\t\twhere_clause\u003d\"ParentNodeID \u003d ? AND Name \u003d ? AND ID \u003c\u003e ?\",\n\t\t\t\twhere_args\u003d[parentId, name, node_id],\n\t\t\t\tcolumns\u003d[\"ID\"]\n\t\t\t)\n\t\tif dupe_name and dupe_name.getRowCount() \u003e 0:\n\t\t\tids \u003d [dupe_name.getValueAt(r, \"ID\") for r in range(dupe_name.getRowCount())]\n\t\t\tself.view.custom.textLabel \u003d u\"Ya existe un Nombre igual bajo el mismo ID Padre (IDs: {}).\".format(\", \".join(map(str, ids)))\n\t\t\treturn 0\n\n\t\t# Consistencia con el Parent: Topic esperado\n\t\tparent_ds \u003d table.select(where_clause\u003d\"ID \u003d ?\", where_args\u003d[parentId], columns\u003d[\"Topic\"])\n\t\tif not parent_ds or parent_ds.getRowCount() \u003d\u003d 0:\n\t\t\tself.view.custom.textLabel \u003d u\"ID Padre no encontrado.\"\n\t\t\treturn 0\n\t\tparent_topic \u003d parent_ds.getValueAt(0, \"Topic\")\n\t\texpected_topic \u003d parent_topic + \"/\" + name\n\t\tif topic !\u003d expected_topic:\n\t\t\tself.view.custom.textLabel \u003d (\n\t\t\t\tu\"Ruta inconsistente con el ID Padre. Esperado: \u0027{}\u0027. Recibido: \u0027{}\u0027.\"\n\t\t\t\t.format(expected_topic, topic)\n\t\t\t)\n\t\t\treturn 0\n\t# \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n\n\t# Operación\n\tif func \u003d\u003d \"Crear\":\n\t\ttable.insert(\n\t\t\tselectable\u003dselectable,\n\t\t\ttype\u003dtyp,\n\t\t\tdisplayname\u003ddisplayname,\n\t\t\tparentnodeid\u003dparentId,\n\t\t\tname\u003dname,\n\t\t\ttopic\u003dtopic\n\t\t)\n\t\ttry:\n\t\t\tsystem.perspective.closePopup(\"createeditnode\")\n\t\texcept:\n\t\t\tpass\n\t\tif alerts:\n\t\t\ttry:\n\t\t\t\talerts.actionSuccess(title\u003d\u0027Nodo creado\u0027, message\u003du\u0027Nodo \\\"{}\\\" creado correctamente\u0027.format(topic))\n\t\t\texcept Exception as e:\n\t\t\t\tlogger.warn(\"alerts.actionSuccess error: {}\".format(e))\n\telse:  # Editar\n\t\tif node_id is None:\n\t\t\tself.view.custom.textLabel \u003d u\"No se encontró el ID del nodo a editar.\"\n\t\t\treturn 0\n\n\t\tset_values \u003d {\n\t\t\t\u0027Selectable\u0027: selectable,\n\t\t\t\u0027Type\u0027: typ,\n\t\t\t\u0027DisplayName\u0027: displayname,\n\t\t\t\u0027ParentNodeID\u0027: parentId,\n\t\t\t\u0027Name\u0027: name,\n\t\t\t\u0027Topic\u0027: topic\n\t\t}\n\t\t# Evita escribir None accidentales salvo ParentNodeID/Selectable\n\t\tset_values \u003d dict((k, v) for k, v in set_values.items() if v is not None or k in (\u0027ParentNodeID\u0027, \u0027Selectable\u0027))\n\n\t\ttable.updateID(node_id, set_values)\n\t\ttry:\n\t\t\tsystem.perspective.closePopup(\"createeditnode\")\n\t\texcept Exception as e:\n\t\t\tlogger.warn(\"closePopup error: {}\".format(e))\n\t\tif alerts:\n\t\t\ttry:\n\t\t\t\talerts.actionSuccess(title\u003d\u0027Nodo actualizado\u0027, message\u003du\u0027Nodo ID {} actualizado correctamente\u0027.format(node_id))\n\t\t\texcept:\n\t\t\t\tpass\n\n\t# Refresh (verifica que el message handler exista con ese nombre)\n\tsystem.perspective.sendMessage(\"refreshTableNode\", payload\u003d{})\n\treturn 1"
                          },
                          "scope": "G",
                          "type": "script"
                        }
                      }

        {
          "messageType": "createRelation",
          "pageScope": true,
          "script": "\tdb \u003d self.view.custom.dbConnection\n\ttableProductMolde \u003d mes_core.model.productcodemoldeTable(db)\n\tmoldID \u003d self.view.params.moldID\n\tproductID \u003d self.view.params.productID\n\tnodeID \u003d self.view.params.nodeID\n\tstandardRate \u003d self.view.custom.inStandard\n\ttableProductNode \u003d mes_core.model.productcodelineTable(db)\n\t\n\tif self.view.params.function \u003d\u003d \u0027Crear\u0027:\n\t\t# Validar si existe la relación para la tabla de Producto y Molde\n\t\tds \u003d tableProductMolde.selectCustom(columns \u003d [\u0027ID\u0027], where_clause \u003d \u0027MoldID \u003d ? AND ProductCodeID \u003d ?\u0027, where_args \u003d [moldID,productID] )\n\t\t\n\t\tif ds.getRowCount() \u003e 0:\n\t\t\tproductMoldID \u003d ds.getValueAt(0,0)\n\t\telse:\n\t\t\ttableProductMolde.insert(moldeid \u003d moldID, productcodeid \u003d productID )\n\t\t\tds \u003d tableProductMolde.selectCustom(columns \u003d [\u0027ID\u0027], where_clause \u003d \u0027MoldID \u003d ? AND ProductCodeID \u003d ?\u0027, where_args \u003d [moldID,productID] )\n\t\t\tproductMoldID \u003d ds.getValueAt(0,0)\n\t\t\n\t\t# Validar si existe la relación para la tabla de Producto y Nodo\n\t\tds1 \u003d tableProductNode.selectCustom(columns \u003d [\u0027ID\u0027], where_clause \u003d \u0027ProductCodeID \u003d ? AND NodeID \u003d ?\u0027, where_args \u003d [productID,nodeID] )\n\t\t\n\t\tif ds1.getRowCount() \u003e 0:\n\t\t\tproductNodeID \u003d ds1.getValueAt(0,0)\n\t\telse:\n\t\t\ttableProductNode.insert(productcodeid \u003d productID, lineid \u003d nodeID)\n\t\t\tds1 \u003d tableProductNode.selectCustom(columns \u003d [\u0027ID\u0027], where_clause \u003d \u0027ProductCodeID \u003d ? AND NodeID \u003d ?\u0027, where_args \u003d [productID,nodeID] )\n\t\t\tproductNodeID \u003d ds1.getValueAt(0,0)\n\t\t\n\t\t# Crear relacion de StandardRate\n\t\ttableStandardRate \u003d mes_core.model.standardrateTable(db)\n\t\ttableStandardRate.insert(productcodeid \u003d productID, moldid \u003d moldID, nodeid \u003d nodeID, standardrate \u003d standardRate )\n\t\talerts.actionSuccess(title \u003d \u0027Relacion creada\u0027, message \u003d\u0027Se ha creado la relacion correctamente\u0027)\n\t\tsystem.perspective.closePopup(id \u003d \u0027createeditline\u0027)\n\t\tsystem.perspective.sendMessage(\u0027refreshTableRelationLine\u0027)\n\t\t\n\telif self.view.params.function \u003d\u003d \u0027Editar\u0027:\n\t\ttable \u003d mes_core.model.standardrateTable(db)\n\t\ttable.updateID(self.view.params.standardRateID,{\u0027StandardRate\u0027:self.view.custom.inStandard})\n\t\talerts.actionSuccess(title \u003d \u0027Relacion actualizada\u0027, message \u003d\u0027Se ha actualizado la relacion correctamente\u0027)\n\t\tsystem.perspective.closePopup(id \u003d \u0027createeditline\u0027)\n\t\tsystem.perspective.sendMessage(\u0027refreshTableRelationLine\u0027)\n\t\n\t# implement your handler here",
          "sessionScope": true,
          "viewScope": true
        }
      ]

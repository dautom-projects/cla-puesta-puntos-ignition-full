    "custom.recomendedReasonCode": {
      "binding": {
        "config": {
          "struct": {
            "db": "{view.custom.dbConnection}",
            "nodeID": "{view.params.nodeID}",
            "refresh": "{view.custom.refresh}",
            "subReasonOf": "{view.custom.inSubfun}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\t\"\"\"\n\tScript: recommendReasonOrSubreasonCode (Transform)\n\t\n\tBrief:\n\t\tRecommends the next ReasonCode based on table contents and your block rules:\n\t\t- If subReasonOf \u003d\u003d -1 (new Reason): next 10k-block for the NodeID (10000, 20000, ... 990000 cap).\n\t\t- If subReasonOf !\u003d -1 (new SubReason): parent\u0027s block + next incremental code (e.g., 10001, 10002, ...),\n\t\t  capped to the block upper bound (base + 9999).\n\t\n\tReturns:\n\t\tstr: Recommended ReasonCode (as text), or \"\" if not possible.\n\t\n\tParameters\n\t\tvalue (dict):\n\t\t\tdb (str):\n\t\t\t\tNamed DB connection for mes_core.model.statereasonTable.\n\t\t\t\tDefault: binding-provided.\n\t\t\tsubReasonOf (int):\n\t\t\t\t-1 for new Reason; otherwise parent Reason ID for a new SubReason.\n\t\t\t\tDefault: binding-provided.\n\t\t\tnodeID (int):\n\t\t\t\tTarget NodeID to scope the search.\n\t\t\t\tDefault: binding-provided.\n\t\n\tExample:\n\t\t# New Reason:\n\t\t# value \u003d {\"db\":\"MES_SQLSERVER\",\"subReasonOf\":-1,\"nodeID\":4}  -\u003e e.g. \"150000\"\n\t\t# New SubReason under parent ID\u003d80 (parent ReasonCode \u003d 10000):\n\t\t# value \u003d {\"db\":\"MES_SQLSERVER\",\"subReasonOf\":80,\"nodeID\":4}   -\u003e e.g. \"10017\"\n\t\"\"\"\n\t\n\t# Imports\n\t# import system\n\t\n\ttry:\n\t\t# Initialization of variables\n\t\toutput \u003d \"\"\n\t\n\t\t# Inputs\n\t\tdb \u003d value[\"db\"]\n\t\tsubReasonOf \u003d int(value[\"subReasonOf\"])\n\t\tnodeID \u003d int(value[\"nodeID\"])\n\t\n\t\t# Table model\n\t\ttable \u003d mes_core.model.statereasonTable(db)\n\t\n\t\t# Helper: first row value\n\t\tdef firstRow(ds, col):\n\t\t\tif ds is not None and ds.getRowCount() \u003e 0:\n\t\t\t\ttry:\n\t\t\t\t\treturn ds.getValueAt(0, col)\n\t\t\t\texcept:\n\t\t\t\t\treturn None\n\t\t\treturn None\n\t\n\t\t# Constants\n\t\tBLOCK_SIZE \u003d 10000\n\t\tMAX_BLOCK_CODE \u003d 990000  # cap para razones padre\n\t\n\t\tif subReasonOf \u003d\u003d -1:\n\t\t\t# ---- New Reason: siguiente bloque de 10k para este NodeID ----\n\t\t\t# Busca el mayor ReasonCode de los padres (SubReasonOf \u003d -1) de este NodeID, distinto de 990000.\n\t\t\tcolumns \u003d [\u0027ReasonCode\u0027]\n\t\t\twhereClause \u003d \u0027SubReasonOf \u003d -1 AND NodeID \u003d ? AND ReasonCode \u003c\u003e 990000 ORDER BY ReasonCode DESC\u0027\n\t\t\twhereArgs \u003d [nodeID]\n\t\t\tdsMaxParent \u003d table.selectCustom(columns\u003dcolumns, where_clause\u003dwhereClause, where_args\u003dwhereArgs)\n\t\n\t\t\tmaxParentCode \u003d firstRow(dsMaxParent, \u0027ReasonCode\u0027)\n\t\t\tif maxParentCode is None:\n\t\t\t\t# Si no hay ninguno, arrancamos en 10000\n\t\t\t\tnextBlock \u003d 10000\n\t\t\telse:\n\t\t\t\tmaxParentCode \u003d int(maxParentCode)\n\t\t\t\tnextBlock \u003d ((maxParentCode // BLOCK_SIZE) + 1) * BLOCK_SIZE\n\t\t\t\tif nextBlock \u003c 10000:\n\t\t\t\t\tnextBlock \u003d 10000\n\t\n\t\t\t# Cap a 990000\n\t\t\tif nextBlock \u003e MAX_BLOCK_CODE:\n\t\t\t\t# Sin bloque disponible\n\t\t\t\treturn \"\"\n\t\n\t\t\toutput \u003d str(nextBlock)\n\t\t\treturn output\n\t\n\t\telse:\n\t\t\t# ---- New SubReason: debajo del padre \u0027subReasonOf\u0027 ----\n\t\t\t# 1) Obtener ReasonCode del padre por ID\n\t\t\tdsParent \u003d table.selectCustom(\n\t\t\t\tcolumns\u003d[\u0027ReasonCode\u0027, \u0027NodeID\u0027],\n\t\t\t\twhere_clause\u003d\u0027ID \u003d ?\u0027,\n\t\t\t\twhere_args\u003d[subReasonOf]\n\t\t\t)\n\t\t\tparentCode \u003d firstRow(dsParent, \u0027ReasonCode\u0027)\n\t\t\tif parentCode is None:\n\t\t\t\treturn \"\"\n\t\n\t\t\tparentCode \u003d int(parentCode)\n\t\t\t# El bloque base es múltiplo inferior de 10k\n\t\t\tblockBase \u003d (parentCode // BLOCK_SIZE) * BLOCK_SIZE\n\t\t\tblockTop \u003d blockBase + (BLOCK_SIZE - 1)\n\t\n\t\t\t# 2) Buscar mayor ReasonCode entre las subrazones del padre, en este NodeID\n\t\t\tdsMaxChild \u003d table.selectCustom(\n\t\t\t\tcolumns\u003d[\u0027ReasonCode\u0027],\n\t\t\t\twhere_clause\u003d\u0027SubReasonOf \u003d ? AND NodeID \u003d ? ORDER BY ReasonCode DESC\u0027,\n\t\t\t\twhere_args\u003d[subReasonOf, nodeID]\n\t\t\t)\n\t\t\tmaxChildCode \u003d firstRow(dsMaxChild, \u0027ReasonCode\u0027)\n\t\n\t\t\tif maxChildCode is None:\n\t\t\t\t# Primera subrazón → parentCode si el padre ya está formateado con base exacta (10000, 120000, etc.)\n\t\t\t\t# y la primera subrazón debe ser +1\n\t\t\t\tnextCode \u003d blockBase + 1\n\t\t\telse:\n\t\t\t\tnextCode \u003d int(maxChildCode) + 1\n\t\n\t\t\t# 3) Validar rango dentro del bloque\n\t\t\tif nextCode \u003c (blockBase + 1):\n\t\t\t\tnextCode \u003d blockBase + 1\n\t\t\tif nextCode \u003e blockTop:\n\t\t\t\t# bloque lleno\n\t\t\t\treturn \"\"\n\t\n\t\t\toutput \u003d str(nextCode)\n\t\t\treturn output\n\t\n\texcept:\n\t\t# Return\n\t\treturn \"\"",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "onChange": {
        "enabled": null,
        "script": "\tself.custom.inCode \u003d currentValue.value"
      },
      "persistent": true
    },
    "custom.refresh": {
      "onChange": {

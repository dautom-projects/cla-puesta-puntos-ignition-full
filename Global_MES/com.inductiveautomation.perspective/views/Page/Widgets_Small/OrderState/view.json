  "propConfig": {
    "custom.actualRun": {
      "persistent": true
    },
    "custom.actualRun.dataset": {
      "binding": {
        "config": {
          "struct": {
            "dbConnection": "{view.custom.dbConnection}",
            "nodeID": "{view.params.nodeID}",
            "refresh": "now(10000)"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\ttry:\n\t\tnodeID \u003d value[\"nodeID\"]\n\t\tdb \u003d value[\"dbConnection\"]\n\t\tquery \u003d \u0027\u0027\u0027SELECT \n\t\t\t\t    rn.ID AS RunID,\n\t\t\t\t    sch.Quantity,\n\t\t\t\t    rn.TotalCount,\n\t\t\t\t    rn.RunStartDateTime,\n\t\t\t\t    rn.EstimatedFinishedTime,\n\t\t\t\t   \two.WorkOrder,\n\t\t\t\t   \two.ID AS WorkOrderID,\n\t\t\t\t    CAST(rn.TotalCount * 100.0 / NULLIF(sch.Quantity, 0) AS FLOAT) AS progressValue\n\t\t\t\tFROM run rn\n\t\t\t\tINNER JOIN schedule sch \n\t\t\t\t    ON sch.ID \u003d rn.ScheduleID\n\t\t\t\tINNER JOIN workorder wo\n\t\t\t\t\tON wo.ID \u003d sch.WorkOrderID\n\t\t\t\tWHERE rn.Closed \u003d 0\n\t\t\t\tORDER BY rn.ID DESC\n\t\t\t\t\u0027\u0027\u0027\n\t\tds \u003d system.db.runQuery(query, database \u003d db)\n\t\treturn ds\n\texcept:\n\t\treturn -1",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "custom.dbConnection": {
      "binding": {
        "config": {
          "path": "session.custom.dbConnection"
        },
        "type": "property"
      },
      "persistent": true
    },
    "params.nodeID": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.state": {
      "paramDirection": "input",
      "persistent": true
    }
  },

{
  "custom": {},
  "params": {
    "availability": 0.3,
    "runTime": 600,
    "scheduledTime": 3000
  },
  "propConfig": {
    "params.availability": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.runTime": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.scheduledTime": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 300,
      "width": 250
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "basis": "28px",
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "text-titles-2"
          },
          "text": "Disponibilidad"
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "SimpleGauge"
        },
        "position": {
          "basis": "200px",
          "grow": 1
        },
        "propConfig": {
          "props.arc.color": {
            "binding": {
              "config": {
                "path": "this.props.value"
              },
              "transforms": [
                {
                  "code": "\t\n\tif self.session.props.theme\u003d\u003d\"cla-light\":\n\t\tif value\u003c\u003d30:\n\t\t\treturn \"#F00C2D\"\n\t\tif value\u003e30 and value\u003c\u003d60:\n\t\t\treturn \"#FFCD06\"\n\t\tif value\u003e60:\n\t\t\treturn \"#0F7F9A\"\n\tif self.session.props.theme\u003d\u003d\"cla-dark\":\n\t\tif value\u003c\u003d30:\n\t\t\treturn \"#F00C2D\"\n\t\tif value\u003e30 and value\u003c\u003d60:\n\t\t\treturn \"#FFCD06\"\n\t\tif value\u003e60:\n\t\t\treturn \"#0F7F9A\"",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.arcBackground.color": {
            "binding": {
              "config": {
                "path": "session.props.theme"
              },
              "enabled": false,
              "transforms": [
                {
                  "fallback": null,
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": "cla-light",
                      "output": "#A78BB9"
                    },
                    {
                      "input": "light-cool",
                      "output": "#FFFFFF"
                    },
                    {
                      "input": "light-warm",
                      "output": "#FFFFFF"
                    },
                    {
                      "input": "cla-dark",
                      "output": "#BABFC8"
                    },
                    {
                      "input": "dark-cool",
                      "output": "#BABFC8"
                    },
                    {
                      "input": "dark-warm",
                      "output": "#BABFC8"
                    }
                  ],
                  "outputType": "scalar",
                  "type": "map"
                },
                {
                  "code": "\t\t\n\ttry:\n\t\treturn value\n\texcept:\n\t\treturn None",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.label.color": {
            "binding": {
              "config": {
                "path": "session.props.theme"
              },
              "transforms": [
                {
                  "fallback": "#e5e0df",
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": "cla-light",
                      "output": "#5e5e5e"
                    },
                    {
                      "input": "light-cool",
                      "output": "#4d5358"
                    },
                    {
                      "input": "light-warm",
                      "output": "#565151"
                    },
                    {
                      "input": "cla-dark",
                      "output": "#ffffff"
                    },
                    {
                      "input": "dark-cool",
                      "output": "#dde1e6"
                    }
                  ],
                  "outputType": "scalar",
                  "type": "map"
                }
              ],
              "type": "property"
            }
          },
          "props.value": {
            "binding": {
              "config": {
                "expression": "//Cuando el valor es negativo es 0\r\nif ({view.params.availability} \u003c 0 ,0, {view.params.availability})"
              },
              "transforms": [
                {
                  "code": "\ttry:\n\t\treturn value\n\texcept: \n\t\treturn None",
                  "type": "script"
                }
              ],
              "type": "expr"
            }
          }
        },
        "props": {
          "animate": true,
          "arc": {},
          "arcBackground": {
            "color": "#FFFFFF",
            "opacity": 0.9
          },
          "endAngle": 405,
          "label": {
            "maxDecimal": 1,
            "offsetX": 3,
            "offsetY": 12,
            "size": 24,
            "units": "%"
          },
          "startAngle": 135
        },
        "type": "ia.chart.simple-gauge"
      },
      {
        "children": [
          {
            "meta": {
              "name": "Label_Spacer_0"
            },
            "position": {
              "basis": "20px",
              "grow": 1,
              "shrink": 0
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Label_0"
            },
            "position": {
              "basis": "130px"
            },
            "props": {
              "style": {
                "classes": "text-subtitle-widget",
                "textAlign": "center"
              },
              "text": "Run Time:"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Label_Spacer_1"
            },
            "position": {
              "basis": "20px",
              "shrink": 0
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Label_2"
            },
            "position": {
              "basis": "100px"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "if(round(runScript(\u0027mes_core.misc.secondsToMinutes\u0027,1, {view.params.runTime})) \u003c 0,0,round(runScript(\u0027mes_core.misc.secondsToMinutes\u0027,1, {view.params.runTime}))) + \" min\""
                  },
                  "transforms": [
                    {
                      "code": "\ttry:\n\t\treturn value\n\texcept: \n\t\treturn None\n\t\t",
                      "type": "script"
                    }
                  ],
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "text-description-centered",
                "textAlign": "center"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Label_Spacer_2"
            },
            "position": {
              "basis": "20px",
              "grow": 1,
              "shrink": 0
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "FlexContainer"
        },
        "position": {
          "basis": "30px",
          "shrink": 0
        },
        "props": {
          "justify": "center"
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "name": "Label_Spacer_0"
            },
            "position": {
              "basis": "20px",
              "grow": 1,
              "shrink": 0
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Label_0"
            },
            "position": {
              "basis": "130px"
            },
            "props": {
              "style": {
                "classes": "text-subtitle-widget",
                "textAlign": "center"
              },
              "text": "Total Time:"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Label_Spacer_1"
            },
            "position": {
              "basis": "20px",
              "shrink": 0
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Label_2"
            },
            "position": {
              "basis": "100px"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "round(runScript(\u0027mes_core.misc.secondsToMinutes\u0027,1, {view.params.scheduledTime})) + \" min\"\r\n\r\n"
                  },
                  "transforms": [
                    {
                      "code": "\ttry:\n\t\treturn value\n\texcept:\n\t\treturn None",
                      "type": "script"
                    }
                  ],
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "text-description-centered",
                "textAlign": "center"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Label_Spacer_3"
            },
            "position": {
              "basis": "20px",
              "grow": 1,
              "shrink": 0
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "FlexContainer_0"
        },
        "position": {
          "basis": "30px",
          "shrink": 0
        },
        "props": {
          "justify": "center"
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "spacer_0"
        },
        "position": {
          "basis": "30px",
          "shrink": 0
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "borderStyle": "solid",
        "borderWidth": 1,
        "classes": "container-borders-dautom-widget-2",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}
    "params.lineEventsForTypesData": {
      "binding": {
        "config": {
          "path": "view.params.selection"
        },
        "enabled": false,
        "transforms": [
          {
            "code": "\t\n\treasonType\u003d value[0][\u0027Name\u0027]\n\t\n\tquery \u003d \"\"\"\n\tSELECT \n\t    sh.ReasonName,\n\t    COUNT(*) AS time\n\tFROM statehistory sh\n\tJOIN statereason sr\n\t    ON sh.ReasonName \u003d sr.ReasonName\n\tWHERE sh.StartDateTime \u003e\u003d ?\n\t  AND sh.EndDateTime \u003c\u003d ?\n\t  AND CASE \n\t        WHEN sh.ReasonName \u003d \u0027Running\u0027 THEN \u0027Corriendo\u0027\n\t        WHEN sr.PlannedDowntime \u003d 1 THEN \u0027Planeado\u0027\n\t        ELSE \u0027No Planeado\u0027\n\t      END \u003d ?\n\tGROUP BY sh.ReasonName;\n\t\"\"\"\n\t\n\t# Ejecutar query con parámetros\n\tresults \u003d system.db.runPrepQuery(query, [self.view.params.startTime, self.view.params.endTime, reasonType])\n\t\n\t# Convertir PyDataset a lista de diccionarios dinámicamente\n\toutput \u003d []\n\tfor row in results:\n\t    output.append({\n\t        \"Name\": row[\"ReasonName\"],\n\t        \"time\": row[\"time\"]\n\t    })\n\t\n\treturn output",
            "type": "script"
          },
          {
            "code": "\ttry:\n\t\treturn value\n\texcept:\n\t\treturn None",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "paramDirection": "input",
      "persistent": true
    },
    "params.lineId": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.reasonsQuery": {
      "binding": {
        "config": {
          "path": "view.params.startTime"
        },
        "enabled": false,
        "transforms": [
          {
            "code": "\t\n\tquery \u003d \"\"\"\n\tSELECT \n\t    CASE \n\t        WHEN sh.ReasonName \u003d \u0027Running\u0027 THEN \u0027Corriendo\u0027\n\t        WHEN sr.PlannedDowntime \u003d 1 THEN \u0027Planeado\u0027\n\t        ELSE \u0027No Planeado\u0027\n\t    END AS ReasonType,\n\t    COUNT(*) AS time\n\tFROM statehistory sh\n\tJOIN statereason sr\n\t    ON sh.ReasonName \u003d sr.ReasonName\n\tWHERE sh.StartDateTime \u003e\u003d ?\n\t  AND sh.EndDateTime \u003c\u003d ?\n\tGROUP BY \n\t    CASE \n\t        WHEN sh.ReasonName \u003d \u0027Running\u0027 THEN \u0027Corriendo\u0027\n\t        WHEN sr.PlannedDowntime \u003d 1 THEN \u0027Planeado\u0027\n\t        ELSE \u0027No Planeado\u0027\n\t    END;\n\t\"\"\"\n\t\n\t# Ejecutar query con parámetros\n\tresults \u003d system.db.runPrepQuery(query, [value, self.view.params.endTime])\n\t\n\t# Convertir PyDataset a lista de diccionarios dinámicamente\n\toutput \u003d []\n\tfor row in results:\n\t    output.append({\n\t        \"Name\": row[\"ReasonType\"],\n\t        \"time\": row[\"time\"]\n\t    })\n\t\n\treturn output",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "paramDirection": "inout",
      "persistent": true
    },
    "params.selection": {
      "binding": {

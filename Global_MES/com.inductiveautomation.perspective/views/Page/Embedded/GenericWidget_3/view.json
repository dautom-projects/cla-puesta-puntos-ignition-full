{
  "custom": {},
  "params": {
    "alignVertical": "center",
    "contend": "",
    "textAlign": "center",
    "title": "value"
  },
  "propConfig": {
    "params.alignVertical": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.contend": {
      "binding": {
        "config": {
          "path": "/root/FlexContainer_general/TextArea.props.text"
        },
        "type": "property"
      },
      "paramDirection": "inout",
      "persistent": true
    },
    "params.textAlign": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.title": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 470
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Label_title"
            },
            "position": {
              "basis": "50px"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.title"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "text-titles-2"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "TextArea"
            },
            "position": {
              "basis": "100%",
              "grow": 1
            },
            "props": {
              "placeholder": "Nuevo comentario",
              "style": {
                "borderBottomLeftRadius": 10,
                "borderBottomRightRadius": 10,
                "borderStyle": "none",
                "fontFamily": "Arial"
              }
            },
            "type": "ia.input.text-area"
          }
        ],
        "meta": {
          "name": "FlexContainer_general"
        },
        "position": {
          "basis": "100%"
        },
        "props": {
          "direction": "column",
          "style": {
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "borderStyle": "none",
        "classes": "container-borders-dautom-widget",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }

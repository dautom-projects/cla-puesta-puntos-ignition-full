{
  "custom": {},
  "params": {
    "alignVertical": "center",
    "contend": null,
    "maxDate": "",
    "minDate": "",
    "textAlign": "center",
    "title": "value"
  },
  "propConfig": {
    "params.alignVertical": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.contend": {
      "binding": {
        "config": {
          "path": "/root/FlexContainer_general/FlexContainer/DateTimeInputCorte.props.formattedValue"
        },
        "type": "property"
      },
      "paramDirection": "inout",
      "persistent": true
    },
    "params.maxDate": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.minDate": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.textAlign": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.title": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 470
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Label_title"
            },
            "position": {
              "basis": "50px"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.title"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "text-titles-2"
              }
            },
            "type": "ia.display.label"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "spacer"
                },
                "position": {
                  "basis": "50px"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "DateTimeInputCorte"
                },
                "position": {
                  "basis": "100%"
                },
                "propConfig": {
                  "props.maxDate": {
                    "binding": {
                      "config": {
                        "expression": "{view.params.maxDate}"
                      },
                      "enabled": false,
                      "transforms": [
                        {
                          "code": "\n\n    # Suponiendo que \u0027value\u0027 es tu string de fecha y hora, por ejemplo: \u00272023-12-13 08:30:00\u0027\n\tfecha_string \u003d value[:19]\n\n    # Dividir el string en componentes\n\tyear, month, day \u003d map(int, fecha_string[:10].split(\u0027-\u0027))\n\thour, minute, second \u003d map(int, fecha_string[11:].split(\u0027:\u0027))\n\n    # Utilizar las funciones de fecha y hora de Ignition\n\tdate \u003d system.date.getDate(year, month-1, day)\n\tdatetime \u003d system.date.setTime(date, hour, minute, second)\n\n\treturn datetime",
                          "type": "script"
                        }
                      ],
                      "type": "expr"
                    }
                  },
                  "props.minDate": {
                    "binding": {
                      "config": {
                        "expression": "{view.params.minDate}\r\n"
                      },
                      "enabled": false,
                      "transforms": [
                        {
                          "code": "\n\n    # Suponiendo que \u0027value\u0027 es tu string de fecha y hora, por ejemplo: \u00272023-12-13 08:30:00\u0027\n\tfecha_string \u003d value[:19]\n\n    # Dividir el string en componentes\n\tyear, month, day \u003d map(int, fecha_string[:10].split(\u0027-\u0027))\n\thour, minute, second \u003d map(int, fecha_string[11:].split(\u0027:\u0027))\n\n    # Utilizar las funciones de fecha y hora de Ignition\n\tdate \u003d system.date.getDate(year, month-1, day)\n\tdatetime \u003d system.date.setTime(date, hour, minute, second)\n\n\treturn datetime",
                          "type": "script"
                        }
                      ],
                      "type": "expr"
                    }
                  },
                  "props.value": {
                    "binding": {
                      "config": {
                        "path": "view.params.minDate"
                      },
                      "transforms": [
                        {
                          "code": "\tfecha \u003d system.date.parse(value, \"yyyy-MM-dd HH:mm:ss\")\n\treturn fecha",
                          "type": "script"
                        }
                      ],
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "format": "YYYY-MM-DD HH:mm:ss",
                  "formattedValue": null,
                  "inputProps": {
                    "style": {
                      "borderStyle": "none",
                      "color": "var(--neutral-80)",
                      "fontFamily": "Arial",
                      "fontSize": "15.5px"
                    }
                  },
                  "locale": "es",
                  "maxDate": "",
                  "minDate": "",
                  "style": {
                    "borderStyle": "none",
                    "classes": "datetime",
                    "margin": 1
                  }
                },
                "type": "ia.input.date-time-input"
              },
              {
                "meta": {
                  "name": "spacer_1"
                },
                "position": {
                  "basis": "50px"
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "name": "FlexContainer"
            },
            "position": {
              "basis": "200px"
            },
            "props": {
              "justify": "center",
              "style": {
                "padding": 10
              }
            },
            "type": "ia.container.flex"
          }
        ],
        "meta": {
          "name": "FlexContainer_general"
        },
        "position": {
          "basis": "100%"
        },
        "props": {
          "direction": "column",
          "style": {
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "borderStyle": "none",
        "classes": "container-borders-dautom-widget",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}
        "transforms": [
          {
            "code": "\t\n\tequipmentId \u003d self.view.params.equipmentId\n\ttypeId \u003d self.getChild(\"root\").getChild(\"FlexContainer_pies\").getChild(\"FlexContainer_pieTypesOfEvent\").getChild(\"PieChart\").custom.selectId\n\tstartDate \u003d self.view.params.startTime\n\tendDate \u003d self.view.params.endTime\n\tdbConnection \u003d self.view.params.dbConection\n\tlineId \u003d self.params.lineId\n\tdata \u003d value\n\t\n\tif data.getRowCount() \u003d\u003d 0:\n\t\t\n\t\tnamedQueryPath \u003d \"MYSQL/getLineEquipmentDowntimeEventsDurationTop5NullCase\" # use named query specific to the database type used for OEE data\n\t\tqueryParams \u003d {\u0027lineId\u0027:lineId, \u0027equipmentId\u0027:equipmentId, \u0027startDate\u0027:startDate, \u0027endDate\u0027:endDate, \u0027database\u0027:dbConnection, \u0027typeId\u0027:typeId}\n\t\tdata \u003d system.db.runNamedQuery(namedQueryPath, queryParams)\n\t\t\n\t\tif data.getRowCount() \u003d\u003d 0:\n\t\t\n\t\t\t\theaders \u003d [\"description\" , \"down_mins\"]\n\t\t\t\trow \u003d []\t\t\n\t\t\t\trow.append([\u0027Sin eventos\u0027,0])\n\t\t\t\tdata \u003d system.dataset.toDataSet(headers,row)\n\treturn data\n",
            "type": "script"
          }
        ],

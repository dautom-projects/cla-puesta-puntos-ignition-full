{
  "custom": {},
  "params": {
    "icon": "home",
    "text": "Home",
    "transform": "value"
  },
  "propConfig": {
    "params.icon": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.text": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.transform": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 50,
      "width": 600
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Icon"
        },
        "position": {
          "basis": "40px",
          "shrink": 0
        },
        "propConfig": {
          "props.path": {
            "binding": {
              "config": {
                "expression": " {view.params.icon}"
              },
              "type": "expr"
            },
            "persistent": false
          },
          "props.style.transform": {
            "binding": {
              "config": {
                "path": "view.params.transform"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "color": "#000000",
          "style": {
            "classes": "Title/Icon",
            "marginLeft": "10px"
          }
        },
        "type": "ia.display.icon"
      },
      {
        "meta": {
          "hasDelegate": true,
          "name": "Label"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.text"
              },
              "type": "property"
            },
            "persistent": false
          }
        },
        "props": {
          "style": {
            "classes": "text-titles",
            "color": "#000000",
            "fontSize": 25,
            "fontWeight": "bold",
            "textAlign": "left"
          },
          "textStyle": {
            "textIndent": "10px"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "style": {
        "backgroundColor": "#D9D9D9",
        "borderBottomLeftRadius": 0,
        "borderBottomRightRadius": 0,
        "borderTopLeftRadius": 0,
        "borderTopRightRadius": 0,
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}
        "transforms": [
          {
            "code": "\ttry:\n\t\t\"\"\"\n\t\tReturn statehistory events that overlap a given range, clipped to that range.\n\t\n\t\tColor:\n\t\t  - \u0027#6ABCE2\u0027 if ReasonCode \u003d 1001 (highest priority).\n\t\t  - \u0027#FF8A8A\u0027 if RecordDowntime \u003d 1 in statereason.\n\t\t  - \u0027#FFFF8A\u0027 if PlannedDowntime \u003d 1 (and RecordDowntime !\u003d 1).\n\t\t  - \u0027#8AFF8A\u0027 if both \u003d 0.\n\t\n\t\tInputs:\n\t\t\tvalue[\"dbConnection\"] (str)\n\t\t\tvalue[\"startDateTime\"] (datetime)\n\t\t\tvalue[\"endDateTime\"] (datetime)\n\t\t\tvalue[\"nodeID\"] (int or str)\n\t\n\t\tReturns:\n\t\t\tDataset: [itemId, ID, startDate, endDate, label, color, opacity]\n\t\t\"\"\"\n\t\t# Initialization of variables\n\t\tdb \u003d value[\"dbConnection\"]\n\t\tstartDateTime \u003d value[\"startDateTime\"]\n\t\tendDateTime \u003d value[\"endDateTime\"]\n\t\tnodeID \u003d value[\"nodeID\"]\n\t\tstateHistoryTable \u003d mes_core.model.statehistoryTable(db)\n\t\n\t\tcolumns \u003d [\n\t\t\t\"NodeID AS itemId\",\n\t\t\t\"ID\",\n\t\t\t# start clipped to range start\n\t\t\t\"CASE WHEN StartDateTime \u003c ? THEN ? ELSE StartDateTime END AS startDate\",\n\t\t\t# end clipped to range end (considering open-ended)\n\t\t\t(\n\t\t\t\t\"CASE WHEN COALESCE(EndDateTime, GETDATE()) \u003e ? THEN ? \"\n\t\t\t\t\"ELSE COALESCE(EndDateTime, GETDATE()) END AS endDate\"\n\t\t\t),\n\t\t\t\"ReasonName AS label\",\n\t\t\t# color: priority 1001 \u003e RecordDowntime \u003e PlannedDowntime \u003e green\n\t\t\t(\n\t\t\t\t\"CASE \"\n\t\t\t\t\" WHEN ReasonCode \u003d 1001 THEN \u0027#6ABCE2\u0027 \"\n\t\t\t\t\" WHEN EXISTS (SELECT 1 FROM statereason sr \"\n\t\t\t\t\"               WHERE sr.ID \u003d statehistory.StateReasonID \"\n\t\t\t\t\"                 AND sr.RecordDowntime \u003d 1) THEN \u0027#FF8A8A\u0027 \"\n\t\t\t\t\" WHEN EXISTS (SELECT 1 FROM statereason sr \"\n\t\t\t\t\"               WHERE sr.ID \u003d statehistory.StateReasonID \"\n\t\t\t\t\"                 AND sr.PlannedDowntime \u003d 1) THEN \u0027#FFFF8A\u0027 \"\n\t\t\t\t\" ELSE \u0027#8AFF8A\u0027 \"\n\t\t\t\t\"END AS color\"\n\t\t\t),\n\t\t\t\"0.5 AS opacity\"\n\t\t]\n\t\n\t\t# Overlap: [Start, End] with [startDateTime, endDateTime]\n\t\twhere_clause \u003d (\n\t\t\t\"StartDateTime \u003c ? \"\n\t\t\t\"AND COALESCE(EndDateTime, GETDATE()) \u003e ? \"\n\t\t\t\"AND NodeID \u003d ?\"\n\t\t)\n\t\n\t\t# Parameter order:\n\t\t# 1-2: CASE startDate\n\t\t# 3-4: CASE endDate\n\t\t# 5-6: WHERE overlap\n\t\t# 7: NodeID filter\n\t\twhere_args \u003d [\n\t\t\tstartDateTime, startDateTime,\n\t\t\tendDateTime,   endDateTime,\n\t\t\tendDateTime,   startDateTime,\n\t\t\tnodeID\n\t\t]\n\t\n\t\tds \u003d stateHistoryTable.selectCustom(columns\u003dcolumns, where_clause\u003dwhere_clause, where_args\u003dwhere_args)\n\t\treturn ds\n\t\n\texcept:\n\t\timport system\n\t\treturn system.dataset.toDataSet([\u0027itemId\u0027,\u0027ID\u0027,\u0027startDate\u0027,\u0027endDate\u0027,\u0027label\u0027,\u0027color\u0027,\u0027opacity\u0027], [])",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },

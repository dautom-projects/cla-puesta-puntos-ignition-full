            "onChange": {
              "enabled": null,
              "script": "\tif self.session.custom.adminPermissions:\n\t\tnested_data \u003d treeScriptingMES.tree_data\n\telse:\n\t\tnested_data \u003d treeScriptingMES.tree_data_op\n\t\t\n\ttarget_data \u003d self.custom.currentViewURL\n\t\n\tpath \u003d treeScriptingMES.propagateTree(nested_data, target_data)\n\t\n\tself.custom.currentViewPath \u003d str(path)\n\n\tself.props.items \u003d nested_data"
            }
          },
          "custom.urlViewSelected": {
            "binding": {
              "config": {
                "path": "this.props.selectionData[0].value.url"
              },
              "transforms": [
                {
                  "code": "\tif value \u003d\u003d None:\n\t\treturn \"0\"\n\treturn value",
                  "type": "script"
                }

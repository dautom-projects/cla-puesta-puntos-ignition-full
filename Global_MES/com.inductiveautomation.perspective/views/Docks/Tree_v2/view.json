        "scripts": {
          "customMethods": [
            {
              "name": "createTree",
              "params": [],
              "script": "\t# create Navigation Tree\n\ttree_data \u003d []\n\t\n\tsites \u003d [\"Site1\", \"Site2\", \"Site3\"]\n\tareas \u003d [\"Area1\", \"Area2\", \"Area3\"]\n\tdevices \u003d [\"Device1\", \"Device2\", \"Device3\"]\n\t\n\tfor site in sites:\n\t    site_node \u003d {\"label\": site, \"children\": []}\n\t\n\t    for area in areas:\n\t        area_node \u003d {\"label\": area, \"children\": []}\n\t\n\t        for device in devices:\n\t            device_node \u003d {\"label\": device}\n\t            area_node[\"children\"].append(device_node)\n\t\n\t        site_node[\"children\"].append(area_node)\n\t\n\t    tree_data.append(site_node)\n\t\n\treturn tree_data"
            },
            {
              "name": "searchInTree",
              "params": [
                "nested_data",
                "target_data"
              ],
              "script": "\t# Search path in tree\n\tif isinstance(nested_data, list):\n\t    for item in nested_data:\n\t        result \u003d searchTree(item, target_data)\n\t        if result:\n\t            return result\n\telif isinstance(nested_data, dict):\n\t    if nested_data.get(\"url\") \u003d\u003d target_data:\n\t        return nested_data.get(\"path\")\n\t    for key in nested_data:\n\t        result \u003d searchTree(nested_data[key], target_data)\n\t        if result:\n\t            return result"
            },
            {
              "name": "propagateTree",
              "params": [
                "nested_data",
                "target_data",
                "within_target_branch\u003dFalse"
              ],
              "script": "\t# It searchs for url \u003d \"target_data\" in a json\n\t# Returns the path instance related and modifies the expanded property in the branch for True\n\tif isinstance(nested_data, list):\n\t    found_path \u003d None\n\t    for i, item in enumerate(nested_data):\n\t        path \u003d propagateTree(item, target_data, within_target_branch)\n\t        if path:\n\t            if \"expanded\" in item:\n\t                item[\"expanded\"] \u003d True\n\t            found_path \u003d path\n\t        else:\n\t            if isinstance(item, dict) and \"expanded\" in item:\n\t                item[\"expanded\"] \u003d False\n\t    return found_path\n\telif isinstance(nested_data, dict):\n\t    if nested_data.get(\"url\") \u003d\u003d target_data:\n\t        if \"expanded\" in nested_data:\n\t            nested_data[\"expanded\"] \u003d True\n\t        within_target_branch \u003d True\n\t        return nested_data.get(\"path\")\n\t    found_path \u003d None\n\t    for key, value in nested_data.items():\n\t        path \u003d propagateTree(value, target_data, within_target_branch)\n\t        if path:\n\t            if \"expanded\" in nested_data:\n\t                nested_data[\"expanded\"] \u003d True\n\t            found_path \u003d path\n\t        elif not within_target_branch:\n\t            if isinstance(value, dict) and \"expanded\" in value:\n\t                value[\"expanded\"] \u003d False\n\t    return found_path\n\treturn None"
            }
          ],
          "extensionFunctions": null,
          "messageHandlers": []
        },
        "type": "ia.display.tree"
      }
    ],
    "meta": {
      "name": "root"
    },
    "propConfig": {
      "props.style.backgroundColor": {
        "binding": {

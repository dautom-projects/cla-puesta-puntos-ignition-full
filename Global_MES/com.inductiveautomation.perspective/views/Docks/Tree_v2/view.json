            "path": "session.props.theme"
          },
          "enabled": false,
          "transforms": [
            {
              "fallback": null,
              "inputType": "scalar",
              "mappings": [
                {
                  "input": "cla-light",
                  "output": "--neutral-30"
                },
                {
                  "input": "cla-dark",
                  "output": "--cla-header"
                }
              ],
              "outputType": "scalar",
              "type": "map"
            },
            {
              "code": "\ttry:\n\t\treturn value\n\texcept:\n\t\treturn None",
              "type": "script"
            }
          ],
          "type": "property"
        }

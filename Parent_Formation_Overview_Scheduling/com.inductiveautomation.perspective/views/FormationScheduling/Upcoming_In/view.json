                    "script": "\tsystem.perspective.print(\"Button pressed for side 2.\")\n\tsystem.perspective.print( \"Current selected row \u003d \" + str(self.getSibling(\"Table_0\").props.selection.selectedRow))\n\tif self.getSibling(\"Table_0\").props.selection.selectedRow \u003e -1:\n\t\teventID \u003d self.getSibling(\"Table_0\").props.selection.data[0].rowID\n\t\tlocked  \u003d not self.getSibling(\"Table_0\").props.selection.data[0].Locked\n\t\tparams \u003d {\"eventID\": eventID,\"locked\": locked}\n\t\tsystem.db.runNamedQuery(\"FormationScheduling/updateScheduleLocked\", params) # Run the Named Query\n\t\tself.getSibling(\"Table_0\").props.selection.selectedRow \u003d None \n\t\tsystem.perspective.print(\"Updated locked\")\n\telse:\n\t\tsystem.perspective.print(\"Try again for locking event\")\n\t\t\n\t#self.refreshBinding(str(self.getSibling(\"Table_0\").props.data))\n\tsystem.perspective.sendMessage(\"refresh\", {}, \"session\")"
                  },

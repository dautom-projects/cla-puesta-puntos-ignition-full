    "custom.db_reasons": {
      "binding": {
        "config": {
          "struct": {
            "dbConnection": "{view.custom.dbConnection}",
            "endDateTime": "{view.custom.endDate}",
            "nodeID": "{view.custom.nodeID}",
            "startDateTime": "{view.custom.startDate}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\t\"\"\"\n\tReturn statehistory events that overlap a given range, clipped to that range.\n\t\n\tColor logic:\n\t  - \u0027#6ABCE2\u0027 if ReasonCode \u003d 1001 (highest priority)\n\t  - \u0027#FF8A8A\u0027 if RecordDowntime \u003d 1 in statereason\n\t  - \u0027#FFFF8A\u0027 if PlannedDowntime \u003d 1 (and RecordDowntime !\u003d 1)\n\t  - \u0027#8AFF8A\u0027 if both \u003d 0\n\t\n\tArgs:\n\t\tvalue (dict): Contains dbConnection, startDateTime, endDateTime, nodeID\n\t\n\tReturns:\n\t\tDataset: [itemId, ID, startDate, endDate, label, color, opacity]\n\t\tEmpty dataset on error\n\t\"\"\"\n\t\n\tlogger \u003d system.util.getLogger(\"dautom.mescore.dashboardLine.views.main.dbReasons\")\n\t\n\ttry:\n\t\t# Initialize variables\n\t\tdb \u003d value[\"dbConnection\"]\n\t\tstartDateTime \u003d value[\"startDateTime\"]\n\t\tendDateTime \u003d value[\"endDateTime\"]\n\t\tnodeID \u003d value[\"nodeID\"]\n\t\tstateHistoryTable \u003d mes_core.model.statehistoryTable(db)\n\t\t\n\t\t# Define columns with clipped dates and color logic\n\t\tcolumns \u003d [\n\t\t\t\"NodeID AS itemId\",\n\t\t\t\"ID\",\n\t\t\t\"CASE WHEN StartDateTime \u003c ? THEN ? ELSE StartDateTime END AS startDate\",\n\t\t\t(\n\t\t\t\t\"CASE WHEN COALESCE(EndDateTime, GETDATE()) \u003e ? THEN ? \"\n\t\t\t\t\"ELSE COALESCE(EndDateTime, GETDATE()) END AS endDate\"\n\t\t\t),\n\t\t\t\"ReasonName AS label\",\n\t\t\t(\n\t\t\t\t\"CASE \"\n\t\t\t\t\"WHEN ReasonCode \u003d 1001 THEN \u0027#6ABCE2\u0027 \"\n\t\t\t\t\"WHEN EXISTS (SELECT 1 FROM statereason sr \"\n\t\t\t\t\"             WHERE sr.ID \u003d statehistory.StateReasonID \"\n\t\t\t\t\"               AND sr.RecordDowntime \u003d 1) THEN \u0027#FF8A8A\u0027 \"\n\t\t\t\t\"WHEN EXISTS (SELECT 1 FROM statereason sr \"\n\t\t\t\t\"             WHERE sr.ID \u003d statehistory.StateReasonID \"\n\t\t\t\t\"               AND sr.PlannedDowntime \u003d 1) THEN \u0027#FFFF8A\u0027 \"\n\t\t\t\t\"ELSE \u0027#8AFF8A\u0027 \"\n\t\t\t\t\"END AS color\"\n\t\t\t),\n\t\t\t\"0.5 AS opacity\"\n\t\t]\n\t\t\n\t\t# Filter overlapping events within date range\n\t\twhere_clause \u003d (\n\t\t\t\"StartDateTime \u003c ? \"\n\t\t\t\"AND COALESCE(EndDateTime, GETDATE()) \u003e ? \"\n\t\t\t\"AND NodeID \u003d ?\"\n\t\t)\n\t\t\n\t\t# Parameters: startDate CASE (2), endDate CASE (2), WHERE overlap (2), NodeID (1)\n\t\twhere_args \u003d [\n\t\t\tstartDateTime, startDateTime,\n\t\t\tendDateTime, endDateTime,\n\t\t\tendDateTime, startDateTime,\n\t\t\tnodeID\n\t\t]\n\t\t\n\t\t# Execute query\n\t\tds \u003d stateHistoryTable.selectCustom(columns\u003dcolumns, where_clause\u003dwhere_clause, where_args\u003dwhere_args)\n\t\t\n\t\tlogger.info(\"Retrieved \" + str(ds.rowCount) + \" state history events for NodeID: \" + str(nodeID))\n\t\t\n\t\treturn ds\n\t\n\texcept Exception as e:\n\t\tlogger.error(\"Error retrieving state history events: \" + str(e))\n\t\treturn system.dataset.toDataSet([\u0027itemId\u0027, \u0027ID\u0027, \u0027startDate\u0027, \u0027endDate\u0027, \u0027label\u0027, \u0027color\u0027, \u0027opacity\u0027], [])",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },

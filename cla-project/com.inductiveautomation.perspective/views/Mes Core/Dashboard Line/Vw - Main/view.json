          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\n\t\"\"\"\n\tRetrieve the topic name for a given node.\n\t\n\tArgs:\n\t\tself: Transform context\n\t\tvalue (dict): Contains nodeID and db\n\t\tquality: Tag quality\n\t\ttimestamp: Tag timestamp\n\t\n\tReturns:\n\t\tstr: Topic name from node table\n\t\tNone on error\n\t\"\"\"\n\t\n\tlogger \u003d system.util.getLogger(\"dautom.mescore.dashboardLine.views.main.pathTransform\")\n\t\n\ttry:\n\t\t# Initialize variables\n\t\tnodeID \u003d value[\"nodeID\"]\n\t\tdb \u003d value[\"db\"]\n\t\t\n\t\t# Get topic from node table\n\t\ttablenode \u003d mes_core.model.nodeTable(db)\n\t\tcolumns \u003d [\"Topic\"]\n\t\twhere_clause \u003d \"ID \u003d ?\"\n\t\twhere_args \u003d [nodeID]\n\t\tds \u003d tablenode.selectCustom(columns, where_clause, where_args)\n\t\t\n\t\t# Validate data exists\n\t\tif ds.rowCount \u003d\u003d 0:\n\t\t\tlogger.warn(\"No topic found for NodeID: \" + str(nodeID))\n\t\t\treturn None\n\t\t\n\t\ttopic \u003d ds.getValueAt(0, 0)\n\t\t\n\t\t#logger.info(\"Retrieved topic for NodeID: \" + str(nodeID))\n\t\t\n\t\treturn topic\n\t\n\texcept Exception as e:\n\t\tlogger.error(\"Error retrieving topic: \" + str(e))\n\t\treturn None",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },

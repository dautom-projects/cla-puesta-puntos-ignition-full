    "custom.oee.actualRun.dataset": {
      "binding": {
        "config": {
          "struct": {
            "dbConnection": "{view.custom.dbConnection}",
            "nodeID": "{view.params.nodeID}",
            "path": "{view.custom.path}",
            "refresh": "if({view.custom.oee.activeRun} \u003d 1,now(10000),0)"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\t\"\"\"\n\tRetrieve active run information for a given node.\n\t\n\tArgs:\n\t\tvalue (dict): Contains dbConnection, nodeID, path, and refresh trigger\n\t\n\tReturns:\n\t\tDataset: Active run data with columns [ID, RunStartDateTime, RunStopDateTime, \n\t\t         Availability, RunTime, TotalTime, OEE, Quality, Performance, EstimatedFinishedTime]\n\t\tEmpty dataset on error\n\t\"\"\"\n\t\n\tlogger \u003d system.util.getLogger(\"dautom.mescore.dashboardLine.views.main.oeeActualRunDataset\")\n\t\n\ttry:\n\t\t# Initialize variables\n\t\tnodeID \u003d int(value[\"nodeID\"])\n\t\tdb \u003d value[\"dbConnection\"]\n\t\tpath \u003d value[\"path\"]\n\t\t\n\t\t# Read current RunID from tags\n\t\trunID \u003d system.tag.readBlocking([path + \u0027/Line/OEE/RunID\u0027])[0].value\n\t\t\n\t\t# Get ScheduleID from schedule table\n\t\ttableSch \u003d mes_core.schedule.scheduleTable(db)\n\t\tcolumnsSch \u003d [\"ID\"]\n\t\twhere_clauseSch \u003d \"NodeID \u003d ? AND RunID \u003d ?\"\n\t\twhere_argsSch \u003d [nodeID, runID]\n\t\tdsSch \u003d tableSch.selectCustom(columns\u003dcolumnsSch, where_clause\u003dwhere_clauseSch, where_args\u003dwhere_argsSch)\n\t\t\n\t\t# Validate schedule data exists\n\t\tif dsSch.rowCount \u003d\u003d 0:\n\t\t\tlogger.warn(\"No schedule found for NodeID: \" + str(nodeID) + \", RunID: \" + str(runID))\n\t\t\treturn system.dataset.toDataSet(\n\t\t\t\t[\"ID\", \"RunStartDateTime\", \"RunStopDateTime\", \"Availability\", \"RunTime\", \"TotalTime\", \"OEE\", \"Quality\", \"Performance\", \"EstimatedFinishedTime\"],\n\t\t\t\t[]\n\t\t\t)\n\t\t\n\t\tschID \u003d dsSch.getValueAt(0, 0)\n\t\t\n\t\t# Get active run data\n\t\ttableRun \u003d mes_core.run.RunTable(db)\n\t\tcolumns \u003d [\"ID\", \"RunStartDateTime\", \"RunStopDateTime\", \"Availability\", \"RunTime\", \"TotalTime\", \"OEE\", \"Quality\", \"Performance\", \"EstimatedFinishedTime\"]\n\t\twhere_clause \u003d \"Closed \u003d ? AND ScheduleID \u003d ?\"\n\t\twhere_args \u003d [0, schID]\n\t\tds \u003d tableRun.selectCustom(columns, where_clause, where_args)\n\t\t\n\t\t#logger.info(\"Retrieved run data for NodeID: \" + str(nodeID) + \", ScheduleID: \" + str(schID))\n\t\t\n\t\treturn ds\n\t\n\texcept Exception as e:\n\t\tlogger.error(\"Error retrieving run data: \" + str(e))\n\t\treturn system.dataset.toDataSet(\n\t\t\t[\"ID\", \"RunStartDateTime\", \"RunStopDateTime\", \"Availability\", \"RunTime\", \"TotalTime\", \"OEE\", \"Quality\", \"Performance\", \"EstimatedFinishedTime\"],\n\t\t\t[]\n\t\t)",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },

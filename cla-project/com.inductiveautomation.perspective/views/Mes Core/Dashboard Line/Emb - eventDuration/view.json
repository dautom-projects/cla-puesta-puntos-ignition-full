    "custom.actualRun.dsDurationEvents": {
      "binding": {
        "config": {
          "struct": {
            "dbConnection": "{view.custom.dbConnection}",
            "endDateTime": "{view.custom.actualRun.endDateTime}",
            "nodeID": "{view.params.nodeID}",
            "refresh": "if({view.params.activeRun} \u003d 1, now(10000),0)",
            "runID": "{view.custom.actualRun.runID}",
            "startDateTime": "{view.custom.actualRun.startDateTime}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\ttry:\n\t\t\"\"\"\n\t\tTop 5 ReasonName por minutos dentro de [startDateTime, endDateTime],\n\t\tusando GETDATE() como fin cuando EndDateTime es NULL (evento abierto).\n\t\n\t\tEntradas en value:\n\t\t- dbConnection (str)\n\t\t- nodeID (int)\n\t\t- startDateTime (datetime)\n\t\t- endDateTime (datetime)\n\t\t- runID (int)\n\t\n\t\tRetorna:\n\t\t- PyDataSet con columnas [ReasonName, total_minutes]\n\t\t\"\"\"\n\t\t\n\t\t# Initialization of variables\n\t\tdb \u003d value[\"dbConnection\"]\n\t\tnodeID \u003d value[\"nodeID\"]\n\t\tstartDateTime \u003d value[\"startDateTime\"]\n\t\tendDateTime \u003d value[\"endDateTime\"]\n\t\trunID \u003d value[\"runID\"]\n\t\n\t\t# Si no aplica (por ejemplo, -1), salir pronto\n\t\tif runID \u003d\u003d -1:\n\t\t\treturn None\n\t\n\t\tstateHistoryTable \u003d mes_core.model.statehistoryTable(db)\n\t\n\t\t# Logic\n\t\t# Recorte de intervalos:\n\t\t#   inicio \u003d MAX(StartDateTime, :startDateTime)\n\t\t#   fin    \u003d MIN(COALESCE(EndDateTime, GETDATE()), :endDateTime)\n\t\t# SOLO se suman filas que se solapan con la ventana:\n\t\t#   StartDateTime \u003c :endDateTime AND COALESCE(EndDateTime, GETDATE()) \u003e :startDateTime\n\t\tcolumns \u003d [\n\t\t\t\"TOP 5 ReasonName\",\n\t\t\t(\n\t\t\t\t\"SUM(DATEDIFF(MINUTE, \"\n\t\t\t\t\"  CASE WHEN StartDateTime \u003e ? THEN StartDateTime ELSE ? END, \"\n\t\t\t\t\"  CASE WHEN COALESCE(EndDateTime, GETDATE()) \u003e ? THEN ? ELSE COALESCE(EndDateTime, GETDATE()) END \"\n\t\t\t\t\")) AS total_minutes\"\n\t\t\t)\n\t\t]\n\t\n\t\twhere_clause \u003d (\n\t\t\t\"NodeID \u003d ? \"\n\t\t\t\"AND RunID \u003d ? \"\n\t\t\t\"AND ReasonCode NOT IN (3,4)\"\n\t\t\t\"AND StartDateTime \u003c ? \"\n\t\t\t\"AND COALESCE(EndDateTime, GETDATE()) \u003e ? \"\n\t\t\t\"GROUP BY ReasonName \"\n\t\t\t\"ORDER BY total_minutes DESC\"\n\t\t)\n\t\n\t\t# Orden de parámetros:\n\t\t# 1-2: CASE inicio (StartDateTime \u003e ? THEN StartDateTime ELSE ?)\n\t\t# 3-4: CASE fin    (COALESCE(EndDateTime, GETDATE()) \u003e ? THEN ? ELSE COALESCE(...))\n\t\t# 5-6-7-8: WHERE (NodeID, RunID, endDateTime, startDateTime)\n\t\twhere_args \u003d [\n\t\t\tstartDateTime, startDateTime,\n\t\t\tendDateTime,   endDateTime,\n\t\t\tnodeID, runID,\n\t\t\tendDateTime, startDateTime\n\t\t]\n\t\n\t\tds \u003d stateHistoryTable.selectCustom(columns, where_clause, where_args)\n\t\n\t\t# Return\n\t\treturn ds\n\t\n\texcept:\n\t\t# Return (dataset vacío en falla)\n\t\timport system\n\t\treturn system.dataset.toDataSet([\u0027ReasonName\u0027, \u0027total_minutes\u0027], [])",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "custom.actualRun.endDateTime": {
      "binding": {
        "config": {
          "struct": {
            "dataset": "{view.custom.actualRun.dataset}",
            "runID": "{view.custom.actualRun.runID}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\trunID \u003d value[\"runID\"]\n\t#value \u003d ds.getValueAt(0,2)\n\tif runID \u003d\u003d -1:\n\t\treturn None\n\tvalue \u003d system.date.now()\n\treturn value",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "custom.actualRun.runID": {
      "binding": {
        "config": {
          "struct": {
            "dataset": "{view.custom.actualRun.dataset}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\tds \u003d value[\"dataset\"]\n\tif ds !\u003d -1:\t\t\n\t\tvalue \u003d ds.getValueAt(0,0)\n\t\treturn value\n\telse:\n\t\treturn -1",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "custom.actualRun.startDateTime": {
      "binding": {
        "config": {
          "struct": {
            "dataset": "{view.custom.actualRun.dataset}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\tds \u003d value[\"dataset\"]\n\tif ds !\u003d -1:\t\t\n\t\tvalue \u003d ds.getValueAt(0,1)\n\t\treturn value\n\telse:\n\t\treturn None",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "custom.currentEventType": {
      "binding": {
        "config": {
          "struct": {
            "dbConnection": "{view.custom.dbConnection}",
            "nodeId": "{view.params.nodeID}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\ttry:\n\t\t\"\"\"\n\t\tResolve current event type for an open statehistory event on a node using statereason flags\n\t\t(RecordDowntime / PlannedDowntime), without relying on ReasonCode.\n\t\n\t\tInputs (from value):\n\t\t\tvalue[\"nodeId\"] (int)\n\t\t\tvalue[\"dbConnection\"] (str)\n\t\n\t\tUI context:\n\t\t\tself.custom.currentReason may be \"Produciendo\" / \"Lista para producir\"\n\t\n\t\tReturns:\n\t\t\tstr: \"Corriendo\" | \"Planeado\" | \"No Planeado\"\n\t\t\"\"\"\n\t\t# Initialization of variables\n\t\timport system\n\t\tnodeId \u003d value[\"nodeId\"]\n\t\tdbConnection \u003d value[\"dbConnection\"]\n\t\n\t\t# Short-circuit by currentReason if provided\n\t\ttry:\n\t\t\tcurrentReason \u003d self.custom.currentReason\n\t\texcept:\n\t\t\tcurrentReason \u003d None\n\t\n\t\tif currentReason in (\"Produciendo\", \"Lista para producir\"):\n\t\t\t# Return\n\t\t\treturn \"Corriendo\"\n\t\n\t\t# Logic: fetch flags of the OPEN event (EndDateTime IS NULL) for this node\n\t\t# Use StateReasonID -\u003e statereason.ID join to read flags directly\n\t\tquery \u003d \"\"\"\n\t\t\tSELECT TOP 1\n\t\t\t\tsr.RecordDowntime,\n\t\t\t\tsr.PlannedDowntime,\n\t\t\t\tsh.ReasonName\n\t\t\tFROM statehistory sh\n\t\t\tINNER JOIN statereason sr\n\t\t\t\tON sr.ID \u003d sh.StateReasonID\n\t\t\tWHERE sh.NodeID \u003d ?\n\t\t\t  AND sh.EndDateTime IS NULL\n\t\t\tORDER BY sh.StartDateTime DESC\n\t\t\"\"\"\n\t\trows \u003d system.db.runPrepQuery(query, [nodeId], dbConnection)\n\t\n\t\t# If no open event, assume running\n\t\tif rows is None or rows.getRowCount() \u003d\u003d 0:\n\t\t\t# Return\n\t\t\treturn \"Corriendo\"\n\t\n\t\trecordDowntime \u003d rows.getValueAt(0, \"RecordDowntime\")\n\t\tplannedDowntime \u003d rows.getValueAt(0, \"PlannedDowntime\")\n\t\t# reasonName \u003d rows.getValueAt(0, \"ReasonName\")  # opcional, por si quieres log/depurar\n\t\n\t\t# Decision mapping\n\t\tif int(recordDowntime or 0) \u003d\u003d 1:\n\t\t\t# Return\n\t\t\treturn \"No Planeado\"\n\t\tif int(plannedDowntime or 0) \u003d\u003d 1:\n\t\t\t# Return\n\t\t\treturn \"Planeado\"\n\t\n\t\t# Ambos \u003d 0 → produciendo/corriendo\n\t\t# Return\n\t\treturn \"Corriendo\"\n\t\n\texcept:\n\t\t# Return (fallback seguro)\n\t\treturn \"NA\"",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.currentReason": {
      "binding": {
        "config": {
          "struct": {
            "dbConnection": "{view.custom.dbConnection}",
            "nodeID": "{view.params.nodeID}",
            "runID": "{view.custom.actualRun.runID}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\t\n\tdb \u003d value[\"dbConnection\"]\n\tnodeID \u003d value[\"nodeID\"]\n\t\n\tstateHistoryTable \u003d mes_core.model.statehistoryTable(db)\n\tcolumns \u003d [\n\t\t\"TOP 1 ReasonName\"\n\t]\n\twhere_clause \u003d (\n\t\t\"nodeID \u003d ? \"\n\t\t\"ORDER BY ID DESC\"\n\t)\n\twhere_args \u003d [nodeID]\n\tds \u003d stateHistoryTable.selectCustom(columns, where_clause, where_args)\n\t\n\treason \u003d ds[0][0]\n\t\n\treturn reason",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.currentShift": {
      "binding": {
        "config": {
          "path": "view.custom.now"
        },
        "transforms": [
          {
            "code": "\t# Obtener la fecha base desde el valor del custom property\n\tbaseDate \u003d value\n\t\n\tbegin_shift_A \u003d system.date.setTime(baseDate, 22, 00, 00)\n\tend_shift_A \u003d system.date.setTime(baseDate, 5, 59, 59)\n\t\n\tbegin_shift_B \u003d system.date.setTime(baseDate, 6, 00, 00)\n\tend_shift_B \u003d system.date.setTime(baseDate, 13, 59, 59)\n\t\n\tbegin_shift_C \u003d system.date.setTime(baseDate, 14, 00, 00)\n\tend_shift_C \u003d system.date.setTime(baseDate, 21, 59, 59)\n\t\n\tif system.date.isBetween(baseDate, begin_shift_A, end_shift_A):\n\t\treturn 1\n\telif system.date.isBetween(baseDate, begin_shift_B, end_shift_B):\n\t\treturn 2\n\telif system.date.isBetween(baseDate, begin_shift_C, end_shift_C):\n\t\treturn 3",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },

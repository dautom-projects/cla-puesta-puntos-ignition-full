{
  "custom": {},
  "params": {
    "item": {
      "desc": "desc",
      "uom": "value",
      "value": 10
    }
  },
  "propConfig": {
    "params.item": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 26,
      "width": 157
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "desc"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.item.desc"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "textStyle": {
            "classes": "text-xs text-gray-500"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "value"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.item.value"
              },
              "transforms": [
                {
                  "expression": "if ({value} \u003d \"\",\"\", floor({value}))",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "textStyle": {
            "classes": "text-xs text-gray-500"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "uom"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.item.uom"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "textStyle": {
            "classes": "text-xs text-gray-500"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "style": {
        "backgroundColor": "Transparent",
        "classes": "gap-4",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}
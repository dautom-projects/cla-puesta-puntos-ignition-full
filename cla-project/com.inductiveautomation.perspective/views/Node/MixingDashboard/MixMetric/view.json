{
  "custom": {},
  "params": {
    "actValue": "[uns]VIC/Manufacturing/Electrode Anode/Mixing Anode/ProcessMixing/SlurryPdMixer1/Temperature/Act_Value",
    "metricHistPath": [
      {
        "aggregate": "MinMax",
        "alias": "",
        "path": "[uns]VIC/Manufacturing/Electrode Cathode/Mixing Cathode/ProcessMixing/SlurryPdMixer/Temperature/Act_Value"
      },
      {
        "aggregate": "MinMax",
        "alias": "",
        "path": "[uns]VIC/Manufacturing/Electrode Cathode/Mixing Cathode/ProcessMixing/SlurryPdMixer/Temperature/Set_Value"
      }
    ],
    "metricKey": "value",
    "metricUnit": "value",
    "setValue": "[uns]VIC/Manufacturing/Electrode Anode/Mixing Anode/ProcessMixing/SlurryPdMixer1/Temperature/Set_Value"
  },
  "propConfig": {
    "params.actValue": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.metricHistPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.metricKey": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.metricUnit": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.setValue": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 112,
      "width": 396
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Label"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.metricKey"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "text-sm text-gray-600"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Label_0"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "numberFormat(tag({view.params.actValue}), \"#0.0\") + \" / \" + numberFormat(tag({view.params.setValue}), \"#0.0\")"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "font-semibold"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Label_1"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.metricUnit"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "text-xs text-gray-500"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "id": "trending-drawer",
                "type": "open",
                "viewParams": {
                  "histPath": "{view.params.metricHistPath}",
                  "title": "{view.params.metricKey}"
                }
              },
              "scope": "C",
              "type": "dock"
            }
          }
        },
        "meta": {
          "name": "metrics"
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "flex justify-center p-4 overflow-visible whitespace-nowrap lg:w-21 hover:cursor-pointer"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "TimeSeriesChart"
        },
        "position": {
          "basis": "NaNpx"
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "!isNull({view.params.metricHistPath[0].path})"
              },
              "type": "expr"
            }
          },
          "props.plots[0].trends[0].series": {
            "binding": {
              "config": {
                "path": "view.params.metricKey"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          },
          "props.series[0]": {
            "persistent": true
          },
          "props.series[0].data": {
            "binding": {
              "config": {
                "avoidScanClassValidation": true,
                "dateRange": {
                  "mostRecent": "1",
                  "mostRecentUnits": "HOUR"
                },
                "enableValueCache": true,
                "ignoreBadQuality": false,
                "polling": {
                  "enabled": true,
                  "rate": "60"
                },
                "preventInterpolation": true,
                "returnFormat": "Wide",
                "returnSize": {
                  "type": "RAW"
                },
                "tags": "{view.params.metricHistPath}",
                "valueFormat": "DATASET"
              },
              "overlayOptOut": true,
              "type": "tag-history"
            },
            "persistent": false
          },
          "props.series[0].name": {
            "binding": {
              "config": {
                "path": "view.params.metricKey"
              },
              "overlayOptOut": true,
              "type": "property"
            },
            "persistent": true
          }
        },
        "props": {
          "autoGenerateSeriesNames": true,
          "defaultStyles": {
            "colorScheme": "Accent"
          },
          "plots": [
            {
              "axes": [
                {
                  "alignment": "left",
                  "grid": {
                    "color": "",
                    "dashArray": 0,
                    "opacity": 0.9,
                    "style": {
                      "classes": ""
                    },
                    "visible": false
                  },
                  "label": {
                    "font": {
                      "color": "",
                      "size": 10
                    },
                    "offset": 0,
                    "style": {
                      "classes": ""
                    },
                    "text": "",
                    "visible": true
                  },
                  "max": "",
                  "min": "",
                  "name": "",
                  "style": {
                    "classes": ""
                  },
                  "tick": {
                    "color": "",
                    "count": "Auto",
                    "label": {
                      "font": {
                        "color": "",
                        "size": 10
                      },
                      "format": "Auto",
                      "style": {
                        "classes": ""
                      }
                    },
                    "style": {
                      "classes": ""
                    }
                  },
                  "width": 60
                }
              ],
              "markers": [],
              "relativeWeight": 1,
              "trends": [
                {
                  "axis": "",
                  "baselines": [],
                  "breakLine": true,
                  "columns": [],
                  "interpolation": "curveLinear",
                  "radius": 2,
                  "stack": true,
                  "type": "scatter",
                  "visible": true
                }
              ]
            }
          ],
          "series": [
            {
              "name": "value"
            }
          ],
          "style": {
            "classes": "hidden lg:flex"
          },
          "timeAxis": {
            "visible": false
          },
          "timeRange": {
            "dateFormat": "dd/MM/yyyy",
            "timeFormat": "HH:mm:ss",
            "visible": false
          },
          "xTrace": {
            "infoBox": {
              "dateFormat": "D-M-YYYY",
              "font": {
                "style": {
                  "classes": "text-gray-400"
                }
              },
              "timeFormat": "HH:mm:ss"
            }
          }
        },
        "type": "ia.chart.timeseries"
      }
    ],
    "meta": {
      "name": "root"
    },
    "propConfig": {
      "meta.visible": {
        "binding": {
          "config": {
            "expression": "!isNull({view.params.metricHistPath})"
          },
          "type": "expr"
        }
      }
    },
    "props": {
      "style": {
        "classes": "justify-between hover:ring-inset hover:ring-[--primary-60] hover:ring-2 ",
        "fontFamily": "Inter"
      }
    },
    "type": "ia.container.flex"
  }
}
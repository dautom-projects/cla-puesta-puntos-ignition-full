{
  "custom": {},
  "params": {
    "item": {
      "desc": "desc",
      "uom": "value",
      "value": 10
    }
  },
  "propConfig": {
    "params.item": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 34,
      "width": 129
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "desc"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.item.desc"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "text-xs text-gray-500"
          },
          "textStyle": {
            "classes": "text-sm whitespace-nowrap"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "value"
        },
        "position": {
          "basis": "30%"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "try(\r\n    if({view.params.item.value} + \"\" \u003d \"\", \r\n        \"\", \r\n        numberFormat({view.params.item.value}, \"#0.0\")\r\n    ), \r\n    {view.params.item.value} + \"\"\r\n)"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "classes": "font-semibold"
          },
          "textStyle": {
            "classes": "text-sm whitespace-nowrap text-right"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "uom"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.item.uom"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "text-xs text-gray-500"
          },
          "textStyle": {
            "classes": "text-sm whitespace-nowrap"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "justify": "space-between",
      "style": {
        "classes": "gap-4 bg-transparent",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}
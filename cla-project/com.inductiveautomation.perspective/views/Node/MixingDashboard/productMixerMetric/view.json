{
  "custom": {},
  "params": {
    "item": {
      "desc": "desc",
      "uom": "Kg",
      "value": 121
    }
  },
  "propConfig": {
    "params.item": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 25,
      "width": 149
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "desc"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.item.desc"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "textStyle": {
            "classes": "text-sm font-medium"
          }
        },
        "type": "ia.display.label"
      },
      {
        "children": [
          {
            "meta": {
              "name": "value"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.item.value"
                  },
                  "transforms": [
                    {
                      "expression": "if(isNull({view.params.item.value}), \"-\", floor({view.params.item.value}))",
                      "type": "expression"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "textStyle": {
                "classes": "text-sm text-right font-bold"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "uom"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.item.uom"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "textStyle": {
                "classes": "text-xs text-gray-500"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "FlexContainer"
        },
        "props": {
          "style": {
            "classes": "flex flex-row items-baseline gap-1",
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignContent": "center",
      "alignItems": "flex-start",
      "style": {
        "classes": "flex flex-row flex-wrap items-baseline justify-between gap-1 min-w-[120px]",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }

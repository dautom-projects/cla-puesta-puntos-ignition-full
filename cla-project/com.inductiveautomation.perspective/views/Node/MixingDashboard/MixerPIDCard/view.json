                "propConfig": {
                  "props.params.key": {
                    "binding": {
                      "config": {
                        "expression": "now(800)"
                      },
                      "transforms": [
                        {
                          "code": "\t\"\"\"\n\tTrigger on now(), read tag paths from self.view.params.key,\n\tand return a one-column Dataset of live values.\n\n\tParameters:\n\t\tvalue: bound to now(), ignored.\n\t\tquality: unused.\n\t\ttimestamp: unused.\n\n\tReturns:\n\t\tDataset: one column [\u0027value\u0027], one row per tag.\n\t\"\"\"\n\ttry:\n\t\t# 1. Grab the original params\n\t\tparams \u003d self.view.params.key\n\t\t\n\t\t# 2. Extract paths and keep original order of keys\n\t\tpaths \u003d []\n\t\tkeys \u003d []\n\t\tfor key, info in params.items():\n\t\t    path \u003d info.get(\u0027val\u0027)\n\t\t    if path:\n\t\t        paths.append(path)\n\t\t        keys.append(key)\n\t\tif not paths:\n\t\t\toutput \u003d {\n\t\t\t\t\u0027desc\u0027: \"\",\n\t\t\t\t\u0027uom\u0027: \"\",\n\t\t\t\t\u0027val\u0027: \"\"\n\t\t\t}\n\t\t\treturn output\n\t\n\t\t# 3. Read all tags\n\t\tresults \u003d system.tag.readBlocking(paths)\n\t\t\n\t\t# 4. Rebuild output dict\n\t\toutput \u003d {}\n\t\tfor idx, key in enumerate(keys):\n\t\t\tinfo \u003d params[key]\n\t\t\tres \u003d results[idx]\n\t\t\t# Use quality.isGood() instead of .good\n\t\t\tif hasattr(res, \u0027quality\u0027) and res.quality.isGood():\n\t\t\t\tval \u003d res.value\n\t\t\telse:\n\t\t\t\tval \u003d None\n\t\t\toutput[key] \u003d {\n\t\t\t\t\u0027desc\u0027: info[\u0027desc\u0027],\n\t\t\t\t\u0027uom\u0027: info.get(\u0027uom\u0027, \u0027\u0027),\n\t\t\t\t\u0027val\u0027: val\n\t\t\t}\n\t\treturn output\n\texcept:\n\t\toutput \u003d {\n\t\t\t\t\u0027desc\u0027: \"\",\n\t\t\t\t\u0027uom\u0027: \"\",\n\t\t\t\t\u0027val\u0027: \"\"\n\t\t\t}\n\t\treturn output\n\t\n",
                          "type": "script"
                        }
                      ],
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "params": {
                    "Title": "Product"

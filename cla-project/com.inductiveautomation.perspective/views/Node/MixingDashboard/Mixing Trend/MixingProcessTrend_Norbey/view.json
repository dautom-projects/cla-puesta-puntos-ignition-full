            },
            "propConfig": {
              "props.instances": {
                "binding": {
                  "config": {
                    "path": "view.custom.areaId"
                  },
                  "transforms": [
                    {
                      "code": "# \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n# Generate dynamic instances based on existing production lines\n# \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n\n\t\"\"\"\n\tGenerates JSON instances for each production line under a given area.\n\tLines named \u0027UI\u0027 or \u0027Edge\u0027 are excluded.\n\n\tReturns:\n\t\tlist(dict): List of instance definitions for Perspective Flex Repeater\n\t\"\"\"\n\t\n\t# 1️⃣ Parameters from the view\n\tparentPath \u003d\u0027[UNS]Clarios/Andina\u0027\n\tareaName \u003d self.view.custom.areaId\n\t\n\t# 2️⃣ Base path in UNS\n\tbasePath \u003d \"{}/{}\".format(parentPath, areaName)\n\t\n\t# 3️⃣ Browse all tags/folders inside the area\n\ttry:\n\t\tresults \u003d system.tag.browse(basePath).getResults()\n\texcept Exception as e:\n\t\tsystem.util.getLogger(\"InstanceBuilder\").error(\"Browse failed: {}\".format(e))\n\t\treturn []\n\t\n\t# 4️⃣ Filter only valid lines (exclude \u0027UI\u0027 and \u0027Edge\u0027)\n\tlineNames \u003d [\n\t\ttag[\u0027name\u0027] for tag in results\n\t\tif tag[\u0027hasChildren\u0027] and tag[\u0027name\u0027] not in [\u0027UI\u0027, \u0027Edge\u0027]\n\t]\n\t\n\t# 5️⃣ Build JSON instances\n\tinstances \u003d []\n\tfor lineName in lineNames:\n\t\tinstance \u003d {\n\t\t\t\"instanceStyle\": {\"classes\": \"\"},\n\t\t\t\"instancePosition\": {},\n\t\t\t\"areaName\": areaName,\n\t\t\t\"lineName\": lineName\n\t\t}\n\t\tinstances.append(instance)\n\t\n\t# 6️⃣ Debug (optional)\n\tlogger \u003d system.util.getLogger(\"InstanceBuilder\")\n\tlogger.info(\"{} lines found under {}: {}\".format(len(lineNames), areaName, lineNames))\n\t\n\t# 7️⃣ Return instance list\n\treturn instances",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "direction": "column",
              "elementPosition": {
                "basis": "auto",

          {
            "children": [
              {
                "custom": {
                  "count": 0,
                  "enabledPens": []
                },
                "meta": {
                  "domId": "CustomPowerChart",
                  "name": "Power Chart"
                },
                "position": {
                  "basis": "800px",
                  "grow": 1
                },
                "propConfig": {
                  "custom.count": {
                    "binding": {
                      "config": {
                        "path": "this.props.pens"
                      },
                      "enabled": false,
                      "transforms": [
                        {
                          "code": "\t\"\"\"\n\tCount how many distinct plot indices are present in props.pens.\n\n\tParameters:\n\t\tvalue (list of dict): The pens array bound from props.pens.\n\t\tquality: Unused.\n\t\ttimestamp: Unused.\n\n\tReturns:\n\t\tint: Number of unique plot numbers in the array.\n\t\"\"\"\n\tpens \u003d value or []\n\tunique_plots \u003d set()\n\n\tfor pen in pens:\n\t\tp \u003d pen.get(\u0027plot\u0027)\n\t\t# Only add valid numbers\n\t\ttry:\n\t\t\tp_int \u003d int(p)\n\t\texcept (ValueError, TypeError):\n\t\t\tcontinue\n\t\t\t\n\t\tunique_plots.add(p_int)\n\n\t# Return the count directly\n\treturn len(unique_plots)",
                          "type": "script"
                        }
                      ],
                      "type": "property"
                    }
                  },
                  "custom.pens": {
                    "binding": {
                      "config": {
                        "path": "view.params.trendConfig.allPens"
                      },
                      "transforms": [
                        {
                          "code": "\t# \u003d\u003d\u003d INPUT: lista de instancias (como la que envías en el ejemplo) \u003d\u003d\u003d\n\tinstances \u003d value # o payload, o como lo estés recibiendo\n\t\n\t# \u003d\u003d\u003d 1️⃣ Extraer unidades únicas \u003d\u003d\u003d\n\tunits \u003d sorted(list(set([i.get(\u0027unit\u0027, \u0027default\u0027) for i in instances])))\n\t\n\t# \u003d\u003d\u003d 2️⃣ Crear plots dinámicos \u003d\u003d\u003d\n\tplots \u003d []\n\tfor _ in units:\n\t\tplots.append({\n\t\t\t\"relativeWeight\": 3,\n\t\t\t\"color\": \"var(--neutral-10)\",\n\t\t\t\"markers\": [],\n\t\t\t\"style\": {\"classes\": \"\"}\n\t\t})\n\t\n\t# \u003d\u003d\u003d 3️⃣ Crear axes dinámicos \u003d\u003d\u003d\n\taxes \u003d []\n\tfor idx, unit in enumerate(units):\n\t\taxis \u003d {\n\t\t\t\"name\": unit,\n\t\t\t\"position\": \"left\",\n\t\t\t\"width\": 60,\n\t\t\t\"color\": \"#757A7F\",\n\t\t\t\"dataFormat\": \"0,0.##\",\n\t\t\t\"range\": {\"auto\": True, \"min\": \"\", \"max\": \"\"},\n\t\t\t\"label\": {\n\t\t\t\t\"text\": unit.capitalize(),\n\t\t\t\t\"offset\": 0,\n\t\t\t\t\"font\": {\"color\": \"#757A7F\", \"size\": 12},\n\t\t\t\t\"style\": {\"classes\": \"\"}\n\t\t\t},\n\t\t\t\"tick\": {\n\t\t\t\t\"color\": \"#757A7F\",\n\t\t\t\t\"count\": \"Auto\",\n\t\t\t\t\"label\": {\n\t\t\t\t\t\"format\": \"Auto\",\n\t\t\t\t\t\"font\": {\"color\": \"#757A7F\", \"size\": 10},\n\t\t\t\t\t\"style\": {\"classes\": \"\"}\n\t\t\t\t},\n\t\t\t\t\"style\": {\"classes\": \"\"}\n\t\t\t},\n\t\t\t\"style\": {\"classes\": \"\"}\n\t\t}\n\t\n\t\t# \u003d\u003d\u003d 4️⃣ A partir del 3er eje, agregar el binding \"translate\" \u003d\u003d\u003d\n\t\tif idx \u003e\u003d 2:\n\t\t\taxis[\"label\"][\"style\"][\"translate\"] \u003d {\n\t\t\t\t\"type\": \"property\",\n\t\t\t\t\"config\": {\"path\": \"this.custom.count\"},\n\t\t\t\t\"transforms\": [\n\t\t\t\t\t{\n\t\t\t\t\t\t\"type\": \"expression\",\n\t\t\t\t\t\t\"expression\": (\n\t\t\t\t\t\t\t\"if({value}\u003d1, \u0027-8px 44%\u0027, \"\n\t\t\t\t\t\t\t\"if({value}\u003d2, \u0027-8px 22%\u0027, \"\n\t\t\t\t\t\t\t\"if({value}\u003d3, \u0027-8px 13%\u0027, \u0027-8px 10%\u0027)))\"\n\t\t\t\t\t\t)\n\t\t\t\t\t}\n\t\t\t\t]\n\t\t\t}\n\t\n\t\taxes.append(axis)\n\t\n\t# \u003d\u003d\u003d 5️⃣ Guardar los resultados \u003d\u003d\u003d\n\tself.props.plots \u003d plots\n\tself.props.axes \u003d axes\n\t\n\t# \u003d\u003d\u003d 6️⃣ Crear pens dinámicos \u003d\u003d\u003d\n\tpens \u003d []\n\n\tfor inst in instances:\n\t\tunit \u003d inst.get(\"unit\", \"default\")\n\t\tcolor \u003d inst.get(\"color\", \"#00bcd4\")  # color por defecto si no viene\n\t\tpathSource \u003d inst.get(\"pathSource\", \"\")\n\t\tname \u003d inst.get(\"name\", \"Unnamed Pen\")\n\n\t\t# Buscar el índice del plot correspondiente a la unidad\n\t\tplotIndex \u003d units.index(unit) if unit in units else 0\n\n\t\tpen \u003d {\n\t\t\t\"name\": name,\n\t\t\t\"visible\": True,\n\t\t\t\"enabled\": True,\n\t\t\t\"selectable\": False,\n\t\t\t\"axis\": unit,\n\t\t\t\"plot\": plotIndex,\n\t\t\t\"display\": {\n\t\t\t\t\"type\": \"line\",\n\t\t\t\t\"interpolation\": \"curveLinear\",\n\t\t\t\t\"breakLine\": True,\n\t\t\t\t\"radius\": 3,\n\t\t\t\t\"styles\": {\n\t\t\t\t\t\"normal\": {\n\t\t\t\t\t\t\"stroke\": {\"color\": color, \"width\": 1, \"opacity\": 0.8, \"dashArray\": 0},\n\t\t\t\t\t\t\"fill\": {\"color\": color, \"opacity\": 0.8},\n\t\t\t\t\t},\n\t\t\t\t\t\"highlighted\": {\n\t\t\t\t\t\t\"stroke\": {\"color\": color, \"width\": 1, \"opacity\": 1, \"dashArray\": 0},\n\t\t\t\t\t\t\"fill\": {\"color\": color, \"opacity\": 1},\n\t\t\t\t\t},\n\t\t\t\t\t\"selected\": {\n\t\t\t\t\t\t\"stroke\": {\"color\": color, \"width\": 1, \"opacity\": 1, \"dashArray\": 0},\n\t\t\t\t\t\t\"fill\": {\"color\": color, \"opacity\": 1},\n\t\t\t\t\t},\n\t\t\t\t\t\"muted\": {\n\t\t\t\t\t\t\"stroke\": {\"color\": color, \"width\": 1, \"opacity\": 0.4, \"dashArray\": 0},\n\t\t\t\t\t\t\"fill\": {\"color\": color, \"opacity\": 0.4},\n\t\t\t\t\t},\n\t\t\t\t},\n\t\t\t},\n\t\t\t\"data\": {\n\t\t\t\t\"source\": pathSource,\n\t\t\t\t\"aggregateMode\": \"default\",\n\t\t\t},\n\t\t}\n\n\t\tpens.append(pen)\n\n\t# \u003d\u003d\u003d 7️⃣ Asignar al gráfico \u003d\u003d\u003d\n\treturn pens",
                          "type": "script"
                        }
                      ],
                      "type": "property"
                    }
                  },

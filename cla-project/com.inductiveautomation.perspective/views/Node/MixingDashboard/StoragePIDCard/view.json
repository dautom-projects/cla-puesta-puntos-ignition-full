              {
                "meta": {
                  "name": "TankMetric"
                },
                "position": {
                  "height": 0.256,
                  "width": 0.8808,
                  "x": 0.0549,
                  "y": 0.0173
                },
                "propConfig": {
                  "props.params.key": {
                    "binding": {
                      "config": {
                        "expression": "now(800)"
                      },
                      "transforms": [
                        {
                          "code": "\t\"\"\"\n\tTrigger on now(), read tag paths from self.view.params.key,\n\tand return a dict with:\n\t  - Boolean flags copied straight through.\n\t  - Any dict entries with \u0027val\u0027 updated to the live tag value.\n\t\"\"\"\n\t# 1. Grab the original params\n\tparams \u003d self.view.params.tank\n\n\t# 2. Separate out tag-path entries and preserve other flags\n\ttagKeys \u003d []\n\tpaths \u003d []\n\toutput \u003d {}\n\tfor k, info in params.items():\n\t\t# If this entry is a dict with a \u0027val\u0027 field, it\u0027s a tag path\n\t\tif hasattr(info, \u0027get\u0027) and \u0027val\u0027 in info:\n\t\t\tpath \u003d info.get(\u0027val\u0027)\n\t\t\tif path:\n\t\t\t\ttagKeys.append(k)\n\t\t\t\tpaths.append(path)\n\t\telse:\n\t\t\t# Copy booleans or any other non-dict entries straight through\n\t\t\toutput[k] \u003d info\n\n\t# 3. Guard against no tag paths\n\tif not paths:\n\t\treturn output\n\n\t# 4. Read all tag paths at once\n\tresults \u003d system.tag.readBlocking(paths)\n\n\t# 5. Insert live values for each tagKey\n\tfor idx, k in enumerate(tagKeys):\n\t\tinfo \u003d params[k]\n\t\tres \u003d results[idx]\n\t\t# Use quality.isGood() in Python/Jython\n\t\tliveVal \u003d res.value if hasattr(res, \u0027quality\u0027) and res.quality.isGood() else None\n\t\t# Build that entry in the output\n\t\toutput[k] \u003d {\n\t\t\t\u0027desc\u0027: info.get(\u0027desc\u0027),\n\t\t\t\u0027uom\u0027: info.get(\u0027uom\u0027, \u0027\u0027),\n\t\t\t\u0027val\u0027: liveVal\n\t\t}\n\n\treturn output",
                          "type": "script"
                        }
                      ],
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "path": "Node/MixingDashboard/TankInfo"
                },
                "type": "ia.display.view"
              },

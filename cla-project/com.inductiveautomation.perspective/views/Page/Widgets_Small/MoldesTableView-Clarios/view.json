                {
                  "messageType": "deleteMolde",
                  "pageScope": true,
                  "script": "    import java.lang.Exception\n\t# implement your handler here\n    try:\n\t\tdb \u003d self.view.custom.dbConnection\n\t\ttable \u003d mes_core.model.moldeTable(db)\n\t\tMoldeCode \u003d self.view.custom.selMoldeCode\n\t\tMoldeID\u003dself.view.custom.selMoldeID\n\t\ttable.deleteID(MoldeID)\n\t\t\n\t\t\n\t\t# Refresh table after query\n\t\tsystem.perspective.sendMessage(\"refreshTableMoldes\", payload\u003d{})\n\t\t\n\t\t# confirm Popup\n\t\talerts.actionSuccess(title\u003d\"Molde eliminado\", \n\t\t\t\t\t\t\tmessage\u003d\u0027Molde \"{}\" eliminado correctamente\u0027.format(MoldeCode))\n\t\n\n    except (Exception, java.lang.Exception), e:   # atrapa Python y Java\n        alerts.actionDeleteError(\n            title\u003d\u0027Error al eliminar\u0027, \n            message\u003d\u0027No es posible eliminar el molde porque esta relacionado en otra tabla.\u0027\n        )",
                  "sessionScope": true,
                  "viewScope": true
                }
              ]

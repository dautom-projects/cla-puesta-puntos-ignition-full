              "extensionFunctions": null,
              "messageHandlers": [
                {
                  "messageType": "deleteSch",
                  "pageScope": true,
                  "script": "\t\"\"\"\n\tScript: deleteScheduleRow (Event)\n\t\n\tBrief:\n\t\tDeletes a scheduled workorder by ID from scheduleTable and refreshes the UI.\n\t\n\tReturns:\n\t\tNone: Event script (no return needed).\n\t\n\tParameters\n\t\tvalue (None):\n\t\t\tInput value provided by the event (unused).\n\t\t\tDefault: None (event-provided)\n\t\"\"\"\n\t\n\ttry:\n\t\t# Initialization of variables\n\t\toutput \u003d None\n\t\n\t\t# Logic\n\t\tdb \u003d self.view.custom.dbConnection\n\t\ttable \u003d mes_core.model.scheduleTable(db)\n\t\tselID \u003d self.view.custom.selName\n\n\t\t\n\t\t\n\t\ttable.deleteID(selID)\n\n\t\talerts.actionSuccess(\n\t\t\ttitle\u003d\"Agendamiento eliminado\",\n\t\t\tmessage\u003d\u0027Agendamiento de la orden \"{}\" eliminado correctamente\u0027.format(selID)\n\t\t)\n\n\t\t# Refrescar tabla y limpiar selección\n\t\tsystem.perspective.sendMessage(\"refreshTableSchedule\", payload\u003d{})\n\t\tmes_core.logging.log(\"Dautom\", \"[Widget_Small/WorkOrderTable-Scheduled/Button Delete/Script] Agendamiento eliminado\", \"info\")\n\t\tself.parent.parent.getChild(\"Table\").props.selection.enableRowSelection \u003d False\n\t\tself.parent.parent.getChild(\"Table\").props.selection.enableRowSelection \u003d True\n\t\n\t\t# Return\n\t\treturn output\n\t\n\texcept Exception as e:\n\t\t# Return\n\t\tmes_core.logging.log(\"Dautom\", \"[Widget_Small/WorkOrderTable-Scheduled/Button Delete/Script] {}\".format(e), \"error\")\n\t\treturn None",
                  "sessionScope": true,
                  "viewScope": true
                }
              ]
            },
            "type": "ia.input.button"
          },

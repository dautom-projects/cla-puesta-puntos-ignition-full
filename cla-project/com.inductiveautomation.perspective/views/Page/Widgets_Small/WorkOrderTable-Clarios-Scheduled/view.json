    "custom.selectionRow": {
      "binding": {
        "config": {
          "path": "view.params.eventID"
        },
        "transforms": [
          {
            "code": "\t\n\t\"\"\"\n\tConvierte el dataset en PyDataSet y busca el índice de la fila\n\tcuya columna \u0027ID\u0027 coincide con el valor recibido.\n\t\n\tArgs:\n\t\tvalue: valor a buscar en la columna \u0027ID\u0027.\n\t\tquality: calidad de la señal (no se usa en esta lógica).\n\t\ttimestamp: marca de tiempo (no se usa en esta lógica).\n\t\n\tReturns:\n\t\tEl índice de la fila donde \u0027ID\u0027 \u003d\u003d value,\n\t\to -1 si no se encuentra.\n\t\"\"\"\n\t\n\tdataTable \u003d self.custom.tableData\n\tpyData \u003d system.dataset.toPyDataSet(dataTable)\n\t\n\tfor i, row in enumerate(pyData):\n\t\tif row[\"ID\"] \u003d\u003d value:\n\t\t\treturn i\n\t\n\treturn -1",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.showClosed": {
      "binding": {
        "config": {
          "path": "/root/ClosedContainer/Checkbox_Closed.props.selected"
        },
        "type": "property"
      },
      "onChange": {
        "enabled": null,
        "script": "\tsystem.perspective.sendMessage(\u0027refreshTableWO\u0027, payload\u003d{})"
      },
      "persistent": true
    },
    "custom.tableData": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "direct",
          "tagPath": "[default]Dataset_excel"
        },
        "enabled": false,
        "type": "tag"
      },
      "persistent": true
    },
    "custom.timer": {
      "binding": {
        "config": {
          "expression": "dateExtract(now(3000),\"second\")"
        },
        "type": "expr"
      },
      "onChange": {
        "enabled": null,
        "script": "\tsystem.perspective.sendMessage(\"refreshWorkOrders\", payload\u003d{})\n\t\n"
      },
      "persistent": true
    },

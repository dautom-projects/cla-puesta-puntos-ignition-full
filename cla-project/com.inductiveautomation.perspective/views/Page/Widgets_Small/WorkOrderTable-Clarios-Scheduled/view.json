      "messageHandlers": [
        {
          "messageType": "refreshWorkOrders",
          "pageScope": true,
          "script": "\t\n\tquery \u003d \"\"\"\n\t\t\n\t\t\tSELECT \n\t\t\t\tsch.ID AS ID,\n\t\t\t\tsch.WorkOrderID AS WorkOrderID,\n\t\t\t\tpc.ProductCode,\n\t\t\t\tsch.ScheduleStartDateTime AS StartTime,\n\t\t\t\tsch.ScheduleFinishDateTime AS FinishTime,\n\t\t\t\tmld.MoldCode AS MoldeCode,\n\t\t\t\tsch.Quantity AS Quantity,\n\t\t\t\tn.name AS nodeName,\n\t\t\t\two.Closed AS Finished\n\t\t\tFROM schedule sch\n\t\t\n\t\t\tINNER JOIN workorder wo \n\t\t\t\tON wo.ID \u003d sch.WorkOrderID\n\t\t\tINNER JOIN productcode pc \n\t\t\t\tON pc.ID \u003d wo.ProductCodeID\n\t\t\tINNER JOIN mold mld \n\t\t\t\tON mld.ID \u003d sch.MoldID\n\t\t\tINNER JOIN node n \n\t\t\t\tON n.ID \u003d sch.NodeID\n\t\t\t\n\t\t\tWHERE n.ID \u003d ?\n\n\t\"\"\"\n\n\tself.view.custom.tableData \u003d system.db.runPrepQuery(query, [self.view.params.nodeID])\n\t",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"

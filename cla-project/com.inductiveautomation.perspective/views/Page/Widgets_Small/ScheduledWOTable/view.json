            "scripts": {
              "customMethods": [
                {
                  "name": "checkRunRules",
                  "params": [],
                  "script": "\t# implement your method here\n\t\n\t\u0027\u0027\u0027\n\t\n\tlineName \u003d self.view.custom.lineName\n\t\n\tselSchID \u003d self.view.custom.selSchID\n\t#[actualSrc, actualDst] \u003d order.getSrcDst(selSchID)\n\tactualWOID \u003d self.view.custom.selWOID\n\t\n\trecRun \u003d run.getRunByLine(\u0027Recibo\u0027)\n\tif recRun:\n\t\trecRunSrc \u003d recRun.getValueAt(0, \"SourceStorage\")\n\t\trecRunDst \u003d recRun.getValueAt(0, \"DestinationStorage\")\n\t\trecWOID \u003d recRun.getValueAt(0, \"WorkOrderID\")\n\t\tif set ([actualDst]) \u0026 set([recRunDst]):\n\t\t\treturn \u0027Silos en uso\u0027\n\ttrsRun \u003d run.getRunByLine(\u0027Trasiego\u0027)\n\tif trsRun:\n\t\ttrsRunSrc \u003d trsRun.getValueAt(0, \"SourceStorage\")\n\t\ttrsRunDst \u003d trsRun.getValueAt(0, \"DestinationStorage\")\n\t\ttrsWOID \u003d trsRun.getValueAt(0, \"WorkOrderID\")\n\t\tif set ([actualDst]) \u0026 set([trsRunDst]):\n\t\t\treturn \u0027Silos en uso\u0027\n\ttmlRun \u003d run.getRunByLine(\u0027Trasiego Molino\u0027)\n\tif tmlRun:\n\t\ttmlRunSrc \u003d tmlRun.getValueAt(0, \"SourceStorage\")\n\t\ttmlRunDst \u003d tmlRun.getValueAt(0, \"DestinationStorage\")\n\t\ttmlWOID \u003d tmlRun.getValueAt(0, \"WorkOrderID\")\n\t\tif set ([actualDst]) \u0026 set([tmlRunDst]):\n\t\t\treturn \u0027Silos en uso\u0027\n\n\t\n\t\n\t\n\tif lineName \u003d\u003d \u0027Recibo\u0027:\n\t\tif recRun: #\tOrder recibo activa verificar \n\t\t\tif recWOID !\u003d actualWOID:\n\t\t\t\tlogging.log(\u0027Actual {} progreso {}\u0027.format(recWOID,actualWOID), \u0027info\u0027)\n\t\t\t\treturn \u0027La orden actual no coincide con la orden en progreso\u0027\n\t\t\telif (system.tag.readBlocking(\"[DAUTOM_Provider]D_obj/Process01_Ctrl/Out_FeedOn\")[0].value) \u003d\u003d True:\n\t\t\t\treturn \u0027Se esta alimentando la linea de Recibo, no se puede iniciar la corrida\u0027\n\t\t\telif system.tag.readBlocking(\"[DAUTOM_Provider]D_obj/Process01_Ctrl/Out_eState\")[0].value !\u003d 6:\n\t\t\t\treturn \u0027No se puede concatenar las corridas porque el SCADA no esta en estado execute\u0027\n\t\telse:\n\t\t\tif trsRun:\n\t\t\t\tif actualDst in [\u0027Silo 3\u0027, \u0027Silo 6\u0027, \u0027Silo 7\u0027, \u0027Silo 8\u0027] and trsRunDst in [\u0027Silo 3\u0027, \u0027Silo 6\u0027, \u0027Silo 7\u0027, \u0027Silo 8\u0027, \u0027Silo A\u0027, \u0027Silo B\u0027]:\n\t\t\t\t\treturn \u0027Linea recibo bloqueada por transportadora T5 en uso\u0027\n\t\t\t\telif actualDst in [\u0027Silo A\u0027, \u0027Silo B\u0027] and trsRunDst in [\u0027Silo A\u0027, \u0027Silo B\u0027]:\n\t\t\t\t\treturn \u0027Linea recibo bloqueada por transportadora T12\u0027\n\t\t\tif tmlRun:\n\t\t\t\treturn None\n\t\n\tif lineName \u003d\u003d \u0027Trasiego\u0027:\n\t\tif trsRun: # Orden de trasiego activa\n\t\t\tif trsWOID !\u003d actualWOID:\n\t\t\t\treturn \u0027La orden actual no coincide con la orden en progreso\u0027\n\t\t\telif (system.tag.readBlocking(\"[DAUTOM_Provider]D_obj/Process02_Ctrl/Out_FeedOn\")[0].value) \u003d\u003d True:\n\t\t\t\treturn \u0027Se esta alimentando la linea de Trasiego, no se puede iniciar la corrida\u0027\n\t\t\telif system.tag.readBlocking(\"[DAUTOM_Provider]D_obj/Process02_Ctrl/Out_eState\")[0].value !\u003d 6:\n\t\t\t\treturn \u0027No se puede concatenar las corridas porque el SCADA no esta en estado execute\u0027\n\t\t\tif actualSrc in [\u0027Silo 1\u0027, \u0027Silo 2\u0027]:\n\t\t\t\tif not (actualSrc in [\u0027Silo 1\u0027, \u0027Silo 2\u0027] and trsRunSrc in [\u0027Silo 1\u0027, \u0027Silo 2\u0027] and actualDst in [\u0027Silo 3\u0027, \u0027Silo 6\u0027, \u0027Silo 7\u0027, \u0027Silo 8\u0027, \u0027Silo A\u0027, \u0027Silo B\u0027] and trsRunDst in [\u0027Silo 3\u0027, \u0027Silo 6\u0027, \u0027Silo 7\u0027, \u0027Silo 8\u0027, \u0027Silo A\u0027, \u0027Silo B\u0027]):\n\t\t\t\t\treturn \u0027No es posible hacer el empalme para estas corridas\u0027\n\t\t\tif actualSrc in [\u0027Silo 3\u0027, \u0027Silo 4\u0027 ,\u0027Silo 5\u0027 ,\u0027Silo 6\u0027]:\n\t\t\t\tif not (actualSrc in [\u0027Silo 3\u0027, \u0027Silo 4\u0027 ,\u0027Silo 5\u0027 ,\u0027Silo 6\u0027] and trsRunSrc in [\u0027Silo 3\u0027, \u0027Silo 4\u0027 ,\u0027Silo 5\u0027 ,\u0027Silo 6\u0027] and actualDst in [\u0027Silo 3\u0027, \u0027Silo 6\u0027, \u0027Silo 7\u0027, \u0027Silo 8\u0027, \u0027Silo A\u0027, \u0027Silo B\u0027] and trsRunDst in [\u0027Silo 3\u0027, \u0027Silo 6\u0027, \u0027Silo 7\u0027, \u0027Silo 8\u0027, \u0027Silo A\u0027, \u0027Silo B\u0027]):\n\t\t\t\t\treturn \u0027No es posible hacer el empalme para estas corridas\u0027\n\t\telse:\n\t\t\tif recRun:\n\t\t\t\tif actualDst in [\u0027Silo 3\u0027, \u0027Silo 6\u0027, \u0027Silo 7\u0027, \u0027Silo 8\u0027,\u0027Silo A\u0027, \u0027Silo B\u0027] and recRunDst in [\u0027Silo 3\u0027, \u0027Silo 6\u0027, \u0027Silo 7\u0027, \u0027Silo 8\u0027]:\n\t\t\t\t\treturn \u0027Linea trasiego bloqueada por transportadora T5 en uso\u0027\n\t\t\t\telif actualDst in [\u0027Silo A\u0027, \u0027Silo B\u0027] and recRunDst in [\u0027Silo A\u0027, \u0027Silo B\u0027]:\n\t\t\t\t\treturn \u0027Linea trasiego bloqueada por transportadora T12\u0027\n\t\t\t\t\t\n\t\t\tif tmlRun:\n\t\t\t\tif actualSrc in [\u0027Silo 1\u0027, \u0027Silo 2\u0027]:\n\t\t\t\t\treturn \u0027Linea trasiego bloqueada por transportadora T13\u0027\n\t\n\tif lineName \u003d\u003d \u0027Trasiego Molino\u0027:\n\t\tif tmlRun: # Orden de trasiego molino activa\n\t\t\tif tmlWOID !\u003d actualWOID:\n\t\t\t\treturn \u0027La orden actual no coincide con la orden en progreso\u0027\n\t\t\telif (system.tag.readBlocking(\"[DAUTOM_Provider]D_obj/Process03_Ctrl/Out_FeedOn\")[0].value) \u003d\u003d True:\n\t\t\t\treturn \u0027Se esta alimentando la linea de Trasiego Molino, no se puede iniciar la corrida\u0027\n\t\t\telif system.tag.readBlocking(\"[DAUTOM_Provider]D_obj/Process03_Ctrl/Out_eState\")[0].value !\u003d 6:\n\t\t\t\treturn \u0027No se puede concatenar las corridas porque el SCADA no esta en estado execute\u0027\n\t\telse:\n\t\t\tif trsRun:\n\t\t\t\tif  trsRunSrc in [\u0027Silo 1\u0027, \u0027Silo 2\u0027]:\n\t\t\t\t\treturn \u0027Linea trasiego molino bloqueada por transportadora T13\u0027\n\t"
                }
              ],
              "extensionFunctions": null,
              "messageHandlers": [
                {
                  "messageType": "startWORun",
                  "pageScope": false,
                  "script": "\t# implement your handler here\n\timport time\n\t\n\tcurrentrun \u003d mes_core.run.getRunBynode(self.view.params.nodeID)\n\t\n\tlogger \u003d system.util.getLogger(\"Button run order\")\n\tlogger.info(\"Mensaje recibido\")\n\t\n\tif len(currentrun)\u003d\u003d0:\n\t\t\n\t\n\t\t\n\t\t\n\t\t\n\t\tscheduleID \u003d self.view.custom.selSchID\n\t\tlineID \u003d self.view.params.nodeID\n\t\trunID \u003d mes_core.run.IDRun(lineID)\n\t\tif runID:\n\t\t\tmes_core.run.stopRun(runID, lineID, writeTags\u003dTrue)\n\t\t\tsystem.perspective.sendMessage(\u0027refreshRun\u0027, payload\u003d{})\n\t\t\tsystem.perspective.sendMessage(\u0027refreshSchWO\u0027, payload\u003d{})\n\t\t\n\t\tif payload: logging.log(\u0027Plate received\u0027, \u0027info\u0027)\n\t\n\t\tif not payload:\n\t\t\tmes_core.run.startRun(scheduleID, lineID)\n\t\telse:\n\t\t\tmes_core.run.startRun(scheduleID, lineID, truckPlate\u003dpayload[\"plate\"])\n\t\t\t\t\t\n\t\tsystem.perspective.sendMessage(\u0027refreshRun\u0027, payload\u003d{})\n\t\tsystem.perspective.sendMessage(\u0027refreshSchWO\u0027, payload\u003d{})\n\t\t\n\t\tlogger.info(\"Mensaje refresh Run enviado\")\n\t\t\n\t\talerts.actionSuccess(title\u003d\u0027Orden Iniciada\u0027, \n\t\t\t\t\t\t\t\tmessage\u003d\u0027La orden \"{}\" fue iniciada\u0027.format(self.view.custom.selWO))\n\t\t\t\t\t\t\t\t\n\t\t\n\t\ttime.sleep(10)\n\t\t\n\t\tstationStatus \u003d self.view.custom.stationStatus\n\t\t\n\t\tif stationStatus!\u003d3 and stationStatus!\u003d4:\n\t\t\talerts.showAlert(\"warning\", title\u003d\"Linea Inactiva\", message\u003d \"Actualmente la linea se encuenrtra detenida.\", btnTextPrimary\u003d\"Ok\", btnActionPrimary\u003d\"closePopup\")\n\t\n\telse:\n\t\talerts.showAlert(state\u003d\"info\", title\u003d\"Accion no valida\", message\u003d\"Ya hay una corrida activa en esta linea\", btnTextPrimary\u003d\"OK\", btnActionPrimary\u003d\"closePopup\")\n\t\t\n\tlogger.info(\"Accion iniciar orden realizada\")",
                  "sessionScope": true,
                  "viewScope": false
                }
              ]
            },
            "type": "ia.input.button"
          }
        ],

  "events": {
    "system": {
      "onStartup": {
        "config": {
          "script": "\tsystem.perspective.sendMessage(\u0027refreshSchWO\u0027, payload\u003d{})\n\t\n\t\u0027\u0027\u0027\n\ttable\u003dmes_core.schedule.scheduleTable(\"mes_core\")\n\tself.view.custom.tableData \u003d table.selectCustom(columns\u003d[\"ID\",\"NodeID\", \"Quantity\" , \"MoldID\" , \"WorkOrderID\", \"ScheduleStartDateTime\",\n\t\"ScheduleFinishDateTime\"] , where_clause\u003d \"RunID is Null\")\n"
        },
        "scope": "G",
        "type": "script"
      }
    }
  },
  "params": {
    "nodeID": 4
  },
  "propConfig": {
    "custom.db": {
      "persistent": true
    },
    "custom.lineDisable": {
      "persistent": true
    },
    "custom.lineIdMap": {
      "binding": {
        "config": {
          "path": "view.params.lineID"
        },
        "type": "property"
      },
      "persistent": true
    },
    "custom.lineName": {
      "binding": {
        "config": {
          "path": "view.params.nodeID"
        },
        "transforms": [
          {
            "code": "\tid \u003d value\n\tdb \u003d self.custom.db\n\tquery \u003d  \"\"\"\n\t\tSELECT Name FROM node WHERE ID \u003d ?\n\t\"\"\"\n\tdataset \u003d system.db.runPrepQuery(query, [id], db)\n\tname \u003d dataset[0][\"Name\"]\n\treturn name",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "onChange": {
        "enabled": null,
        "script": "\tsystem.perspective.sendMessage(\u0027refreshSchWO\u0027, payload\u003d{})"
      },
      "persistent": true
    },
    "custom.selEndTime": {
      "binding": {
        "config": {
          "path": "/root/Table.props.selection.data[0].ScheduleFinishDateTime"
        },
        "transforms": [
          {
            "formatType": "datetime",
            "formatValue": {
              "date": "medium",
              "time": "medium"
            },
            "type": "format"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.selMatCode": {
      "binding": {
        "config": {
          "path": "/root/Table.props.selection.data[0].MoldeID"
        },
        "type": "property"
      },
      "persistent": true
    },
    "custom.selQty": {
      "binding": {
        "config": {
          "path": "/root/Table.props.selection.data[0].Quantity"
        },
        "type": "property"
      },
      "persistent": true
    },
    "custom.selSchID": {
      "binding": {
        "config": {
          "path": "/root/Table.props.selection.data[0].ID"
        },
        "type": "property"
      },
      "persistent": true
    },
    "custom.selStartTime": {
      "binding": {
        "config": {
          "path": "/root/Table.props.selection.data[0].ScheduleStartDateTime"
        },
        "transforms": [
          {
            "formatType": "datetime",
            "formatValue": {
              "date": "medium",
              "time": "medium"
            },
            "type": "format"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.selWO": {
      "binding": {
        "config": {
          "path": "/root/Table.props.selection.data[0].WorkOrderID"
        },
        "type": "property"
      },
      "persistent": true
    },
    "custom.selWOID": {
      "binding": {
        "config": {
          "path": "/root/Table.props.selection.data[0].WorkOrderID"
        },
        "type": "property"
      },
      "persistent": true
    },
    "custom.stationStatus": {
      "binding": {
        "config": {
          "struct": {
            "db": "{view.custom.db}",
            "lineID": "{view.params.nodeID}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\t\t\n\ttry:\n\t\ttableStH\u003d mes_core.model.statehistoryTable(value[\"db\"])\n\t\tcolumns \u003d [\"TOP 1 ReasonCode\"]\n\t\twhere_clause \u003d (\n\t\t\t\"NodeID \u003d ? \"\n\t\t\t\"ORDER BY ID DESC \"\n\t\t)\n\t\twhere_args \u003d [value[\"lineID\"]]\n\t\tresult\u003dtableStH.selectCustom(columns, where_clause, where_args)\n\t\t\n\t\tvalue \u003d result.getValueAt(0,0)\n\t\treturn value\n\texcept:\n\t\treturn 1",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.tableData": {
      "persistent": true
    },
    "params.nodeID": {
      "paramDirection": "input",
      "persistent": true
    }
  },

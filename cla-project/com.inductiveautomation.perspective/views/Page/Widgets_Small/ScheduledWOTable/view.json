    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "refreshSchWO",
          "pageScope": true,
          "script": "\t# implement your handler here\n\t\u0027\u0027\u0027\n\ttable\u003dmes_core.schedule.scheduleTable(\"mes_core\")\n\tself.view.custom.tableData \u003d table.selectCustom(columns\u003d[\"ID\",\"NodeID\", \"Quantity\" , \"MoldID\" , \"WorkOrderID\", \"ScheduleStartDateTime\",\n\t\"ScheduleFinishDateTime\"] , where_clause\u003d \"RunID is Null\")\n\t#self.view.custom.lineDisable \u003d 1 if run.getRunByLine(lineName) else 0\n\t\u0027\u0027\u0027\n\tquery \u003d \"\"\"\n\t\t\n\t\t\tSELECT \n\t\t\t\tsch.ID AS ID,\n\t\t\t\tsch.WorkOrderID AS WorkOrderID,\n\t\t\t\tpc.ProductCode,\n\t\t\t\tpc.Description,\n\t\t\t\tsch.ScheduleStartDateTime AS StartTime,\n\t\t\t\tsch.ScheduleFinishDateTime AS FinishTime,\n\t\t\t\tmld.MoldCode AS MoldeCode,\n\t\t\t\tsch.Quantity AS Quantity,\n\t\t\t\tn.name AS nodeName\n\t\t\tFROM schedule sch\n\t\t\n\t\t\tINNER JOIN workorder wo \n\t\t\t\tON wo.ID \u003d sch.WorkOrderID\n\t\t\tINNER JOIN productcode pc \n\t\t\t\tON pc.ID \u003d wo.ProductCodeID\n\t\t\tINNER JOIN mold mld \n\t\t\t\tON mld.ID \u003d sch.MoldID\n\t\t\tINNER JOIN node n \n\t\t\t\tON n.ID \u003d sch.NodeID\n\t\t\t\n\t\t\tWHERE n.ID \u003d ? AND sch.RunID is Null\n\t\t\tORDER BY sch.ScheduleStartDateTime DESC\n\n\t\"\"\"\n\t\n\tself.view.custom.tableData \u003d system.db.runPrepQuery(query, [self.view.params.nodeID])\n\t",
          "sessionScope": true,
          "viewScope": true
        }
      ]
    },
    "type": "ia.container.flex"
  }

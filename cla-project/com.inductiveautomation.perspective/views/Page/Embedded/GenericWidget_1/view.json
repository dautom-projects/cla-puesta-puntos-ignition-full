{
  "custom": {},
  "params": {
    "alignVertical": "center",
    "contend": "value",
    "textAlign": "center",
    "title": "value"
  },
  "propConfig": {
    "params.alignVertical": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.contend": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.textAlign": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.title": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 470
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Label_title"
            },
            "position": {
              "basis": "50px"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.title"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "text-titles-2"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Label_contend"
            },
            "position": {
              "basis": "100%"
            },
            "propConfig": {
              "props.alignVertical": {
                "binding": {
                  "config": {
                    "path": "view.params.alignVertical"
                  },
                  "type": "property"
                }
              },
              "props.style.textAlign": {
                "binding": {
                  "config": {
                    "path": "view.params.textAlign"
                  },
                  "type": "property"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.contend"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "overflowWrap": "break-word",
                "paddingLeft": 5,
                "paddingTop": 5
              },
              "textStyle": {
                "classes": "text-description-centered"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "FlexContainer_general"
        },
        "position": {
          "basis": "100%"
        },
        "props": {
          "direction": "column",
          "style": {
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "borderStyle": "none",
        "classes": "container-borders-dautom-widget",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}
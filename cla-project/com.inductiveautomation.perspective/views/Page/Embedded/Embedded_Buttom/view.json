{
  "custom": {
    "viewDigitalization": "Page/Digitalizacion_Template"
  },
  "params": {
    "label": "30 min",
    "papoPath": "Formato_Reportes_CLA/Ensamble Linea 1/EA11-0901",
    "registerPath": "Page/Embedded/Questions_EA11-0901_30min"
  },
  "propConfig": {
    "custom.viewDigitalization": {
      "persistent": true
    },
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.papoPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.registerPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 35,
      "width": 99
    }
  },
  "root": {
    "children": [
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\t\n\t#self.view.params.applyButton \u003d 1\n\tviewDigitalization \u003d self.view.custom.viewDigitalization\n\tpapoReport \u003d self.view.params.papoPath\n\tregisterPath \u003d self.view.params.registerPath\n\tsystem.perspective.navigate(\n\t\tview \u003d viewDigitalization,\n   \t\tparams\u003d{\"papoReport\": papoReport, \"registerType\": registerPath}\n   \t\t)"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "Button_Apply_4"
        },
        "position": {
          "basis": "20px",
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.label"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "image": {
            "height": 30,
            "width": 15
          },
          "primary": false,
          "style": {
            "classes": "button-2",
            "marginBottom": 2,
            "marginLeft": 2,
            "marginRight": 2,
            "marginTop": 2
          }
        },
        "type": "ia.input.button"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}
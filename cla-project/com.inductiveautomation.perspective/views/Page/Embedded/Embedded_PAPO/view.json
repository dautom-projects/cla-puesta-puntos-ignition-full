          },
          {
            "config": {
              "script": "\tsystem.perspective.sendMessage(\n\t    messageType\u003d\"closeEmbeded\", \n\t    payload\u003d{\"estado\": False,},\n\t    scope\u003d\"session\"\n\t)"
            },
            "scope": "G",
            "type": "script"
          }
        ],
        "onMouseEnter": {
          "config": {
            "script": "\tself.custom.OnMouseOver \u003d True"
          },
          "scope": "G",
          "type": "script"
        },
        "onMouseLeave": {

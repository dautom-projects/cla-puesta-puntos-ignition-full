{
  "custom": {
    "dbConnection": "papo_db",
    "refreshStatus": false,
    "timeFormated": "00h 10m",
    "topic": null,
    "viewDigitalization": "/nodeID/1/papoID/value/workstationID/value/workstationnodeID/value/digitalization",
    "viewOn": true
  },
  "events": {
    "system": {
      "onShutdown": {
        "config": {
          "script": "\tself.custom.viewOn \u003d False"
        },
        "scope": "G",
        "type": "script"
      },
      "onStartup": {
        "config": {
          "script": "\tself.custom.viewOn \u003d True"
        },
        "scope": "G",
        "type": "script"
      }
    }
  },
  "params": {
    "action": "value",
    "minutesSince": 10,
    "name": "value",
    "nodeID": 1,
    "papoID": "value",
    "reference": "value",
    "status": "value",
    "timestamp": "value",
    "user": "value",
    "workstationID": "value",
    "workstationnodeID": "value"
  },
  "propConfig": {
    "custom.dbConnection": {
      "binding": {
        "config": {
          "path": "session.custom.dbConnection"
        },
        "type": "property"
      },
      "persistent": true
    },
    "custom.refreshStatus": {
      "onChange": {
        "enabled": null,
        "script": "\timport time\n\tstatusView \u003d self.custom.viewOn\n\tif statusView:\n\t\ttime.sleep(1)\n\t\t\t\n\t\tlistCustom \u003d [\n\t\t    \n\t\t    \"viewDigitalization\",\n\t\t    \"topic\"\n\t\t]\n\t\tfor path in listCustom:\n\t\t    self.view.refreshBinding(\"custom.{}\".format(path))\n\t\t    \n\t\tself.custom.refreshStatus \u003d False\n\telse:\n\t\tNone"
      },
      "persistent": true
    },
    "custom.timeFormated": {
      "binding": {
        "config": {
          "struct": {
            "mins": "{view.params.minutesSince}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\tmins \u003d value[\"mins\"]\n\tminsFormated \u003d utils.minutesformat(mins)\n\treturn str(minsFormated)",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.topic": {
      "binding": {
        "config": {
          "struct": {
            "dbConnection": "{view.custom.dbConnection}",
            "nodeID": "{view.params.nodeID}",
            "workstationID": "{view.params.workstationID}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\tdbConnection \u003d value[\"dbConnection\"]\n\tnodeID \u003d value[\"nodeID\"]\n\tworkstationID \u003d value[\"workstationID\"]\n\t\n\tquery \u003d \"SELECT topic from node where ID \u003d ?\"\n\targs \u003d [nodeID]\n\tdata \u003d system.db.runPrepQuery(query, args, dbConnection)\n\ttopic \u003d data.getValueAt(0, 0)\n\t\n\tif workstationID:\n\t\tquery2 \u003d \"SELECT Description FROM workstation WHERE ID \u003d ?\"\n\t\targs2 \u003d [workstationID]\n\t\tdata2 \u003d system.db.runPrepQuery(query2, args2, dbConnection)\n\t\tif data2.getRowCount() \u003e 0:\n\t\t\treturn \"De: \" + topic + \"/\" + data2.getValueAt(0, 0)\n\t\n\treturn \"De: \" + topic",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.viewDigitalization": {
      "binding": {
        "config": {
          "struct": {
            "nodeID": "{view.params.nodeID}",
            "papoID": "{view.params.papoID}",
            "urlBase": "{session.props.gateway.address}",
            "wrkID": "{view.params.workstationID}",
            "wrknID": "{view.params.workstationnodeID}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\t\n\turlBase \u003d value[\"urlBase\"]\n\tpapoID \u003d value[\"papoID\"]\n\tnodeID \u003d value[\"nodeID\"]\n\twrkID \u003d value[\"wrkID\"]\n\twrknID \u003d value[\"wrknID\"]\n\t\n\tpagePath \u003d \"/nodeID/%s/papoID/%s/workstationID/%s/workstationnodeID/%s/digitalization\" % (nodeID, papoID, wrkID,wrknID)\n\t\n\treturn pagePath",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.viewOn": {
      "onChange": {
        "enabled": null,
        "script": "\tself.custom.refreshStatus \u003d True"
      },
      "persistent": true
    },
    "params.action": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.minutesSince": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.name": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.nodeID": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.papoID": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.reference": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.status": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.timestamp": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.user": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.workstationID": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.workstationnodeID": {
      "paramDirection": "input",
      "persistent": true
    }
  },

      "persistent": true
    },
    "custom.registerTypeID": {
      "persistent": true
    },
    "custom.user": {
      "binding": {
        "config": {
          "path": "session.props.auth.user.firstName"
        },
        "transforms": [
          {
            "expression": "{value} + \" \" +{session.props.auth.user.lastName}",
            "type": "expression"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.nodeID": {
      "paramDirection": "input",

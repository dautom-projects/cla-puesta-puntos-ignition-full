        "propConfig": {
          "custom.answers": {
            "binding": {
              "config": {
                "struct": {},
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\t\n\t\"\"\"Recorre recursivamente todos los hijos del contenedor (self)\n\ty recolecta los custom.item en un JSON único. Además, si el componente\n\tes un Flex Repeater (tiene props.instances), toma los items de sus instancias.\n\t\"\"\"\n\t\n\tdef _append_item(candidate, out_list):\n\t\t\"\"\"Agrega al arreglo de salida un item con las claves esperadas, si existe.\"\"\"\n\t\tif not candidate:\n\t\t\treturn\n\t\ttry:\n\t\t\tout_list.append({\n\t\t\t\t\"papoItemID\": candidate.get(\"papoItemID\"),\n\t\t\t\t\"registerTypeID\": candidate.get(\"registerTypeID\"),\n\t\t\t\t\"answer\": candidate.get(\"answer\")\n\t\t\t})\n\t\texcept Exception:\n\t\t\t# Silencioso: si el objeto no es mapeable, lo ignoramos\n\t\t\tpass\n\t\n\t\n\tdef _gather_from_instances(component):\n\t\t\"\"\"\n\t\tIntenta extraer items desde props.instances (Flex Repeater).\n\t\tBusca en:\n\t\t  - instancia[\u0027item\u0027]\n\t\t  - instancia[\u0027viewParams\u0027][\u0027item\u0027]\n\t\tTambién soporta que \u0027item\u0027 sea una lista de ítems.\n\t\t\"\"\"\n\t\titems \u003d []\n\t\ttry:\n\t\t\tif hasattr(component, \"props\") and hasattr(component.props, \"instances\"):\n\t\t\t\tfor inst in component.props.instances:\n\t\t\t\t\t# inst es un dict-like\n\t\t\t\t\tcandidate \u003d None\n\t\t\t\t\t# item directo en la instancia\n\t\t\t\t\tif hasattr(inst, \"get\"):\n\t\t\t\t\t\tcandidate \u003d inst.get(\"item\", None)\n\t\t\t\t\t\t# o dentro de viewParams\n\t\t\t\t\t\tif candidate is None:\n\t\t\t\t\t\t\tvp \u003d inst.get(\"viewParams\", None)\n\t\t\t\t\t\t\tif hasattr(vp, \"get\"):\n\t\t\t\t\t\t\t\tcandidate \u003d vp.get(\"item\", None)\n\t\n\t\t\t\t\t# \u0027item\u0027 puede ser un solo dict o una lista de dicts\n\t\t\t\t\tif candidate is not None:\n\t\t\t\t\t\tif isinstance(candidate, (list, tuple)):\n\t\t\t\t\t\t\tfor it in candidate:\n\t\t\t\t\t\t\t\t_append_item(it, items)\n\t\t\t\t\t\telse:\n\t\t\t\t\t\t\t_append_item(candidate, items)\n\t\texcept Exception:\n\t\t\t# Si algo falla, no rompemos el flujo\n\t\t\tpass\n\t\n\t\treturn items\n\t\n\t\n\tdef gather_items(component):\n\t\titems \u003d []\n\t\n\t\t# 1) Si este componente tiene custom.item, lo guardamos\n\t\ttry:\n\t\t\tif hasattr(component, \"custom\") and hasattr(component.custom, \"item\"):\n\t\t\t\t_append_item(component.custom.item, items)\n\t\texcept Exception:\n\t\t\tpass\n\t\n\t\t# 2) Si es un Flex Repeater (o similar) con props.instances, recolectamos desde las instancias\n\t\t#    y NO descendemos a sus hijos para evitar duplicados.\n\t\tif hasattr(component, \"props\") and hasattr(component.props, \"instances\"):\n\t\t\titems.extend(_gather_from_instances(component))\n\t\t\treturn items  # Importante: no recursar hijos del repeater para no duplicar\n\t\n\t\t# 3) Recorremos hijos recursivamente\n\t\ttry:\n\t\t\tfor child in component.getChildren():\n\t\t\t\titems.extend(gather_items(child))\n\t\texcept Exception:\n\t\t\tpass\n\t\n\t\treturn items\n\t\n\t\n\t# --- Ejecución principal ---\n\tall_items \u003d gather_items(self)  # empezamos desde el contenedor actual (p. ej., FlexContainer4)\n\t\n\t# Agregar observaciones como un item extra (NO TOCAR)\n\tinsight_text \u003d getattr(self.view.custom, \"insights\", None)\n\tregisterType \u003d getattr(self.view.custom, \"registerTypeID\", None)\n\tuser \u003d getattr(self.view.custom, \"user\", None)\n\thour \u003d system.date.now()\n\tif insight_text is not None:\n\t\tall_items.append({\n\t\t\t\"user\": user,\n\t\t\t\"timestamp\": hour,\n\t\t\t\"insights\": insight_text,   # 👈 insights como parte de \"answer\"\n\t\t\t\"registerTypeID\": registerType\n\t\t})\n\t\n\treturn {\"items\": all_items}",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          },

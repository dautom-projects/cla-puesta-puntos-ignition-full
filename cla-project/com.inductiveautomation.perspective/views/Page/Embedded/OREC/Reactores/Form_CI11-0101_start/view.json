      "binding": {
        "config": {
          "expression": "dateExtract(now(1000),\"second\")"
        },
        "type": "expr"
      },
      "onChange": {
        "enabled": false,
        "script": "\tlistCustom \u003d [\n\t\t\"answers.ControlRechazos\"\n\t]\n\tfor path in listCustom:\n\t\tself.view.refreshBinding(\"custom.{}\".format(path))"

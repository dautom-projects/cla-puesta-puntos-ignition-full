{
  "custom": {},
  "params": {
    "icon": "home",
    "text": "Home",
    "transform": "value"
  },
  "propConfig": {
    "params.icon": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.text": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.transform": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 50,
      "width": 600
    }
  },
  "root": {
    "children": [
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "page": "/"
              },
              "scope": "C",
              "type": "nav"
            }
          }
        },
        "meta": {
          "name": "Icon"
        },
        "position": {
          "basis": "40px",
          "shrink": 0
        },
        "propConfig": {
          "props.path": {
            "binding": {
              "config": {
                "expression": " {view.params.icon}"
              },
              "type": "expr"
            },
            "persistent": false
          },
          "props.style.transform": {
            "binding": {
              "config": {
                "path": "view.params.transform"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "color": "#000000",
          "style": {
            "classes": "Title/Icon",
            "marginLeft": "10px"
          }
        },
        "type": "ia.display.icon"
      },
      {
        "meta": {
          "hasDelegate": true,
          "name": "Label"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.text"
              },
              "type": "property"
            },
            "persistent": false
          }
        },
        "props": {
          "style": {
            "classes": "Title/Title_0",
            "color": "#000000",
            "fontFamily": "Arial",
            "fontSize": 25,
            "fontWeight": "bold",
            "textAlign": "left"
          },
          "textStyle": {
            "textIndent": "10px"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "style": {
        "backgroundColor": "#D9D9D9",
        "borderBottomColor": "--neutral-60",
        "borderBottomStyle": "None",
        "borderBottomWidth": 1,
        "borderTopColor": "--neutral-60",
        "borderTopStyle": "None",
        "borderTopWidth": 1
      }
    },
    "type": "ia.container.flex"
  }
}
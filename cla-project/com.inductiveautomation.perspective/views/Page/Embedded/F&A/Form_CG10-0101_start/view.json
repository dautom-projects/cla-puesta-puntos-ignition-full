            "propConfig": {
              "custom.item.answer": {
                "binding": {
                  "config": {
                    "path": "this.props.value"
                  },
                  "transforms": [
                    {
                      "code": "\t\n\t# value \u003d numero que llega al binding\n\t# jsonData \u003d propiedad donde tienes el JSON\n\t\n\tdata \u003d self.props.options\n\t\n\tfor item in data:\n\t    if str(item[\"value\"]) \u003d\u003d str(value):\n\t        return item[\"label\"]\n\t\n\treturn \"\"\n\t",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "custom.item.papoItemID": {
                "binding": {
                  "config": {
                    "path": "parent.custom.papoItemID"
                  },
                  "type": "property"
                }
              },
              "custom.item.registerTypeID": {

    "params.dsTableScalesInterval": {
      "binding": {
        "config": {
          "path": "view.params.applyButton"
        },
        "enabled": false,
        "transforms": [
          {
            "code": "\tquery \u003d \"\"\"\n\tSELECT \n\t    s.RunID,\n\t    p.ProductCode,\n\t    r.RunStartDateTime AS StartTime,\n\t    r.RunStopDateTime AS EndTime,\n\t    (r.CurrentInfeed - r.StartInfeed) AS Infeed,\n\t    r.GoodCount AS Outfeed,\n\t    r.WasteCount AS Waste,\n\t    r.Performance,\n\t    r.GoodCount,\n\t    r.TotalCount\n\tFROM run r\n\tINNER JOIN schedule s \n\t    ON r.ID \u003d s.RunID\n\tINNER JOIN workorder w\n\t    ON s.WorkorderID \u003d w.ID\n\tINNER JOIN productcode p\n\t    ON w.ProductCodeID \u003d p.ID\n\tWHERE r.RunStartDateTime \u003e\u003d ?\n\t  AND r.RunStopDateTime \u003c\u003d ?;\n\t\"\"\"\n\t\n\t# Ejecutar la query con los parámetros\n\tresults \u003d system.db.runPrepQuery(query, [self.params.startTime, self.params.endTime])\n\t\t\n\treturn results",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "paramDirection": "input",
      "persistent": true
    },

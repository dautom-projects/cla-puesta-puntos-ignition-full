                  "script": "\tsystem.perspective.sendMessage(\"resetTable\", payload\u003d{})\n\t\n\tlistCustom \u003d [\n\t\t\"answers\"\n\t]\n\t\n\tfor path in listCustom:\n\t\tself.parent.parent.getChild(\"FlexContainer1\").refreshBinding(\"custom.{}\".format(path))\n\n\t\n\t\n\tlistCustom \u003d [\n\t\t\"answers.condiciones\"\n\t]\n\tfor path in listCustom:\n\t\tself.view.refreshBinding(\"custom.{}\".format(path))\n\n\tanswerCond \u003d self.view.custom.answers.condiciones\n\t\n\tregisterTypeID \u003d self.view.custom.registerTypeID\n\tpapoID \u003d self.view.params.papoID\n\tuser \u003d self.session.props.auth.user.userName\n\tworkstationNodeID \u003d self.view.params.workstationnodeID\n\tworkstationID \u003d self.view.params.workstationID\n\tnodeID \u003d self.view.params.nodeID\n\t\n\t\n\tnow \u003d system.date.now()\n\t\n\ttry:\n\t\n\t\tfrom java.lang import String\n\t\n\t\tquery \u003d \"\"\"\n\t\t\tSELECT TOP 1 RegisterCode\n\t\t\tFROM registerhistory\n\t\t\tWHERE WorkstationNodeID\u003d? AND PapoID\u003d?\n\t\t\tORDER BY RegisterCode DESC\n\t\t\"\"\"\n\t\n\t\n\t\tresult \u003d system.db.runPrepQuery(query, [workstationNodeID,papoID], \"papo_db\")\n\t\t\n\t\tregCode \u003d result.getValueAt(0,0)\n\texcept:\n\t\tregCode \u003d 1\n\t\t\n\ttry:\n\t\n\t\tquery \u003d \"\"\"\n\t\t\tSELECT TOP 1 Status\n\t\t\tFROM registerhistory\n\t\t\tWHERE WorkstationNodeID\u003d? AND PapoID\u003d?\n\t\t\tORDER BY Timestamp DESC\n\t\t\"\"\"\n\t\n\t\n\t\tresult \u003d system.db.runPrepQuery(query, [workstationNodeID,papoID], \"papo_db\")\n\t\t\n\t\tstatus \u003d \"Finalizado\"\n\t\t\n\texcept:\n\t\tstatus \u003d \"En proceso\"\n\n\tdef insert_answer(registerTypeID, answerJson, regCode):\n\t\tif not answerJson:\n\t\t\treturn\n\t\tquery \u003d \"\"\"\n\t\t\tINSERT INTO registerhistory (\n\t\t\t\t[Timestamp],\n\t\t\t\tDataAnswer,\n\t\t\t\tStatus,\n\t\t\t\tPapoID,\n\t\t\t\tRegisterTypeID,\n\t\t\t\t[User],\n\t\t\t\tWorkstationNodeID,\n\t\t\t\tNodeID,\n\t\t\t\tWorkstationID,\n\t\t\
                "binding": {
                  "config": {
                    "path": "view.custom.supervisorOption"
                  },
                  "transforms": [
                    {
                      "code": "# Transform the array to dropdown format\n\tif value is None or len(value) \u003d\u003d 0:\n\t\treturn [{\"label\": \"No hay supervisores disponibles\", \"value\": \"\"}]\n\t\n\treturn [{\"label\": user, \"value\": user} for user in value]",
                      "type": "script"
                    }

            },
            "scripts": {
              "customMethods": [],
              "extensionFunctions": null,
              "messageHandlers": [
                {
                  "messageType": "saveStartRegister",
                  "pageScope": true,
                  "script": "\tsystem.perspective.sendMessage(\"resetTable\", payload\u003d{})\n\t\n\tlogger \u003d system.util.getLogger(\u0027saveStartRegister\u0027)\n\t\n\tfrom java.lang import String\n\t\n\ttry:\n\t    # ---- Context ----\n\t    registerTypeID    \u003d self.view.custom.registerTypeID\n\t    papoID            \u003d self.view.params.papoID\n\t    user              \u003d self.session.props.auth.user.userName\n\t    workstationNodeID \u003d self.view.params.workstationnodeID\n\t    workstationID     \u003d self.view.params.workstationID\n\t    nodeID            \u003d self.view.params.nodeID\n\t    status            \u003d \"En proceso\"\n\t    now               \u003d system.date.now()\n\t\n\t    logger.info(\"\u003d\u003d\u003d INICIO SAVE \u003d\u003d\u003d\")\n\t    logger.info(\"registerTypeID: \" + str(registerTypeID))\n\t    logger.info(\"papoID: \"         + str(papoID))\n\t    logger.info(\"user: \"           + str(user))\n\t    logger.info(\"workstationNodeID: \" + str(workstationNodeID))\n\t    logger.info(\"workstationID: \"  + str(workstationID))\n\t    logger.info(\"nodeID: \"         + str(nodeID))\n\t    logger.info(\"now: \"            + str(now))\n\t\n\t    # ---- Refresh bindings ----\n\t    logger.info(\"Refrescando FlexContainer...\")\n\t    self.parent.parent.getChild(\"FlexContainer\").refreshBinding(\"custom.answers\")\n\t    \n\t    logger.info(\"Refrescando view binding...\")\n\t    self.view.refreshBinding(\"custom.answers.formato\")\n\t\n\t    # ---- Leer respuesta ----\n\t    answerSeg \u003d self.view.custom.answers.formato\n\t    logger.info(\"answerSeg: \" + str(answerSeg))\n\t\n\t    # ---- Encode JSON ----\n\t    encodedSeg \u003d system.util.jsonEncode(answerSeg)\n\t    logger.info(\"encodedSeg: \" + str(encodedSeg))\n\t\n\t    # ---- Get last RegisterCode ----\n\t    query \u003d \"\"\"\n\t        SELECT TOP 1 RegisterCode\n\t        FROM registerhistory\n\t        WHERE WorkstationNodeID \u003d ? AND PapoID \u003d ?\n\t        ORDER BY ID DESC\n\t    \"\"\"\n\t    result \u003d system.db.runPrepQuery(query, [workstationNodeID, papoID], \"papo_db\")\n\t    regCode \u003d int(result.getValueAt(0, 0)) if result.getRowCount() \u003e 0 else 0\n\t    logger.info(\"regCode: \" + str(regCode))\n\t\n\t    # ---- INSERT ----\n\t    insertSql \u003d \"\"\"\n\t        INSERT INTO registerhistory (\n\t            [Timestamp],\n\t            DataAnswer,\n\t            Status,\n\t            PapoID,\n\t            RegisterTypeID,\n\t            [User],\n\t            WorkstationNodeID,\n\t            NodeID,\n\t            WorkstationID,\n\t            RegisterCode\n\t        )\n\t        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)\n\t    \"\"\"\n\t    params \u003d [\n\t        now,\n\t        String(encodedSeg),\n\t        status,\n\t        papoID,\n\t        registerTypeID,\n\t        user,\n\t        workstationNodeID,\n\t        nodeID,\n\t        workstationID,\n\t        regCode\n\t    ]\n\t    \n\t    logger.info(\"Ejecutando INSERT con params: \" + str(params))\n\t    system.db.runPrepUpdate(insertSql, params, \"papo_db\")\n\t    logger.info(\"\u003d\u003d\u003d INSERT EXITOSO \u003d\u003d\u003d\")\n\t\n\texcept Exception as e:\n\t    logger.error(\"\u003d\u003d\u003d ERROR: \" + str(e) + \" \u003d\u003d\u003d\")\n\t\n\t# ---- UI refresh ----\n\tsystem.perspective.sendMessage(\"refreshTable\",        {\"estado\": True},  scope\u003d\"session\")\n\tsystem.perspective.sendMessage(\"closeEmbeded\",        {\"estado\": False}, scope\u003d\"session\")\n\tsystem.perspective.sendMessage(\"refreshPeriodic\",     {\"min\": 0},        scope\u003d\"session\")\n\tsystem.perspective.sendMessage(\"refreshPreviewTable\", payload\u003d[],        scope\u003d\"session\")",
                  "sessionScope": false,
                  "viewScope": false
                }
              ]
            },
            "type": "ia.input.button"
          },

{
  "custom": {
    "db": "papo_db",
    "fontSize": 17
  },
  "params": {
    "item": {
      "answer": "No Cumple",
      "papoItemID": 4551,
      "registerTypeID": 7
    },
    "offsetObs": 332,
    "papoItemID": 4551
  },
  "propConfig": {
    "custom.db": {
      "persistent": true
    },
    "custom.fontSize": {
      "persistent": true
    },
    "params.item": {
      "binding": {
        "config": {
          "path": "/root/Checkbox.custom.item"
        },
        "type": "property"
      },
      "paramDirection": "output",
      "persistent": true
    },
    "params.offsetObs": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.papoItemID": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 148,
      "width": 966
    }
  },
  "root": {
    "children": [
      {
        "custom": {
          "item": {}
        },
        "meta": {
          "name": "Checkbox"
        },
        "position": {
          "basis": "966px"
        },
        "propConfig": {
          "custom.item.answer": {
            "binding": {
              "config": {
                "path": "this.props.selected"
              },
              "transforms": [
                {
                  "fallback": "none",
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": true,
                      "output": "Cumple"
                    },
                    {
                      "input": false,
                      "output": "No Cumple"
                    }
                  ],
                  "outputType": "scalar",
                  "type": "map"
                }
              ],
              "type": "property"
            }
          },
          "custom.item.papoItemID": {
            "binding": {
              "config": {
                "path": "view.params.papoItemID"
              },
              "type": "property"
            }
          },
          "custom.item.registerTypeID": {
            "binding": {
              "config": {
                "path": "this.custom.item.papoItemID"
              },
              "transforms": [
                {
                  "code": "\t# Query parametrizada\n\tquery \u003d \"\"\"\n\t\tSELECT RegisterTypeID\n\t\tFROM papoitem\n\t\tWHERE ID \u003d ?\n\t\"\"\"\n\t\n\t# args recibe el ID que pasas en \"value\" o podrías sustituirlo por otra variable\n\targs \u003d [value]\n\t\n\t# Ejecutar consulta\n\tresults \u003d system.db.runPrepQuery(query, args, self.view.custom.db)\n\t\n\t# Si hay resultados, devolver la descripción\n\tif len(results) \u003e 0:\n\t\treturn results[0][\"RegisterTypeID\"]\n\telse:\n\t\treturn None",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.style.fontSize": {
            "binding": {
              "config": {
                "path": "view.custom.fontSize"
              },
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "this.custom.item.papoItemID"
              },
              "transforms": [
                {
                  "code": "\t# Query parametrizada\n\tquery \u003d \"\"\"\n\t\tSELECT Description\n\t\tFROM papoitem\n\t\tWHERE ID \u003d ?\n\t\"\"\"\n\t\n\t# args recibe el ID que pasas en \"value\" o podrías sustituirlo por otra variable\n\targs \u003d [value]\n\t\n\t# Ejecutar consulta\n\tresults \u003d system.db.runPrepQuery(query, args, self.view.custom.db)\n\t\n\t# Si hay resultados, devolver la descripción\n\tif len(results) \u003e 0:\n\t\treturn results[0][\"Description\"]\n\telse:\n\t\treturn None",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "type": "ia.input.checkbox"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "style": {
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}
  "propConfig": {
    "params.dbConection": {
      "binding": {
        "config": {
          "path": "session.custom.dbConnection"
        },
        "type": "property"
      },
      "paramDirection": "inout",
      "persistent": true
    },
    "params.duarationRate": {
      "binding": {
        "config": {
          "path": "view.params.typeId"
        },
        "enabled": false,
        "transforms": [
          {
            "code": "\t#value \u003d self.view.custom.value   # tu parámetro\n\tstartTime \u003d self.params.startTime\n\tendTime \u003d self.params.endTime\n\t\n\t\n\tif value \u003d\u003d 2:\n\t    # Caso 1: solo Running\n\t    query \u003d \"\"\"\n\t    SELECT sh.ReasonName, \n\t           SUM(DATEDIFF(minute, sh.StartDateTime, sh.EndDateTime)) AS TotalMinutes\n\t    FROM statehistory sh\n\t    WHERE sh.StartDateTime \u003e\u003d ?\n\t      AND sh.EndDateTime \u003c\u003d ?\n\t      AND sh.ReasonName \u003d \u0027Running\u0027\n\t    GROUP BY sh.ReasonName;\n\t    \"\"\"\n\t    params \u003d [startTime, endTime]\n\t\n\telif value \u003d\u003d 1:\n\t    # Caso 2: PlannedDowntime \u003d 0 y excluir Running\n\t    query \u003d \"\"\"\n\t    SELECT sh.ReasonName, \n\t           SUM(DATEDIFF(minute, sh.StartDateTime, sh.EndDateTime)) AS TotalMinutes\n\t    FROM statehistory sh\n\t    INNER JOIN statereason sr ON sh.ReasonName \u003d sr.ReasonName\n\t    WHERE sh.StartDateTime \u003e\u003d ?\n\t      AND sh.EndDateTime \u003c\u003d ?\n\t      AND sr.PlannedDowntime \u003d 0\n\t      AND sh.ReasonName \u003c\u003e \u0027Running\u0027\n\t    GROUP BY sh.ReasonName;\n\t    \"\"\"\n\t    params \u003d [startTime, endTime]\n\t\n\telif value \u003d\u003d 0:\n\t    # Caso 3: PlannedDowntime \u003d 1\n\t    query \u003d \"\"\"\n\t    SELECT sh.ReasonName, \n\t           SUM(DATEDIFF(minute, sh.StartDateTime, sh.EndDateTime)) AS TotalMinutes\n\t    FROM statehistory sh\n\t    INNER JOIN statereason sr ON sh.ReasonName \u003d sr.ReasonName\n\t    WHERE sh.StartDateTime \u003e\u003d ?\n\t      AND sh.EndDateTime \u003c\u003d ?\n\t      AND sr.PlannedDowntime \u003d 1\n\t    GROUP BY sh.ReasonName;\n\t    \"\"\"\n\t    params \u003d [startTime, endTime]\n\t\n\telse:\n\t    # Si llega otro valor, no traer nada\n\t    query \u003d \"SELECT \u0027No Data\u0027 AS ReasonName, 0 AS TotalMinutes\"\n\t    params \u003d []\n\t\n\t# Ejecutar query\n\tresults \u003d system.db.runPrepQuery(query, params)\n\t\n\treturn results",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "paramDirection": "input",
      "persistent": true
    },
    "params.endTime": {
      "binding": {
        "config": {
          "expression": "now(20000)"
        },
        "enabled": false,
        "type": "expr"
      },
      "paramDirection": "input",
      "persistent": true
    },
    "params.freqRate": {
      "binding": {
        "config": {
          "path": "view.params.typeId"
        },
        "enabled": false,
        "transforms": [
          {
            "code": "\tquery \u003d \"\"\"\n\tSELECT ReasonName, COUNT(*) AS count\n\tFROM statehistory\n\tWHERE StartDateTime \u003e\u003d ?\n\t  AND EndDateTime \u003c\u003d ?\n\t  AND (ReasonName \u003d \u0027Running\u0027)\n\tGROUP BY ReasonName;\n\t\"\"\"\n\t\n\t# Ejecutar query con parámetros\n\tresults \u003d system.db.runPrepQuery(query, [\n\t    self.params.startTime,\n\t    self.params.endTime\n\t])\n\t\n\t# results ya es un Dataset\n\treturn results",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "paramDirection": "input",
      "persistent": true
    },
    "params.startTime": {
      "binding": {
        "config": {
          "expression": "dateArithmetic(now(20000), -1, \"days\")"
        },
        "enabled": false,
        "type": "expr"
      },
      "paramDirection": "input",
      "persistent": true
    },
    "params.typeId": {
      "paramDirection": "input",
      "persistent": true
    }
  },

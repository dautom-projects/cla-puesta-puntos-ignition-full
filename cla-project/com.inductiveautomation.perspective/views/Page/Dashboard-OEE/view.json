        "transforms": [
          {
            "code": "\ttry:\n\t\t\"\"\"\n\t\tDevolver eventos de statehistory solapados con un rango y recortados al rango.\n\t\n\t\tColor:\n\t\t  - \u0027#6ABCE2\u0027 si ReasonCode \u003d 1001 (prioridad máxima).\n\t\t  - \u0027#FF8A8A\u0027 si RecordDowntime \u003d 1 en statereason.\n\t\t  - \u0027#FFFF8A\u0027 si PlannedDowntime \u003d 1 (y RecordDowntime !\u003d 1).\n\t\t  - \u0027#8AFF8A\u0027 si ambos \u003d 0.\n\t\n\t\tInputs:\n\t\t\tvalue[\"dbConnection\"] (str)\n\t\t\tvalue[\"startDateTime\"] (datetime)\n\t\t\tvalue[\"endDateTime\"] (datetime)\n\t\n\t\tReturns:\n\t\t\tDataset: [itemId, ID, startDate, endDate, label, color, opacity]\n\t\t\"\"\"\n\t\t# Initialization of variables\n\t\tdb \u003d value[\"dbConnection\"]\n\t\tstartDateTime \u003d value[\"startDateTime\"]\n\t\tendDateTime \u003d value[\"endDateTime\"]\n\t\n\t\tstateHistoryTable \u003d mes_core.model.statehistoryTable(db)\n\t\n\t\tcolumns \u003d [\n\t\t\t\"NodeID AS itemId\",\n\t\t\t\"ID\",\n\t\t\t# start recortado al inicio del rango\n\t\t\t\"CASE WHEN StartDateTime \u003c ? THEN ? ELSE StartDateTime END AS startDate\",\n\t\t\t# end recortado al fin del rango (considerando abiertos)\n\t\t\t(\n\t\t\t\t\"CASE WHEN COALESCE(EndDateTime, GETDATE()) \u003e ? THEN ? \"\n\t\t\t\t\"ELSE COALESCE(EndDateTime, GETDATE()) END AS endDate\"\n\t\t\t),\n\t\t\t\"ReasonName AS label\",\n\t\t\t# color: prioridad 1001 \u003e RecordDowntime \u003e PlannedDowntime \u003e verde\n\t\t\t(\n\t\t\t\t\"CASE \"\n\t\t\t\t\" WHEN ReasonCode \u003d 1001 THEN \u0027#6ABCE2\u0027 \"\n\t\t\t\t\" WHEN EXISTS (SELECT 1 FROM statereason sr \"\n\t\t\t\t\"               WHERE sr.ID \u003d statehistory.StateReasonID \"\n\t\t\t\t\"                 AND sr.RecordDowntime \u003d 1) THEN \u0027#FF8A8A\u0027 \"\n\t\t\t\t\" WHEN EXISTS (SELECT 1 FROM statereason sr \"\n\t\t\t\t\"               WHERE sr.ID \u003d statehistory.StateReasonID \"\n\t\t\t\t\"                 AND sr.PlannedDowntime \u003d 1) THEN \u0027#FFFF8A\u0027 \"\n\t\t\t\t\" ELSE \u0027#8AFF8A\u0027 \"\n\t\t\t\t\"END AS color\"\n\t\t\t),\n\t\t\t\"0.5 AS opacity\"\n\t\t]\n\t\n\t\t# Solape: [Start, End] con [startDateTime, endDateTime]\n\t\twhere_clause \u003d (\n\t\t\t\"StartDateTime \u003c ? \"\n\t\t\t\"AND COALESCE(EndDateTime, GETDATE()) \u003e ?\"\n\t\t)\n\t\n\t\t# Orden de parámetros:\n\t\t# 1-2: CASE startDate\n\t\t# 3-4: CASE endDate\n\t\t# 5-6: WHERE de solape\n\t\twhere_args \u003d [\n\t\t\tstartDateTime, startDateTime,\n\t\t\tendDateTime,   endDateTime,\n\t\t\tendDateTime,   startDateTime\n\t\t]\n\t\n\t\tds \u003d stateHistoryTable.selectCustom(columns\u003dcolumns, where_clause\u003dwhere_clause, where_args\u003dwhere_args)\n\t\treturn ds\n\t\n\texcept:\n\t\timport system\n\t\treturn system.dataset.toDataSet([\u0027itemId\u0027,\u0027ID\u0027,\u0027startDate\u0027,\u0027endDate\u0027,\u0027label\u0027,\u0027color\u0027,\u0027opacity\u0027], [])",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },

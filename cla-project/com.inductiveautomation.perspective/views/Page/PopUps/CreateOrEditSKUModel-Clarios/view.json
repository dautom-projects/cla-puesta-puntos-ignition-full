                "events": {
                  "dom": {
                    "onClick": {
                      "config": {
                        "script": "\tdb \u003d self.view.custom.dbConnection\n\ttable \u003d mes_core.model.productcodemoldeTable(db)\n\tif not self.view.custom.inMolde:\n\t\tself.view.custom.labelText \u003d \"Ingrese un Codigo de Molde\"\n\t\treturn 0\n\telif not self.view.custom.inSKU:\n\t\tself.view.custom.labelText \u003d \"Ingrese un Codigo de SKU\"\n\t\treturn 0\n\t\n\telif self.view.params.function \u003d\u003d \"Crear\": # First function crear\n\n\t\tmoldeid \u003d self.view.custom.inMolde\n\t\tskuid \u003d self.view.custom.inSKU\n\t\tdisable \u003d self.view.custom.inDisable\n\t\t\n\t\tcondition1, ids1 \u003d table.validateColumn({\u0027MoldID\u0027:moldeid})\n\t\tcondition2, ids2 \u003d table.validateColumn({\u0027ProductCodeID\u0027:skuid})\n\t\t\n\t\tif (condition1 and condition2) and (set(ids1) \u0026 set(ids2)):\n\t\t\tself.view.custom.labelText \u003d \"La relacion ya existe\"\n\t\t\treturn 0\n\t\telse:\n\t\t\ttable.insert(moldeid\u003dmoldeid,productcodeid\u003dskuid,disable\u003ddisable )\n\t\t\tsystem.perspective.closePopup(\"createedit\")\n\t\t\t\t\n\t\t\t# Pop up for succesful transaction\n\t\t\talerts.actionSuccess(title\u003d\u0027Relacion creada\u0027, \n\t\t\t\t\t\t\tmessage\u003d\u0027Relacion creada correctamente\u0027)\n\t\t\t\t\n\t\t\t# Refresh table after query\n\t\t\tsystem.perspective.sendMessage(\"refreshTableSKUMolde\", payload\u003d{})\n\n\telif self.view.params.function \u003d\u003d \"Editar\": #Second function editar\n\t\trelationID \u003d self.view.params.selection.selID\n\t\tmoldeID \u003d self.view.custom.inMolde\n\t\tproductcodeID \u003d self.view.custom.inSKU\n\t\tdisable \u003d self.view.custom.inDisable\n\t\t\n\t\tcondition1, ids1 \u003d table.validateColumn({\u0027MoldID\u0027:moldeID})\n\t\tcondition2, ids2 \u003d table.validateColumn({\u0027ProductCodeID\u0027:productcodeID})\n\t\t\n\t\tif (condition1 and condition2) and relationID not in (set(ids1) \u0026 set(ids2)):\n\t\t\tself.view.custom.labelText \u003d \"La relacion ya existe\"\n\t\t\treturn 0\n\t\telse:\n\t\t\ttable.updateID(relationID,{\u0027MoldID\u0027:moldeID,\u0027ProductCodeID\u0027:productcodeID,\u0027Disable\u0027:disable})\n\t\n\t\t\tsystem.perspective.closePopup(\"createedit\")\t\n\t\t\t# Pop up for succesful transaction\n\t\t\talerts.actionSuccess(title\u003d\u0027Relacion editada\u0027, \n\t\t\t\t\t\t\t\tmessage\u003d\u0027Relacion \"{}\" editada correctamente\u0027.format(relationID))\n\t\t\t\t\n\t\t\t# Refresh table after query\n\t\t\tsystem.perspective.sendMessage(\"refreshTableSKUMolde\", payload\u003d{})\n\t\t\t#system.perspective.sendMessage(\"refreshTableStg\", payload\u003d{})\n"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }

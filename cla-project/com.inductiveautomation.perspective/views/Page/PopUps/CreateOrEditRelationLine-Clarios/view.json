              {
                "events": {
                  "dom": {
                    "onClick": {
                      "config": {
                        "script": "\tdb \u003d self.view.custom.dbConnection\n\ttable \u003d mes_core.model.productcodelineTable(db)\n\tfunction \u003d self.view.params.function\n\tproductID \u003d self.view.custom.inputVal\n\tdisable \u003d self.view.custom.inEnable\n\tlineName \u003d self.view.params.lineName\n\tnodeID \u003d self.view.params.nodeID\n\tselID \u003d self.view.params.selection.selID\n\n\tif not productID:\n\t\tself.view.custom.labelText \u003d \u0027Selecione un producto a asignar\u0027\n\t\treturn 0\n\telif function \u003d\u003d \"Crear\": #First function Crear:\n\t\tcondition, ids \u003d table.validateColumn({\u0027ProductCodeID\u0027:productID})\n\t\t\n\t\tif condition:\n\t\t\tself.view.custom.labelText \u003d \u0027Ya existe una relacion con este producto\u0027\n\t\t#message \u003d \u0027Almacen Destino \"{}\" asignado a la linea \"{}\" correctamente\u0027.format(inputVal, lineName)\n\t\telse:\n\t\t\ttable.insert(productcodeid \u003d productID, lineid \u003d nodeID, disable \u003d disable)\n\t\t\tsystem.perspective.closePopup(\"createeditline\")\n\t\t\tmessage \u003d \u0027Relacion creada correctamente\u0027\n\t\t\t# Pop up for succesful transaction\n\t\t\talerts.actionSuccess(title\u003d\u0027Relacion creada\u0027, \n\t\t\t\t\t\t\t\tmessage\u003dmessage)\n\t\t\t\t\t\t\t\n\t\t\t# Refresh table after query\n\t\t\tsystem.perspective.sendMessage(\"refreshTableRelationLine\", payload\u003d{})\n\t\t\n\telif self.view.params.function \u003d\u003d \"Editar\": #Second function editar\n\t\tcondition, ids \u003d table.validateColumn({\u0027ProductCodeID\u0027:productID})\n\t\tif condition and selID not in ids:\n\t\t\tself.view.custom.labelText \u003d \u0027Ya existe una relacion con este producto\u0027\n\t\t\treturn 0\n\t\telse:\n\t\t\t\n\t\t\ttable.updateID(selID,{\u0027ProductCodeID\u0027:productID,\u0027NodeID\u0027:nodeID,\u0027Disable\u0027:disable})\n\t\t\t# Pop up for succesful transaction\n\t\t\tmessage \u003d \u0027Relacion editada correctamente\u0027\n\t\t\talerts.actionSuccess(title\u003d\u0027Relacion editada\u0027, \n\t\t\t\t\t\t\t\tmessage\u003dmessage)\n\t\t\tsystem.perspective.closePopup(\"createeditline\")\n\t\t\t\t\t\t\t\t\n\t\t\t# Refresh table after query\n\t\t\tsystem.perspective.sendMessage(\"refreshTableRelationLine\", payload\u003d{})"
                      },

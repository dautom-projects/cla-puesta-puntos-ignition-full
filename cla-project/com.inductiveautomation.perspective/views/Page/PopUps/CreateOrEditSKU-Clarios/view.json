                "events": {
                  "dom": {
                    "onClick": {
                      "config": {
                        "script": "\tdb \u003d self.view.custom.dbConnection\n\ttable \u003d mes_core.model.productcodeTable(db)\n\t\n\tif not self.view.custom.inProductCode:\n\t\tself.view.custom.textLabel \u003d \"Ingrese un Codigo de SKU\"\n\t\treturn 0\n\t\t\n\telif self.view.params.function \u003d\u003d \"Crear\": # First function crear\n\t\t# define inputs\n\t\tdescription \u003d self.view.custom.inDescrip\n\t\tdisable \u003d self.view.custom.inDisable\n\t\tproductcode \u003d self.view.custom.inProductCode\n\t\t\n\t\tcondition, ids \u003d table.validateColumn({\u0027ProductCode\u0027:productcode})\n\t\tif bool(condition):\n\t\t\tself.view.custom.textLabel \u003d \u0027Ya existe un codigo igual\u0027\n\t\t\treturn 0\n\t\telse:\t\n\t\t\ttable.insert(description\u003ddescription,productcode\u003dproductcode,disable\u003ddisable )\n\t\t\tsystem.perspective.closePopup(\"createedit\")\n\t\t\t\n\t\t\t# Pop up for succesful transaction\n\t\t\talerts.actionSuccess(title\u003d\u0027SKU creado\u0027, \n\t\t\t\t\t\t\tmessage\u003d\u0027SKU \"{}\" creado correctamente\u0027.format(productcode))\n\t\t\t\n\t\t\t# Refresh table after query\n\t\t\tsystem.perspective.sendMessage(\"refreshTableSKU\", payload\u003d{})\n\n\telif self.view.params.function \u003d\u003d \"Editar\": #Second function editar\n\t\tskuID \u003d self.view.params.selection.selID\n\t\t# define inputs\n\t\tproductcode \u003d self.view.custom.inProductCode\n\t\tdescription \u003d self.view.custom.inDescrip\n\t\tdisable \u003d self.view.custom.inDisable\n\t\t\n\t\tcondition, ids \u003d table.validateColumn({\u0027ProductCode\u0027:productcode})\n\t\t\n\t\tif bool(condition) and skuID not in ids :\n\t\t\tself.view.custom.textLabel \u003d \u0027Ya existe un codigo igual\u0027\n\t\t\treturn 0\n\t\telse:\n\t\t\ttable.updateID(skuID, {\u0027Description\u0027:description,\u0027ProductCode\u0027:productcode,\u0027Disable\u0027:disable})\n\t\t\tsystem.perspective.closePopup(\"createedit\")\n\t\t\tsystem.perspective.sendMessage(\u0027refreshTableRelationLine\u0027)\n\t\t\t# Pop up for succesful transaction\n\t\t\talerts.actionSuccess(title\u003d\u0027SKU editado\u0027, \n\t\t\t\t\t\t\t\tmessage\u003d\u0027SKU \"{}\" editado correctamente\u0027.format(productcode))\n\t\t\t\n\t\t\t# Refresh table after query\n\t\t\tsystem.perspective.sendMessage(\"refreshTableSKU\", payload\u003d{})\n\t\t\t#system.perspective.sendMessage(\"refreshTableStg\", payload\u003d{})\n"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }

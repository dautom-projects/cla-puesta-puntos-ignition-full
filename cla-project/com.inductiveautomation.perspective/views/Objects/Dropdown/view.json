{
  "custom": {
    "dbConnection": "papo_db",
    "question": ""
  },
  "params": {
    "answer": "",
    "answerFrom": "label",
    "emptyAnswer": null,
    "enabled": true,
    "fontSize": 17,
    "options": [],
    "papoItemID": null,
    "placeholder": "Seleccionar",
    "question": "",
    "questionBasis": "60%",
    "showClearIcon": false,
    "showQuestion": true,
    "value": null
  },
  "propConfig": {
    "custom.dbConnection": {
      "binding": {
        "config": {
          "path": "session.custom.dbConnection"
        },
        "type": "property"
      },
      "persistent": true
    },
    "custom.question": {
      "binding": {
        "config": {
          "struct": {
            "dbConnection": "{view.custom.dbConnection}",
            "papoItemID": "{view.params.papoItemID}",
            "question": "{view.params.question}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\treturn value[\"question\"] or papo_core.items.getQuestionText(value)",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.answer": {
      "binding": {
        "config": {
          "struct": {
            "answerFrom": "{view.params.answerFrom}",
            "emptyAnswer": "{view.params.emptyAnswer}",
            "options": "{view.params.options}",
            "value": "{view.params.value}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\t# Answer is the selected option label, or its value when answerFrom is \"value\"\n\tif value[\"answerFrom\"] \u003d\u003d \"value\":\n\t\tif value[\"emptyAnswer\"] is None:\n\t\t\treturn value[\"value\"]\n\t\treturn value[\"value\"] if value[\"value\"] else value[\"emptyAnswer\"]\n\tfor option in value[\"options\"] or []:\n\t\tif str(option[\"value\"]) \u003d\u003d str(value[\"value\"]):\n\t\t\treturn option[\"label\"]\n\treturn \"\"\n",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "paramDirection": "output",
      "persistent": true
    },
    "params.answerFrom": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.emptyAnswer": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.enabled": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.fontSize": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.options": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.papoItemID": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.placeholder": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.question": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.questionBasis": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.showClearIcon": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.showQuestion": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.value": {
      "paramDirection": "inout",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 50,
      "width": 400
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Question"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.basis": {
            "binding": {
              "config": {
                "path": "view.params.questionBasis"
              },
              "type": "property"
            }
          },
          "position.display": {
            "binding": {
              "config": {
                "path": "view.params.showQuestion"
              },
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "expression": "{view.custom.question}"
              },
              "type": "expr"
            }
          },
          "props.textStyle.fontSize": {
            "binding": {
              "config": {
                "path": "view.params.fontSize"
              },
              "type": "property"
            }
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Field"
        },
        "position": {
          "basis": "0px",
          "grow": 1
        },
        "propConfig": {
          "props.enabled": {
            "binding": {
              "config": {
                "path": "view.params.enabled"
              },
              "type": "property"
            }
          },
          "props.options": {
            "binding": {
              "config": {
                "path": "view.params.options"
              },
              "type": "property"
            }
          },
          "props.placeholder.text": {
            "binding": {
              "config": {
                "path": "view.params.placeholder"
              },
              "type": "property"
            }
          },
          "props.showClearIcon": {
            "binding": {
              "config": {
                "path": "view.params.showClearIcon"
              },
              "type": "property"
            }
          },
          "props.style.fontSize": {
            "binding": {
              "config": {
                "path": "view.params.fontSize"
              },
              "type": "property"
            }
          },
          "props.value": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "view.params.value"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "placeholder": {},
          "style": {
            "classes": "PAPO/Field/Dropdown"
          }
        },
        "type": "ia.input.dropdown"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "stretch",
      "style": {
        "overflow": "hidden",
        "position": "relative"
      }
    },
    "type": "ia.container.flex"
  }
}
{
  "custom": {
    "dbConnection": "papo_db"
  },
  "params": {
    "fieldBasis": "224px",
    "fontSize": 17,
    "item": {
      "answer": "",
      "papoItemID": null,
      "registerTypeID": null
    },
    "maxValue": null,
    "minValue": null,
    "papoItemID": null,
    "placeholder": "Escriba aqui",
    "question": "",
    "questionBasis": "450px",
    "registerTypeID": null,
    "showQuestion": true,
    "value": null
  },
  "propConfig": {
    "custom.dbConnection": {
      "binding": {
        "config": {
          "path": "session.custom.dbConnection"
        },
        "type": "property"
      },
      "persistent": true
    },
    "params.fieldBasis": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.fontSize": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.item": {
      "binding": {
        "config": {
          "path": "/root/Field.custom.item"
        },
        "type": "property"
      },
      "paramDirection": "output",
      "persistent": true
    },
    "params.maxValue": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.minValue": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.papoItemID": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.placeholder": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.question": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.questionBasis": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.registerTypeID": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.showQuestion": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.value": {
      "paramDirection": "inout",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 60,
      "width": 900
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Question"
        },
        "propConfig": {
          "position.basis": {
            "binding": {
              "config": {
                "path": "view.params.questionBasis"
              },
              "type": "property"
            }
          },
          "position.display": {
            "binding": {
              "config": {
                "path": "view.params.showQuestion"
              },
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "struct": {
                  "dbConnection": "{view.custom.dbConnection}",
                  "papoItemID": "{view.params.papoItemID}",
                  "question": "{view.params.question}",
                  "showQuestion": "{view.params.showQuestion}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\treturn papo_core.items.getQuestionText(value)",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          },
          "props.textStyle.fontSize": {
            "binding": {
              "config": {
                "path": "view.params.fontSize"
              },
              "type": "property"
            }
          }
        },
        "type": "ia.display.label"
      },
      {
        "custom": {
          "item": {}
        },
        "meta": {
          "name": "Field"
        },
        "propConfig": {
          "custom.item.answer": {
            "binding": {
              "config": {
                "path": "this.props.value"
              },
              "type": "property"
            }
          },
          "custom.item.papoItemID": {
            "binding": {
              "config": {
                "path": "view.params.papoItemID"
              },
              "type": "property"
            }
          },
          "custom.item.registerTypeID": {
            "binding": {
              "config": {
                "path": "view.params.registerTypeID"
              },
              "type": "property"
            }
          },
          "position.basis": {
            "binding": {
              "config": {
                "path": "view.params.fieldBasis"
              },
              "type": "property"
            }
          },
          "props.placeholder": {
            "binding": {
              "config": {
                "path": "view.params.placeholder"
              },
              "type": "property"
            }
          },
          "props.style.borderColor": {
            "binding": {
              "config": {
                "struct": {
                  "maxValue": "{view.params.maxValue}",
                  "minValue": "{view.params.minValue}",
                  "value": "{this.props.value}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\treturn papo_core.items.getRangeColor(value[\"value\"], value[\"minValue\"], value[\"maxValue\"], \"border\")",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          },
          "props.style.color": {
            "binding": {
              "config": {
                "struct": {
                  "maxValue": "{view.params.maxValue}",
                  "minValue": "{view.params.minValue}",
                  "value": "{this.props.value}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\treturn papo_core.items.getRangeColor(value[\"value\"], value[\"minValue\"], value[\"maxValue\"], \"text\")",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          },
          "props.style.fontSize": {
            "binding": {
              "config": {
                "path": "view.params.fontSize"
              },
              "type": "property"
            }
          },
          "props.value": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "view.params.value"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "align": "left",
          "format": "none",
          "spinner": {
            "enabled": false
          },
          "style": {
            "borderBottomLeftRadius": 10,
            "borderBottomRightRadius": 10,
            "borderTopLeftRadius": 10,
            "borderTopRightRadius": 10
          }
        },
        "type": "ia.input.numeric-entry-field"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "style": {
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}
{
  "custom": {
    "dbConnection": "papo_db"
  },
  "params": {
    "answer": null,
    "emptyAnswer": null,
    "fontSize": 17,
    "maxValue": null,
    "minValue": null,
    "papoItemID": null,
    "placeholder": "Escriba aqui",
    "question": "",
    "questionBasis": "60%",
    "showQuestion": true,
    "value": null
  },
  "propConfig": {
    "custom.dbConnection": {
      "binding": {
        "config": {
          "path": "session.custom.dbConnection"
        },
        "type": "property"
      },
      "persistent": true
    },
    "params.answer": {
      "binding": {
        "config": {
          "struct": {
            "emptyAnswer": "{view.params.emptyAnswer}",
            "value": "{view.params.value}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\t# Answer is the value, or emptyAnswer when the value is empty and emptyAnswer is set\n\tif value[\"emptyAnswer\"] is None:\n\t\treturn value[\"value\"]\n\treturn value[\"value\"] if value[\"value\"] else value[\"emptyAnswer\"]\n",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "paramDirection": "output",
      "persistent": true
    },
    "params.emptyAnswer": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.fontSize": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.maxValue": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.minValue": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.papoItemID": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.placeholder": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.question": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.questionBasis": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.showQuestion": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.value": {
      "paramDirection": "inout",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 50,
      "width": 400
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Question"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.basis": {
            "binding": {
              "config": {
                "path": "view.params.questionBasis"
              },
              "type": "property"
            }
          },
          "position.display": {
            "binding": {
              "config": {
                "path": "view.params.showQuestion"
              },
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "struct": {
                  "dbConnection": "{view.custom.dbConnection}",
                  "papoItemID": "{view.params.papoItemID}",
                  "question": "{view.params.question}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\treturn value[\"question\"] or papo_core.items.getQuestionText(value)",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          },
          "props.textStyle.fontSize": {
            "binding": {
              "config": {
                "path": "view.params.fontSize"
              },
              "type": "property"
            }
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Field"
        },
        "position": {
          "basis": "0px",
          "grow": 1
        },
        "propConfig": {
          "props.placeholder": {
            "binding": {
              "config": {
                "path": "view.params.placeholder"
              },
              "type": "property"
            }
          },
          "props.style.borderColor": {
            "binding": {
              "config": {
                "struct": {
                  "maxValue": "{view.params.maxValue}",
                  "minValue": "{view.params.minValue}",
                  "value": "{view.params.value}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\treturn papo_core.items.getRangeColor(value[\"value\"], value[\"minValue\"], value[\"maxValue\"], \"border\")",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          },
          "props.style.color": {
            "binding": {
              "config": {
                "struct": {
                  "maxValue": "{view.params.maxValue}",
                  "minValue": "{view.params.minValue}",
                  "value": "{view.params.value}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\treturn papo_core.items.getRangeColor(value[\"value\"], value[\"minValue\"], value[\"maxValue\"], \"text\")",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          },
          "props.style.fontSize": {
            "binding": {
              "config": {
                "path": "view.params.fontSize"
              },
              "type": "property"
            }
          },
          "props.value": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "view.params.value"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "align": "left",
          "format": "none",
          "spinner": {
            "enabled": false
          },
          "style": {
            "classes": "PAPO/Field/Input"
          }
        },
        "type": "ia.input.numeric-entry-field"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "stretch",
      "style": {
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}
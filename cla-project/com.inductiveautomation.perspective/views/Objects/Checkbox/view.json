{
  "custom": {
    "dbConnection": "papo_db"
  },
  "params": {
    "answer": "No Cumple",
    "falseValue": "No Cumple",
    "fontSize": 17,
    "papoItemID": null,
    "question": "",
    "trueValue": "Cumple",
    "value": false
  },
  "propConfig": {
    "custom.dbConnection": {
      "binding": {
        "config": {
          "path": "session.custom.dbConnection"
        },
        "type": "property"
      },
      "persistent": true
    },
    "params.answer": {
      "binding": {
        "config": {
          "expression": "if({view.params.value}, {view.params.trueValue}, {view.params.falseValue})"
        },
        "type": "expr"
      },
      "paramDirection": "output",
      "persistent": true
    },
    "params.falseValue": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.fontSize": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.papoItemID": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.question": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.trueValue": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.value": {
      "paramDirection": "inout",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 40,
      "width": 400
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Field"
        },
        "position": {
          "basis": "0px",
          "grow": 1
        },
        "propConfig": {
          "props.selected": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "view.params.value"
              },
              "type": "property"
            }
          },
          "props.style.fontSize": {
            "binding": {
              "config": {
                "path": "view.params.fontSize"
              },
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "struct": {
                  "dbConnection": "{view.custom.dbConnection}",
                  "papoItemID": "{view.params.papoItemID}",
                  "question": "{view.params.question}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\treturn value[\"question\"] or papo_core.items.getQuestionText(value)",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "style": {
            "classes": "PAPO/Field/Checkbox"
          }
        },
        "type": "ia.input.checkbox"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "stretch",
      "style": {
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}
{
  "custom": {
    "dbConnection": "papo_db"
  },
  "params": {
    "fieldBasis": "224px",
    "fontSize": 17,
    "item": {},
    "papoItemID": null,
    "questionBasis": "450px",
    "registerTypeID": null,
    "showQuestion": true,
    "tagPath": ""
  },
  "propConfig": {
    "custom.dbConnection": {
      "binding": {
        "config": {
          "path": "session.custom.dbConnection"
        },
        "type": "property"
      },
      "persistent": true
    },
    "params.fieldBasis": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.fontSize": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.item": {
      "binding": {
        "config": {
          "path": "/root/Field.custom.item"
        },
        "type": "property"
      },
      "paramDirection": "output",
      "persistent": true
    },
    "params.papoItemID": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.questionBasis": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.registerTypeID": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.showQuestion": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 60,
      "width": 900
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Question"
        },
        "position": {
          "basis": "450px"
        },
        "propConfig": {
          "position.basis": {
            "binding": {
              "config": {
                "path": "view.params.questionBasis"
              },
              "type": "property"
            }
          },
          "position.display": {
            "binding": {
              "config": {
                "path": "view.params.showQuestion"
              },
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "struct": {
                  "dbConnection": "{view.custom.dbConnection}",
                  "papoItemID": "{view.params.papoItemID}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\treturn papo_core.items.getQuestionText(value)",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          },
          "props.textStyle.fontSize": {
            "binding": {
              "config": {
                "path": "view.params.fontSize"
              },
              "type": "property"
            }
          }
        },
        "type": "ia.display.label"
      },
      {
        "custom": {
          "item": {}
        },
        "meta": {
          "name": "Field"
        },
        "position": {
          "basis": "224px"
        },
        "propConfig": {
          "custom.item.answer": {
            "binding": {
              "config": {
                "path": "this.props.text"
              },
              "type": "property"
            }
          },
          "custom.item.papoItemID": {
            "binding": {
              "config": {
                "path": "view.params.papoItemID"
              },
              "type": "property"
            }
          },
          "custom.item.registerTypeID": {
            "binding": {
              "config": {
                "path": "view.params.registerTypeID"
              },
              "type": "property"
            }
          },
          "position.basis": {
            "binding": {
              "config": {
                "path": "view.params.fieldBasis"
              },
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "1": "{view.params.tagPath}"
                },
                "tagPath": "{1}"
              },
              "type": "tag"
            }
          },
          "props.textStyle.fontSize": {
            "binding": {
              "config": {
                "path": "view.params.fontSize"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "text-data-2",
            "color": "#1199C7",
            "paddingLeft": 20
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "style": {
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}
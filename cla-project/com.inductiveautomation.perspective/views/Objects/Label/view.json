{
  "custom": {
    "dbConnection": "papo_db"
  },
  "params": {
    "answer": null,
    "fontSize": 17,
    "papoItemID": null,
    "question": "",
    "questionBasis": "60%",
    "showQuestion": true,
    "tagPath": ""
  },
  "propConfig": {
    "custom.dbConnection": {
      "binding": {
        "config": {
          "path": "session.custom.dbConnection"
        },
        "type": "property"
      },
      "persistent": true
    },
    "params.answer": {
      "binding": {
        "config": {
          "expression": "{/root/Field.props.text}"
        },
        "type": "expr"
      },
      "paramDirection": "output",
      "persistent": true
    },
    "params.fontSize": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.papoItemID": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.question": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.questionBasis": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.showQuestion": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 40,
      "width": 400
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Question"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.basis": {
            "binding": {
              "config": {
                "path": "view.params.questionBasis"
              },
              "type": "property"
            }
          },
          "position.display": {
            "binding": {
              "config": {
                "path": "view.params.showQuestion"
              },
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "struct": {
                  "dbConnection": "{view.custom.dbConnection}",
                  "papoItemID": "{view.params.papoItemID}",
                  "question": "{view.params.question}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\treturn value[\"question\"] or papo_core.items.getQuestionText(value)",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          },
          "props.textStyle.fontSize": {
            "binding": {
              "config": {
                "path": "view.params.fontSize"
              },
              "type": "property"
            }
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Field"
        },
        "position": {
          "basis": "0px",
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "1": "{view.params.tagPath}"
                },
                "tagPath": "{1}"
              },
              "type": "tag"
            }
          },
          "props.textStyle.fontSize": {
            "binding": {
              "config": {
                "path": "view.params.fontSize"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "PAPO/Field/TagValue"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "stretch",
      "style": {
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}
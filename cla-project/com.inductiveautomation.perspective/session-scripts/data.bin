{"onPageStartup":"\t '''\n\ttry:\n\t    if page.path == \"/nodeID/:nodeID/papoID/:papoID/digitalization\":\n\t        #node = page.params.get(\"nodeID\", \"\")\n\t        #papo = page.params.get(\"papoID\", \"\")\n\t        title = \"EA111\"\n\t        system.perspective.setPageProperty(page.id, \"title\", title)\n\t\n\texcept:\n\t\treturn\n\t\t'''","onAuthChallengeCompleted":"\t\"\"\"\n\tHandle supervisor authentication challenge completion for PAPO signature.\n\t\"\"\"\n\t\n\tlogger = system.util.getLogger(\"dautom/papo/sessionEvents/onAuthChallengeCompleted\")\n\t\n\ttry:\n\t\tlogger.info(\"=== onAuthChallengeCompleted STARTED ===\")\n\t\t\n\t\t# ==================== CHECK AUTHENTICATION SUCCESS ====================\n\t\tif not result.isSuccess():\n\t\t\tlogger.info(\"Authentication failed - isSuccess() returned False\")\n\t\t\tif result.isError():\n\t\t\t\terror = result.getAsError()\n\t\t\t\tif error.isTimeout():\n\t\t\t\t\tlogger.warn(\"Authentication challenge timed out\")\n\t\t\t\t\tsystem.perspective.sendMessage(\n\t\t\t\t\t\tmessageType=\"signatureTimeout\",\n\t\t\t\t\t\tpayload={\n\t\t\t\t\t\t\t\"success\": False,\n\t\t\t\t\t\t\t\"message\": \"Tiempo de espera agotado\",\n\t\t\t\t\t\t\t\"type\": \"warning\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\tscope=\"session\"\n\t\t\t\t\t)\n\t\t\t\telif error.isCancelled():\n\t\t\t\t\tlogger.warn(\"Authentication challenge cancelled by user\")\n\t\t\t\t\tsystem.perspective.sendMessage(\n\t\t\t\t\t\tmessageType=\"signatureCancelled\",\n\t\t\t\t\t\tpayload={\n\t\t\t\t\t\t\t\"success\": False,\n\t\t\t\t\t\t\t\"message\": \"Autenticacion cancelada\",\n\t\t\t\t\t\t\t\"type\": \"info\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\tscope=\"session\"\n\t\t\t\t\t)\n\t\t\t\telse:\n\t\t\t\t\tlogger.warn(\"Authentication challenge failed\")\n\t\t\t\t\tsystem.perspective.sendMessage(\n\t\t\t\t\t\tmessageType=\"signatureError\",\n\t\t\t\t\t\tpayload={\n\t\t\t\t\t\t\t\"success\": False,\n\t\t\t\t\t\t\t\"message\": \"Error de autenticacion\",\n\t\t\t\t\t\t\t\"type\": \"error\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\tscope=\"session\"\n\t\t\t\t\t)\n\t\t\treturn\n\t\t\n\t\tlogger.info(\"Authentication successful - processing payload\")\n\t\t\n\t\t# ==================== VALIDATE PAYLOAD ====================\n\t\tif not payload:\n\t\t\tlogger.warn(\"No payload received in authentication challenge\")\n\t\t\treturn\n\t\t\n\t\taction = payload.get(\"action\", \"\")\n\t\tlogger.info(\"Action from payload: \" + str(action))\n\t\t\n\t\tif action != \"signPapoSup\":\n\t\t\tlogger.debug(\"Action not signPapoSup, ignoring: \" + str(action))\n\t\t\treturn\n\t\t\n\t\t# ==================== GET USER INFO FROM RESULT ====================\n\t\tcontext = result.getContext()\n\t\tuser = context.user\n\t\tuserName = user.userName\n\t\tfirstName = user.firstName or \"\"\n\t\tlastName = user.lastName or \"\"\n\t\troles = list(user.roles)\n\t\t\n\t\tlogger.info(\"User authenticated: \" + str(userName) + \" | Roles: \" + str(roles))\n\t\t\n\t\t# ==================== VALIDATE SUPERVISOR ROLE ====================\n\t\tallowedRoles = {\"INTEGRADOR\", \"Administrator\", \"Supervisor_PAPO\"}\n\t\tuserRoles = set(roles) if roles else set()\n\t\t\n\t\tuserRolesUpper = set([r.upper() for r in userRoles])\n\t\tallowedRolesUpper = set([r.upper() for r in allowedRoles])\n\t\t\n\t\tif not (userRolesUpper & allowedRolesUpper):\n\t\t\tlogger.warn(\"User \" + str(userName) + \" does not have required role for signing\")\n\t\t\t\n\t\t\t# ==================== ENVIAR MENSAJE DE ROL INSUFICIENTE ====================\n\t\t\tsystem.perspective.sendMessage(\n\t\t\t\tmessageType=\"signatureRoleDenied\",\n\t\t\t\tpayload={\n\t\t\t\t\t\"success\": False,\n\t\t\t\t\t\"message\": \"El usuario \" + str(userName) + \" no cuenta con los permisos para firmar\",\n\t\t\t\t\t\"userName\": userName,\n\t\t\t\t\t\"userRoles\": roles,\n\t\t\t\t\t\"type\": \"error\",\n\t\t\t\t\t\"title\": \"Acceso Denegado\",\n\t\t\t\t\t\"details\": \"Se requiere uno de los siguientes roles: INTEGRADOR, Administrator o Supervisor_PAPO\"\n\t\t\t\t},\n\t\t\t\tscope=\"session\"\n\t\t\t)\n\t\t\t\n\t\t\tlogger.info(\"Message sent - role denied\")\n\t\t\treturn\n\t\t\n\t\tlogger.info(\"Role validation passed\")\n\t\t\n\t\t# ==================== BUILD DATA ANSWER JSON ====================\n\t\tdataAnswer = {\n\t\t\t\"user\": userName,\n\t\t\t\"role\": roles,\n\t\t\t\"name\": firstName,\n\t\t\t\"lastname\": lastName\n\t\t}\n\t\tdataAnswerStr = system.util.jsonEncode(dataAnswer)\n\t\t\n\t\t# ==================== GET FORM DATA FROM PAYLOAD ====================\n\t\tpapoId = payload.get(\"papoId\")\n\t\tnodeId = payload.get(\"nodeId\")\n\t\tregisterCode = payload.get(\"registerCode\")\n\t\tworkstationNodeId = payload.get(\"workstationNodeId\")\n\t\tworkstationId = payload.get(\"workstationId\")\n\t\tdbConnection = payload.get(\"dbConnection\")\n\t\t\n\t\tlogger.info(\"Payload data - papoId: \" + str(papoId) + \" | nodeId: \" + str(nodeId) + \" | dbConnection: \" + str(dbConnection))\n\t\t\n\t\t# ==================== EXECUTE INSERT ====================\n\t\tsql = \"\"\"\n\t\t\tINSERT INTO registerhistory \n\t\t\t(Timestamp, DataAnswer, Status, PapoID, RegisterTypeID, [User], WorkstationNodeID, NodeID, WorkstationID, RegisterCode)\n\t\t\tVALUES (CURRENT_TIMESTAMP, ?, ?, ?, ?, ?, ?, ?, ?, ?)\n\t\t\"\"\"\n\t\t\n\t\targs = [\n\t\t\tdataAnswerStr,\n\t\t\t\"Revisado\",\n\t\t\tpapoId,\n\t\t\t10,\n\t\t\tuserName,\n\t\t\tworkstationNodeId,\n\t\t\tnodeId,\n\t\t\tworkstationId,\n\t\t\tregisterCode\n\t\t]\n\t\t\n\t\tsystem.db.runPrepUpdate(sql, args, dbConnection)\n\t\t\n\t\tlogger.info(\"PAPO form signed by supervisor: \" + str(userName) + \" - PapoID: \" + str(papoId))\n\t\t\n\t\t# ==================== ENVIAR MENSAJE DE FIRMA EXITOSA ====================\n\t\tsystem.perspective.sendMessage(\n\t\t\tmessageType=\"signatureSuccess\",\n\t\t\tpayload={\n\t\t\t\t\"success\": True,\n\t\t\t\t\"message\": \"Formulario firmado correctamente por \" + str(userName),\n\t\t\t\t\"userName\": userName,\n\t\t\t\t\"userFullName\": firstName + \" \" + lastName,\n\t\t\t\t\"papoId\": papoId,\n\t\t\t\t\"nodeId\": nodeId,\n\t\t\t\t\"registerCode\": registerCode,\n\t\t\t\t\"timestamp\": system.date.format(system.date.now(), \"yyyy-MM-dd HH:mm:ss\"),\n\t\t\t\t\"type\": \"success\",\n\t\t\t\t\"title\": \"Firma Exitosa\",\n\t\t\t\t\"details\": \"El formulario PAPO #\" + str(papoId) + \" ha sido firmado y registrado correctamente\"\n\t\t\t}\n\t\t)\n\n\t\tlogger.info(\"Message sent - signature success\")\n\t\tlogger.info(\"=== onAuthChallengeCompleted FINISHED ===\")\n\t\n\texcept Exception as e:\n\t\tlogger.error(\"Error in onAuthChallengeCompleted: \" + str(e))\n\t\t\n\t\t# ==================== ENVIAR MENSAJE DE ERROR DE EXCEPCION ====================\n\t\tsystem.perspective.sendMessage(\n\t\t\tmessageType=\"signatureException\",\n\t\t\tpayload={\n\t\t\t\t\"success\": False,\n\t\t\t\t\"message\": \"Error al procesar la firma: \" + str(e),\n\t\t\t\t\"type\": \"error\",\n\t\t\t\t\"title\": \"Error del Sistema\",\n\t\t\t\t\"details\": \"Ocurrio un error inesperado. Contacte al administrador.\"\n\t\t\t},\n\t\t\tscope=\"session\"\n\t\t)","onBarcodeDataReceived":"\t","onBluetoothReceived":"\t","onAccelerometerDataReceived":"\t","onNdefDataReceived":"\t"}